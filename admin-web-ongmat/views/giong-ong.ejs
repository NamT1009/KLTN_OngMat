<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Lý Giống Ong | Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { width: 260px; height: 100vh; background-color: #343a40; color: #fff; position: fixed; top: 0; left: 0; z-index: 1000; overflow-y: auto; }
        .sidebar-brand { padding: 20px; font-size: 1.2rem; font-weight: bold; background: #212529; text-align: center; color: #ffc107; border-bottom: 1px solid #4b545c; }
        .sidebar-menu { list-style: none; padding: 0; margin: 0; }
        .sidebar-menu li a { display: block; padding: 15px 20px; color: #c2c7d0; text-decoration: none; border-left: 3px solid transparent; transition: 0.3s; }
        .sidebar-menu li a:hover, .sidebar-menu li a.active { background-color: #495057; color: #fff; border-left-color: #ffc107; }
        .sidebar-menu li a i { width: 25px; text-align: center; margin-right: 10px; }
        .main-content { margin-left: 260px; min-height: 100vh; padding: 30px; }
        .table th { font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; }
        .action-btns { display: flex; justify-content: center; gap: 6px; }
        .btn-action { padding: 5px 10px; font-size: 0.85rem; border-radius: 6px; transition: all 0.2s; }
        .btn-action:hover { transform: translateY(-1px); box-shadow: 0 3px 6px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <%- include('partials/sidebar') %>

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="text-secondary fw-bold">Quản Lý Danh Mục Giống Ong</h3>
                <p class="text-muted mb-0">Quản lý thông tin chi tiết các giống ong và đặc điểm sinh trưởng.</p>
            </div>
            <button class="btn btn-warning fw-bold text-dark px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemGiongOng">
                <i class="fas fa-plus-circle me-1"></i> Thêm Giống Ong
            </button>
        </div>

        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th class="ps-4 py-3" style="width: 80px;">ID</th>
                            <th class="py-3" style="width: 200px;">Tên Giống Ong</th>
                            <th class="py-3">Nguồn Gốc & Tập Tính</th>
                            <th class="py-3" style="width: 160px;">Năng Suất TB</th>
                            <th class="py-3" style="width: 180px;">Sản Phẩm Chủ Lực</th>
                            <th class="text-center py-3" style="width: 150px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(danhSachGiongOng.length > 0) { %>
                            <% danhSachGiongOng.forEach(function(item) { %>
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#<%= item.maLoaiOng %></td>
                                <td class="fw-bold text-success"><%= item.tenLoaiOng %></td>
                                <td class="text-secondary text-truncate" style="max-width: 250px;"><%= item.nguonGocVaTapTinh %></td>
                                <td><span class="badge bg-light text-dark border px-2 py-1"><%= item.nangSuatTrungBinh %></span></td>
                                <td class="fw-semibold text-dark"><%= item.sanPhamChuLuc %></td>
                                <td>
                                    <div class="action-btns">
                                        <button class="btn btn-outline-primary btn-action" title="Chỉnh sửa"
                                            onclick="chuanBiSua('<%= item.maLoaiOng %>', '<%= item.tenLoaiOng %>', '<%= item.nguonGocVaTapTinh %>', '<%= item.dacDiemSinhHoc %>', '<%= item.nangSuatTrungBinh %>', '<%= item.sanPhamChuLuc %>', '<%= item.khiHauThichHop %>')">
                                            <i class="fas fa-edit"></i> Sửa
                                        </button>
                                        <button class="btn btn-outline-danger btn-action" title="Xóa" onclick="xoaGiongOng('<%= item.maLoaiOng %>')">
                                            <i class="fas fa-trash-alt"></i> Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-box-open fa-2x mb-2 text-black-50"></i>
                                    <p class="mb-0">Chưa có dữ liệu giống ong nào trong hệ thống.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MODAL THÊM GIỐNG ONG -->
    <div class="modal fade" id="modalThemGiongOng" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-1"></i> Thêm Giống Ong Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tên Giống Ong:</label>
                            <input type="text" id="tenLoaiOng" class="form-control" placeholder="Ví dụ: Ong Ý (Apis mellifera)" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Năng Suất Trung Bình:</label>
                            <input type="text" id="nangSuatTrungBinh" class="form-control" placeholder="Ví dụ: 30 - 50 kg/đàn/năm">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Sản Phẩm Chủ Lực:</label>
                            <input type="text" id="sanPhamChuLuc" class="form-control" placeholder="Ví dụ: Mật ong, Sữa ong chúa">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Khí Hậu Phù Hợp:</label>
                            <input type="text" id="khiHauThichHop" class="form-control" placeholder="Ví dụ: Ôn đới, cận nhiệt đới">
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Nguồn Gốc & Tập Tính:</label>
                            <textarea id="nguonGocVaTapTinh" class="form-control" rows="2" placeholder="Nhập nguồn gốc và tập tính sinh sống..."></textarea>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Đặc Điểm Sinh Học:</label>
                            <textarea id="dacDiemSinhHoc" class="form-control" rows="2" placeholder="Nhập đặc điểm sinh học, kích thước, sức đề kháng..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="luuGiongOng()" class="btn btn-warning fw-bold px-4">Lưu Lại</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL SỬA GIỐNG ONG -->
    <div class="modal fade" id="modalSuaGiongOng" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit me-1"></i> Chỉnh Sửa Thông Tin Giống Ong</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="editMaLoaiOng">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tên Giống Ong:</label>
                            <input type="text" id="editTenLoaiOng" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Năng Suất Trung Bình:</label>
                            <input type="text" id="editNangSuatTrungBinh" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Sản Phẩm Chủ Lực:</label>
                            <input type="text" id="editSanPhamChuLuc" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Khí Hậu Phù Hợp:</label>
                            <input type="text" id="editKhiHauThichHop" class="form-control">
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Nguồn Gốc & Tập Tính:</label>
                            <textarea id="editNguonGocVaTapTinh" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Đặc Điểm Sinh Học:</label>
                            <textarea id="editDacDiemSinhHoc" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="thucHienSuaGiongOng()" class="btn btn-primary fw-bold px-4">Cập Nhật</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function luuGiongOng() {
            const tenLoaiOng = document.getElementById('tenLoaiOng').value;
            const nguonGocVaTapTinh = document.getElementById('nguonGocVaTapTinh').value;
            const dacDiemSinhHoc = document.getElementById('dacDiemSinhHoc').value;
            const nangSuatTrungBinh = document.getElementById('nangSuatTrungBinh').value;
            const sanPhamChuLuc = document.getElementById('sanPhamChuLuc').value;
            const khiHauThichHop = document.getElementById('khiHauThichHop').value;

            if(!tenLoaiOng) { alert("Vui lòng nhập tên giống ong!"); return; }

            try {
                const response = await fetch('/api/giong-ong/them', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tenLoaiOng, nguonGocVaTapTinh, dacDiemSinhHoc, nangSuatTrungBinh, sanPhamChuLuc, khiHauThichHop })
                });
                const data = await response.json();
                if (data.success) { alert(data.message); window.location.reload(); }
                else { alert(data.message); }
            } catch (error) { alert("Lỗi kết nối Server!"); }
        }

        function chuanBiSua(id, ten, nguonGoc, dacDiem, nangSuat, sanPham, khiHau) {
            document.getElementById('editMaLoaiOng').value = id;
            document.getElementById('editTenLoaiOng').value = ten !== 'null' ? ten : '';
            document.getElementById('editNguonGocVaTapTinh').value = nguonGoc !== 'null' ? nguonGoc : '';
            document.getElementById('editDacDiemSinhHoc').value = dacDiem !== 'null' ? dacDiem : '';
            document.getElementById('editNangSuatTrungBinh').value = nangSuat !== 'null' ? nangSuat : '';
            document.getElementById('editSanPhamChuLuc').value = sanPham !== 'null' ? sanPham : '';
            document.getElementById('editKhiHauThichHop').value = khiHau !== 'null' ? khiHau : '';

            const modal = new bootstrap.Modal(document.getElementById('modalSuaGiongOng'));
            modal.show();
        }

        async function thucHienSuaGiongOng() {
            const maLoaiOng = document.getElementById('editMaLoaiOng').value;
            const tenLoaiOng = document.getElementById('editTenLoaiOng').value;
            const nguonGocVaTapTinh = document.getElementById('editNguonGocVaTapTinh').value;
            const dacDiemSinhHoc = document.getElementById('editDacDiemSinhHoc').value;
            const nangSuatTrungBinh = document.getElementById('editNangSuatTrungBinh').value;
            const sanPhamChuLuc = document.getElementById('editSanPhamChuLuc').value;
            const khiHauThichHop = document.getElementById('editKhiHauThichHop').value;

            try {
                const response = await fetch('/api/giong-ong/sua', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ maLoaiOng, tenLoaiOng, nguonGocVaTapTinh, dacDiemSinhHoc, nangSuatTrungBinh, sanPhamChuLuc, khiHauThichHop })
                });
                const data = await response.json();
                if (data.success) { alert(data.message); window.location.reload(); }
                else { alert(data.message); }
            } catch (error) { alert("Lỗi kết nối Server!"); }
        }

        async function xoaGiongOng(id) {
            if(!confirm("Bạn có chắc chắn muốn xóa giống ong này không?")) return;

            try {
                const response = await fetch('/api/giong-ong/xoa', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id })
                });
                const data = await response.json();
                if (data.success) { alert(data.message); window.location.reload(); }
                else { alert(data.message); }
            } catch (error) { alert("Lỗi kết nối Server!"); }
        }
    </script>
</body>
</html>
<!doctype html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nghiệp vụ người nuôi ong</title>
  
  <!-- Bootstrap 5 & FontAwesome -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Thư viện bản đồ Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    body {
      background-color: #f4f6f9;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* CSS chuẩn cho Sidebar */
    .sidebar {
      width: 260px;
      height: 100vh;
      background-color: #343a40;
      color: #fff;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      overflow-y: auto;
    }

    .sidebar-brand {
      padding: 20px;
      font-size: 1.2rem;
      font-weight: bold;
      background: #212529;
      text-align: center;
      color: #ffc107;
      border-bottom: 1px solid #4b545c;
    }

    .sidebar-menu {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .sidebar-menu li a {
      display: block;
      padding: 15px 20px;
      color: #c2c7d0;
      text-decoration: none;
      border-left: 3px solid transparent;
      transition: 0.3s;
    }

    .sidebar-menu li a:hover,
    .sidebar-menu li a.active {
      background-color: #495057;
      color: #fff;
      border-left-color: #ffc107;
    }

    .sidebar-menu li a i {
      width: 25px;
      text-align: center;
      margin-right: 10px;
    }

    .main-content {
      margin-left: 260px;
      min-height: 100vh;
      padding: 30px;
    }

    .card {
      border: 0;
      border-radius: 14px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .metric {
      font-size: 1.7rem;
      font-weight: 800;
    }

    .table td,
    .table th {
      vertical-align: middle;
    }

    .status {
      border-radius: 99px;
      padding: .35rem .75rem;
      font-size: .8rem;
      background: #fff3cd;
      white-space: nowrap;
      font-weight: 600;
    }

    /* Chiều cao bắt buộc cho khung bản đồ */
    #hiveMap {
      height: 480px;
      width: 100%;
      border-radius: 10px;
      z-index: 1;
    }
  </style>
</head>

<body>
  <%- include('partials/sidebar') %>

  <% 
    const statusLabels = { 
      ChoDuyet: 'Chờ chủ đất duyệt', 
      ChoKhachKy: 'Chờ người nuôi ong ký', 
      DaKy: 'Đã ký', 
      HoanThanh: 'Đã hoàn thành',
      TuChoi: 'Từ chối', 
      DaHuy: 'Đã hủy' 
    }; 
    const label = (s) => statusLabels[s] || s;
    const money = (v) => v == null ? '—' : Number(v).toLocaleString('vi-VN') + ' đ';
    const totalKg = production.filter(x => String(x.donVi).toLowerCase() === 'kg').reduce((s, x) => s + Number(x.sanLuong || 0), 0);
    const repBadge = (isNew, rating, count) => {
      const c = Number(count || 0);
      const r = Number(rating || 0);
      if (isNew == 1 || isNew === true || c === 0 || !r) {
        return '<span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle ms-1" title="Tài khoản mới chưa có đánh giá"><i class="fa-solid fa-seedling"></i> Người mới</span>';
      }
      return `<span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" title="Uy tín: ${r.toFixed(1)}/5 sao"><i class="fa-solid fa-star text-warning"></i> ${r.toFixed(1)}/5 (${c} ĐG)</span>`;
    };
  %>

  <main class="main-content">
    <%- include('partials/topbar') %>
    
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1">Nghiệp vụ người nuôi ong & chủ đất</h2>
        <p class="text-muted mb-0">Theo dõi yêu cầu thuê, hợp đồng, đàn ong, chăm sóc, di chuyển và sản lượng từ SQL Server.</p>
      </div>
      <span class="badge text-bg-warning p-2"><i class="fa-solid fa-database me-1"></i> Đồng bộ SQL Server</span>
    </div>

    <!-- Hàng thống kê tổng quan -->
    <div class="row g-3 mb-4">
      <% [
        ['Yêu cầu chờ duyệt', requests.filter(x => x.trangThai === 'ChoDuyet').length, 'fa-file-signature'],
        ['Hợp đồng hiệu lực', contracts.filter(x => x.trangThai === 'DaKy').length, 'fa-file-contract'],
        ['Đàn ong / thùng', hives.length + ' / ' + hives.reduce((s, x) => s + Number(x.soThung || 0), 0), 'fa-hive'],
        ['Sản lượng (kg)', totalKg.toLocaleString('vi-VN'), 'fa-chart-line']
      ].forEach(m => { %>
        <div class="col-md-3">
          <div class="card p-3">
            <div class="text-muted"><i class="fa-solid <%= m[2] %> text-warning me-2"></i><%= m[0] %></div>
            <div class="metric mt-2"><%= m[1] %></div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Hàng Danh sách Yêu cầu & Bản đồ đàn ong -->
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card p-3 h-100">
          <h5 class="fw-bold mb-3">Yêu cầu thuê đất</h5>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Địa điểm</th>
                  <th>Người nuôi ong</th>
                  <th>Chủ đất</th>
                  <th>Thời gian</th>
                  <th>Trạng thái</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% requests.forEach(item => { %>
                  <tr>
                    <td>
                      <strong><%= item.tenDiaDiem %></strong>
                      <div class="small text-muted"><%= item.soDanOng %> đàn · <%= money(item.giaThueDuKien) %></div>
                    </td>
                    <td><%= item.tenNguoiNuoiOng || '—' %><%- repBadge(item.laNguoiMoiNuoiOng, item.uyTinNguoiNuoiOng, item.tongDanhGiaNguoiNuoiOng) %></td>
                    <td><%= item.tenChuDat || '—' %><%- repBadge(item.laNguoiMoiChuDat, item.uyTinChuDat, item.tongDanhGiaChuDat) %></td>
                    <td class="small">
                      <%= item.thoiGianBatDau %>
                      <% if (item.thoiGianKetThuc) { %> → <%= item.thoiGianKetThuc %><% } %>
                    </td>
                    <td><span class="status"><%= label(item.trangThai) %></span></td>
                    <td>
                      <% if (item.trangThai === 'ChoDuyet' && typeof user !== 'undefined' && user && (user.vaiTro === 'chuDat' || user.vaiTro === 'admin')) { %>
                        <form method="post" action="/api/nguoi-nuoi-ong/yeu-cau/<%= item.maYeuCau %>/duyet">
                          <button class="btn btn-sm btn-warning fw-bold" title="Duyệt yêu cầu">
                            <i class="fa-solid fa-check"></i> Duyệt
                          </button>
                        </form>
                      <% } else if (item.trangThai === 'ChoDuyet') { %>
                        <span class="text-muted small" style="font-style: italic;">Chờ chủ đất duyệt</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
                <% if (!requests.length) { %>
                  <tr>
                    <td colspan="6" class="text-center text-muted py-4">Chưa có yêu cầu nào</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Cột Bản đồ đàn ong -->
      <div class="col-lg-5">
        <div class="card p-3 h-100 shadow-sm border-0">
          <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-map-location-dot text-warning me-2"></i>Bản đồ đàn ong</h5>
          <div id="hiveMap"></div>
        </div>
      </div>
    </div>

    <!-- Tabs Chi tiết nghiệp vụ -->
    <div class="card p-3 mt-4">
      <ul class="nav nav-tabs">
        <li class="nav-item"><button class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#hives">Đàn & thùng ong</button></li>
        <li class="nav-item"><button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#contracts">Hợp đồng</button></li>
        <li class="nav-item"><button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#reviews"><i class="fa-solid fa-star text-warning me-1"></i>Đánh giá thuê đất (<%= (typeof reviews !== 'undefined' ? reviews.length : 0) %>)</button></li>
        <li class="nav-item"><button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#care">Chăm sóc</button></li>
        <li class="nav-item"><button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#moves">Di chuyển</button></li>
        <li class="nav-item"><button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#production">Sản lượng</button></li>
      </ul>
      
      <div class="tab-content pt-3">
        <!-- Tab Đàn ong -->
        <div id="hives" class="tab-pane fade show active">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Mã đàn</th>
                  <th>Tên đàn</th>
                  <th>Người nuôi ong</th>
                  <th>Địa điểm</th>
                  <th>GPS</th>
                  <th>Số thùng</th>
                  <th>Tình trạng</th>
                </tr>
              </thead>
              <tbody>
                <% hives.forEach(x => { %>
                  <tr>
                    <td><strong><%= x.maDanOng %></strong></td>
                    <td class="text-success fw-bold"><%= x.tenDanOng %></td>
                    <td><%= x.tenNguoiNuoiOng || '—' %></td>
                    <td><%= x.tenDiaDiem || x.viTri || 'Chưa cập nhật' %></td>
                    <td class="small"><%= x.viDo != null ? Number(x.viDo).toFixed(5) + ', ' + Number(x.kinhDo).toFixed(5) : '—' %></td>
                    <td><span class="badge bg-secondary"><%= x.soThung %></span></td>
                    <td><%= x.tinhTrang %></td>
                  </tr>
                <% }) %>
                <% if (!hives.length) { %>
                  <tr><td colspan="7" class="text-center text-muted py-3">Chưa có đàn ong</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Hợp đồng -->
        <div id="contracts" class="tab-pane fade">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Mã</th>
                  <th>Địa điểm</th>
                  <th>Chủ đất</th>
                  <th>Người nuôi ong</th>
                  <th>Giá thuê</th>
                  <th>Thời hạn</th>
                  <th>Trạng thái</th>
                  <th>Đánh giá 2 bên</th>
                  <th>PDF</th>
                </tr>
              </thead>
              <tbody>
                <% contracts.forEach(x => { %>
                  <tr>
                    <td><strong><%= x.maHopDong %></strong></td>
                    <td><%= x.tenDiaDiem || '—' %></td>
                    <td><%= x.tenChuDat || '—' %><%- repBadge(x.laNguoiMoiChuDat, x.uyTinChuDat, x.tongDanhGiaChuDat) %></td>
                    <td><%= x.tenNguoiNuoiOng || '—' %><%- repBadge(x.laNguoiMoiNuoiOng, x.uyTinNguoiNuoiOng, x.tongDanhGiaNguoiNuoiOng) %></td>
                    <td><%= money(x.giaThue) %></td>
                    <td class="small"><%= x.thoiHan %></td>
                    <td><span class="status"><%= label(x.trangThai) %></span></td>
                    <td>
                      <% if (x.saoNguoiNuoiOngDanhGia || x.saoChuDatDanhGia) { %>
                        <div class="d-flex flex-column gap-1">
                          <% if (x.saoNguoiNuoiOngDanhGia) { %>
                            <span class="badge text-bg-warning text-dark text-start" title="Người nuôi ong đánh giá: <%= x.nhanXetNguoiNuoiOng || 'Không có nhận xét' %>">
                              🐝 Nuôi ong: <%= x.saoNguoiNuoiOngDanhGia %>/5 ⭐
                            </span>
                          <% } %>
                          <% if (x.saoChuDatDanhGia) { %>
                            <span class="badge text-bg-info text-white text-start" title="Chủ đất đánh giá: <%= x.nhanXetChuDat || 'Không có nhận xét' %>">
                              🏡 Chủ đất: <%= x.saoChuDatDanhGia %>/5 ⭐
                            </span>
                          <% } %>
                        </div>
                      <% } else { %>
                        <span class="text-muted small">Chưa có đánh giá</span>
                      <% } %>
                    </td>
                    <td>
                      <a class="btn btn-sm btn-outline-danger" target="_blank" href="/api/hop-dong/pdf/<%= x.maHopDong %>" title="Xem hợp đồng PDF">
                        <i class="fa-solid fa-file-pdf"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
                <% if (!contracts.length) { %>
                  <tr><td colspan="9" class="text-center text-muted py-3">Chưa có hợp đồng</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Đánh giá thuê đất -->
        <div id="reviews" class="tab-pane fade">
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Hợp đồng / Địa điểm</th>
                  <th>Người đánh giá</th>
                  <th>Đối tác được đánh giá</th>
                  <th>Số sao</th>
                  <th>Tiêu chí đánh giá</th>
                  <th>Nhận xét</th>
                  <th>Ngày gửi</th>
                </tr>
              </thead>
              <tbody>
                <% (typeof reviews !== 'undefined' ? reviews : []).forEach(r => { %>
                  <tr>
                    <td>
                      <strong class="text-primary"><%= r.maHopDong %></strong>
                      <div class="small text-muted"><i class="fa-solid fa-location-dot me-1"></i><%= r.tenDiaDiem || '—' %></div>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div class="avatar-badge bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">
                          <%= (r.tenNguoiDanhGia || '?').charAt(0).toUpperCase() %>
                        </div>
                        <div>
                          <div class="fw-bold"><%= r.tenNguoiDanhGia || '—' %></div>
                          <span class="badge <%= r.vaiTroDanhGia === 'nguoiNuoiOng' ? 'text-bg-warning' : 'text-bg-info text-white' %>" style="font-size: 10px;">
                            <%= r.vaiTroDanhGia === 'nguoiNuoiOng' ? 'Người nuôi ong' : 'Chủ đất' %>
                          </span>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="fw-semibold"><%= r.tenNguoiDuocDanhGia || '—' %></div>
                    </td>
                    <td>
                      <span class="badge text-bg-warning fs-6">
                        <%= r.soSao %>/5 <i class="fa-solid fa-star"></i>
                      </span>
                    </td>
                    <td class="small">
                      <% if (r.vaiTroDanhGia === 'nguoiNuoiOng') { %>
                        <div><i class="fa-solid fa-seedling text-success me-1"></i>Nguồn hoa: <b><%= r.tieuChi1 || 5 %>/5</b> ⭐</div>
                        <div><i class="fa-solid fa-handshake text-primary me-1"></i>Hỗ trợ: <b><%= r.tieuChi2 || 5 %>/5</b> ⭐</div>
                      <% } else { %>
                        <div><i class="fa-solid fa-broom text-success me-1"></i>Giữ gìn vườn: <b><%= r.tieuChi1 || 5 %>/5</b> ⭐</div>
                        <div><i class="fa-solid fa-file-invoice-dollar text-primary me-1"></i>Đúng cam kết: <b><%= r.tieuChi2 || 5 %>/5</b> ⭐</div>
                      <% } %>
                    </td>
                    <td>
                      <% if (r.nhanXet) { %>
                        <div class="fst-italic text-dark">“<%= r.nhanXet %>”</div>
                      <% } else { %>
                        <span class="text-muted small">Không có nhận xét thêm</span>
                      <% } %>
                    </td>
                    <td class="small text-muted"><%= r.ngayTao %></td>
                  </tr>
                <% }) %>
                <% if (!((typeof reviews !== 'undefined' ? reviews : []).length)) { %>
                  <tr><td colspan="7" class="text-center text-muted py-4">Chưa có đánh giá nào từ các đợt thuê. Đánh giá sẽ xuất hiện khi người nuôi ong hoặc chủ đất hoàn tất hợp đồng thuê và gửi đánh giá.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Chăm sóc -->
        <div id="care" class="tab-pane fade">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Ngày</th>
                  <th>Công việc</th>
                  <th>Đàn ong</th>
                  <th>Địa điểm</th>
                  <th>Trạng thái</th>
                </tr>
              </thead>
              <tbody>
                <% care.forEach(x => { %>
                  <tr>
                    <td><%= x.ngay %> <%= x.gio || '' %></td>
                    <td><strong><%= x.tenCongViec %></strong></td>
                    <td><%= x.tenDanOng || '—' %></td>
                    <td><%= x.diaDiem || '—' %></td>
                    <td><span class="status"><%= x.trangThai %></span></td>
                  </tr>
                <% }) %>
                <% if (!care.length) { %>
                  <tr><td colspan="5" class="text-center text-muted py-3">Chưa có lịch chăm sóc</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Di chuyển -->
        <div id="moves" class="tab-pane fade">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Ngày</th>
                  <th>Đàn ong</th>
                  <th>Lộ trình</th>
                  <th>Biển số</th>
                  <th>Trạng thái</th>
                </tr>
              </thead>
              <tbody>
                <% moves.forEach(x => { %>
                  <tr>
                    <td><%= x.ngay %></td>
                    <td><strong><%= x.tenDanOng || '—' %></strong></td>
                    <td><%= x.viTriDi %> <i class="fa-solid fa-arrow-right-long text-muted mx-1"></i> <%= x.viTriDen %></td>
                    <td><span class="badge bg-light text-dark border"><%= x.bienSo || '—' %></span></td>
                    <td><span class="status"><%= x.trangThai %></span></td>
                  </tr>
                <% }) %>
                <% if (!moves.length) { %>
                  <tr><td colspan="5" class="text-center text-muted py-3">Chưa có lịch di chuyển</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Sản lượng -->
        <div id="production" class="tab-pane fade">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Ngày</th>
                  <th>Loại mật</th>
                  <th>Sản lượng</th>
                  <th>Đàn ong</th>
                  <th>Địa điểm</th>
                  <th>Truy xuất</th>
                </tr>
              </thead>
              <tbody>
                <% production.forEach(x => { %>
                  <tr>
                    <td><%= x.ngay %></td>
                    <td><strong><%= x.loaiMat %></strong></td>
                    <td class="text-success fw-bold"><%= Number(x.sanLuong).toLocaleString('vi-VN') %> <%= x.donVi %></td>
                    <td><%= x.tenDanOng || '—' %></td>
                    <td><%= x.tenDiaDiem || '—' %></td>
                    <td>
                      <% if (x.maTruyXuat) { %>
                        <a target="_blank" href="/truy-xuat-qr?ma=<%= x.maTruyXuat %>" class="badge text-bg-warning text-decoration-none">
                          <i class="fa-solid fa-qrcode me-1"></i>#<%= x.maTruyXuat %>
                        </a>
                      <% } else { %>—<% } %>
                    </td>
                  </tr>
                <% }) %>
                <% if (!production.length) { %>
                  <tr><td colspan="6" class="text-center text-muted py-3">Chưa có sản lượng</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Đưa dữ liệu đàn ong vào thẻ script an toàn, chống mọi lỗi cú pháp -->
  <script id="hivesDataScript" type="application/json">
    <%- JSON.stringify(typeof hives !== 'undefined' ? hives : []) %>
  </script>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Khởi tạo bản đồ Leaflet -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      let hives = [];
      try {
        hives = JSON.parse(document.getElementById('hivesDataScript').textContent || '[]');
      } catch (err) {
        console.error("Lỗi parse dữ liệu đàn ong:", err);
      }

      const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const valid = hives.filter(x => x.viDo && x.kinhDo);

      // Khởi tạo bản đồ
      const map = L.map('hiveMap').setView(
        valid.length ? [valid[0].viDo, valid[0].kinhDo] : [14.0583, 108.2772], 
        valid.length ? 10 : 6
      );

      // Bản đồ nền Google Maps chuẩn
      L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        attribution: '© Google Maps contributors | Quản Lý Ong Mật',
        maxZoom: 20
      }).addTo(map);

      // ICON TỔ ONG MẬT VÀNG 3D (SVG sắc nét, định vị chuẩn xác đàn ong)
      const beeHiveIcon = L.divIcon({
        className: 'custom-beehive-marker',
        html: `
          <div style="filter: drop-shadow(0 4px 6px rgba(0,0,0,0.35)); cursor: pointer;">
            <svg width="40" height="46" viewBox="0 0 40 46" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Khung ghim giọt nước màu vàng mật ong -->
              <path d="M20 45C20 45 38 28.5 38 19C38 9.05887 29.9411 1 20 1C10.0589 1 2 9.05887 2 19C2 28.5 20 45 20 45Z" fill="#F59E0B" stroke="#B45309" stroke-width="1.8"/>
              <!-- Tầng 1 của tổ ong -->
              <ellipse cx="20" cy="11" rx="8" ry="3" fill="#FFFBEB"/>
              <!-- Tầng 2 của tổ ong -->
              <ellipse cx="20" cy="15.5" rx="10.5" ry="3.5" fill="#FEF08A"/>
              <!-- Tầng 3 của tổ ong -->
              <ellipse cx="20" cy="20.5" rx="11.5" ry="3.8" fill="#FDE047"/>
              <!-- Tầng đáy tổ ong -->
              <ellipse cx="20" cy="25" rx="9" ry="3.2" fill="#EAB308"/>
              <!-- Lỗ cửa tổ ong màu nâu sẫm -->
              <ellipse cx="20" cy="20.5" rx="2.5" ry="3" fill="#78350F"/>
            </svg>
          </div>
        `,
        iconSize: [40, 46],
        iconAnchor: [20, 45],
        popupAnchor: [0, -42]
      });

      // Đặt từng Marker đàn ong lên bản đồ
      valid.forEach(x => {
        L.marker([x.viDo, x.kinhDo], { icon: beeHiveIcon }).addTo(map).bindPopup(`
          <div style="font-size: 0.95rem; line-height: 1.6; min-width: 180px;">
            <strong style="color: #b45309; font-size: 1.05rem;"><i class="fa-solid fa-hive me-1"></i> ${esc(x.tenDanOng)}</strong><br>
            <b>Mã đàn:</b> ${esc(x.maDanOng)}<br>
            <b>Vị trí:</b> ${esc(x.tenDiaDiem || x.viTri || 'Chưa cập nhật')}<br>
            <b>Người nuôi:</b> ${esc(x.tenNguoiNuoiOng || '—')}<br>
            <b>Số lượng:</b> <span class="badge bg-warning text-dark">${esc(x.soThung || 0)} thùng</span><br>
            <b>Tình trạng:</b> ${esc(x.tinhTrang || 'Ổn định')}
          </div>
        `);
      });

      // Tự động thu phóng vừa vặn các đàn ong
      if (valid.length > 1) {
        map.fitBounds(valid.map(x => [x.viDo, x.kinhDo]), { padding: [40, 40] });
      }

      // Khắc phục triệt để hiện tượng ô xám khi load card
      setTimeout(() => { map.invalidateSize(); }, 350);
    });
  </script>
</body>

</html>
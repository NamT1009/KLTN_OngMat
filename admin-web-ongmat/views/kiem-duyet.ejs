            // Hàm tính khoảng cách địa lý (Haversine km)
            function findClosestRegion(lat, lng) {
                let nearest = null;
                let minDist = Infinity;
                for (const reg of VN_REGIONS) {
                    const dLat = (reg.lat - lat) * 111;
                    const dLng = (reg.lng - lng) * 111 * Math.cos(lat * Math.PI / 180);
                    const dist = Math.sqrt(dLat * dLat + dLng * dLng);
                    if (dist < minDist) {
                        minDist = dist;
                        nearest = reg;
                    }
                }
                return { region: nearest, distance: minDist };
            }

            // ================= NHẬN DIỆN SINH THÁI KHU VỰC (HOA, ONG, KHÍ HẬU) =================
            function detectEcology(lat, lng, addressText = '') {
                const raw = (addressText || '').toLowerCase();
                const norm = raw.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

                // 1. Khớp từ khóa địa chỉ nếu có
                if (raw.trim()) {
                    for (const reg of VN_REGIONS) {
                        const match = reg.keys.some(k => raw.includes(k) || norm.includes(k.normalize('NFD').replace(/[\u0300-\u036f]/g, '')));
                        if (match) {
                            return {
                                khiHau: reg.khiHau,
                                loaiHoa: reg.hoa,
                                loaiOng: reg.ong,
                                regionName: reg.name,
                                source: 'address_keyword'
                            };
                        }
                    }
                }

                // 2. Khớp theo khoảng cách tọa độ địa lý gần nhất trong lãnh thổ Việt Nam
                if (lat != null && !isNaN(lat) && lng != null && !isNaN(lng)) {
                    const closest = findClosestRegion(lat, lng);
                    if (closest.region && closest.distance <= 150) {
                        return {
                            khiHau: closest.region.khiHau,
                            loaiHoa: closest.region.hoa,
                            loaiOng: closest.region.ong,
                            regionName: closest.region.name,
                            distance: Math.round(closest.distance),
                            source: 'coordinate_distance'
                        };
                    }
                }

                // 3. Fallback theo dải vĩ độ
                let khiHau = 'Nhiệt đới gió mùa';
                let loaiHoa = 'Hoa rừng tự nhiên, Hoa nhãn';
                let loaiOng = 'Ong nội (Apis cerana)';
                if (lat != null && !isNaN(lat)) {
                    if (lat >= 21.0) {
                        khiHau = 'Cận nhiệt đới / Ôn hòa 4 mùa';
                        loaiHoa = 'Hoa nhãn, Hoa vải, Hoa mận, Hoa rừng tự nhiên';
                        loaiOng = 'Ong nội & Ong Ý';
                    } else if (lat >= 16.0 && lat < 21.0) {
                        khiHau = 'Nhiệt đới gió mùa miền Trung';
                        loaiHoa = 'Hoa keo tràm, Hoa rừng tự nhiên';
                        loaiOng = 'Ong nội & Ong Ý';
                    } else if (lat >= 11.5 && lat < 16.0) {
                        khiHau = 'Cao nguyên ôn hòa đất đỏ bazan';
                        loaiHoa = 'Hoa cà phê, Hoa cao su, Hoa điều';
                        loaiOng = 'Ong Ý (Apis mellifera)';
                    } else {
                        khiHau = 'Nhiệt đới ẩm Nam Bộ nắng ấm';
                        loaiHoa = 'Hoa tràm, Hoa dừa, Cây ăn trái';
                        loaiOng = 'Ong Ý & Ong dú';
                    }
                }

                return { khiHau, loaiHoa, loaiOng, regionName: 'Việt Nam', source: 'latitude_band' };
            }

            // ================= KHỞI TẠO BẢN ĐỒ ADMIN & GHIM VỊ TRÍ =================
            let adminPickMap = null;
            let adminMarker = null;

            function initAdminPickMap() {
                if (adminPickMap) {
                    adminPickMap.invalidateSize();
                    return;
                }
                const container = document.getElementById('adminPickMap');
                if (!container) return;

                const defaultCenter = [21.0285, 105.8542]; // Mặc định Hà Nội
                adminPickMap = L.map('adminPickMap').setView(defaultCenter, 6);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(adminPickMap);

                // Khi click trực tiếp lên bản đồ -> ghim marker & xử lý tọa độ thực tế ngay lập tức
                adminPickMap.on('click', function(e) {
                    const lat = e.latlng.lat;
                    const lng = e.latlng.lng;
                    capNhatBanDoAdmin(lat, lng, false);
                    xuLyToaDoThucTe(lat, lng, true);
                });
            }

            function capNhatBanDoAdmin(lat, lng, setView = true, zoom = 14) {
                if (!adminPickMap) initAdminPickMap();
                const latNum = Number(lat);
                const lngNum = Number(lng);
                if (isNaN(latNum) || isNaN(lngNum)) return;

                document.getElementById('viDo').value = latNum.toFixed(6);
                document.getElementById('kinhDo').value = lngNum.toFixed(6);

                const statusEl = document.getElementById('adminMapCoordStatus');
                if (statusEl) {
                    statusEl.innerHTML = `<i class="fas fa-check-circle text-success me-1"></i> Đã ghim: ${latNum.toFixed(4)}, ${lngNum.toFixed(4)}`;
                }

                if (adminMarker) {
                    adminMarker.setLatLng([latNum, lngNum]);
                } else {
                    adminMarker = L.marker([latNum, lngNum], { draggable: true }).addTo(adminPickMap);
                    adminMarker.on('dragend', function(e) {
                        const pos = e.target.getLatLng();
                        capNhatBanDoAdmin(pos.lat, pos.lng, false);
                        xuLyToaDoThucTe(pos.lat, pos.lng, true);
                    });
                }
                if (setView) {
                    adminPickMap.setView([latNum, lngNum], zoom);
                }
            }

            // Xử lý tọa độ thực tế: Điền hoa, ong, khí hậu và cập nhật địa chỉ tự động
            async function xuLyToaDoThucTe(lat, lng, updateAddressField = true) {
                // 1. Tìm vùng gần nhất từ từ điển tọa độ
                const closest = findClosestRegion(lat, lng);
                const addrInput = document.getElementById('diaChiChiTiet');

                // Nếu ô địa chỉ đang trống hoặc cần tự động điền
                if (updateAddressField && closest.region) {
                    addrInput.value = closest.region.name;
                }

                // 2. Tự động nhận diện sinh thái ngay lập tức
                tuDongNhanDienAdmin(true);

                // 3. Gọi Nominatim Reverse Geocoding chạy ngầm để lấy tên Xã/Huyện chi tiết hơn (nếu có mạng)
                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 2500);
                    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=14&addressdetails=1`, {
                        signal: controller.signal
                    });
                    clearTimeout(timeoutId);
                    if (res.ok) {
                        const data = await res.json();
                        if (data && data.display_name) {
                            // Tạo tên ngắn gọn: Xã/Phường, Huyện/Quận, Tỉnh/TP
                            const a = data.address || {};
                            const shortParts = [
                                a.village || a.suburb || a.quarter || a.town || a.hamlet,
                                a.district || a.county || a.city_district,
                                a.state || a.province || a.city
                            ].filter(Boolean);
                            const cleanAddr = shortParts.length ? shortParts.join(', ') : data.display_name.split(',').slice(0, 3).join(',');
                            if (cleanAddr && updateAddressField) {
                                addrInput.value = cleanAddr;
                                tuDongNhanDienAdmin(false); // Cập nhật lại sinh thái theo tên cụ thể
                            }
                        }
                    }
                } catch (e) {
                    // Fallback đã có closest.region.name
                }
            }

            // Tự động nhận diện sinh thái và điền vào các ô
            function tuDongNhanDienAdmin(showNotification = false) {
                const lat = parseFloat(document.getElementById('viDo').value);
                const lng = parseFloat(document.getElementById('kinhDo').value);
                const diaChi = document.getElementById('diaChiChiTiet').value;

                const eco = detectEcology(isNaN(lat) ? null : lat, isNaN(lng) ? null : lng, diaChi);

                const loaiHoaInput = document.getElementById('loaiHoa');
                const loaiOngInput = document.getElementById('loaiOngPhuHop');
                const khiHauInput = document.getElementById('khiHau');

                if (loaiHoaInput) loaiHoaInput.value = eco.loaiHoa;
                if (loaiOngInput) loaiOngInput.value = eco.loaiOng;
                if (khiHauInput) khiHauInput.value = eco.khiHau;

                const alertBox = document.getElementById('adminEcoAlertBox');
                const alertContent = document.getElementById('adminEcoAlertContent');
                if (alertBox && alertContent) {
                    const locationLabel = eco.regionName ? ` (Khu vực: <b>${eco.regionName}</b>)` : '';
                    alertContent.innerHTML = `
                        <div><strong>⚡ Đã tự động nhận diện theo vị trí${locationLabel}:</strong></div>
                        <div class="mt-1">
                            • Loài hoa đặc trưng: <b class="text-success">${eco.loaiHoa}</b><br>
                            • Giống ong thích hợp: <b class="text-warning-emphasis">${eco.loaiOng}</b><br>
                            • Khí hậu vùng: <i>${eco.khiHau}</i>
                        </div>
                        <div class="text-muted small mt-1"><i class="fas fa-edit me-1"></i>Các trường trên đã được điền tự động. Bạn vẫn có thể chỉnh sửa tùy ý hoặc bấm gợi ý bên dưới.</div>
                    `;
                    alertBox.classList.remove('d-none');
                }
            }

            // Lấy GPS từ thiết bị (Vị trí hiện tại)
            function layGpsAdmin() {
                if (!navigator.geolocation) {
                    alert('Trình duyệt không hỗ trợ Geolocation GPS.');
                    return;
                }

                const statusEl = document.getElementById('adminMapCoordStatus');
                if (statusEl) {
                    statusEl.innerHTML = '<i class="fas fa-spinner fa-spin text-primary me-1"></i> Đang lấy GPS...';
                }

                navigator.geolocation.getCurrentPosition(
                    (p) => {
                        const lat = p.coords.latitude;
                        const lng = p.coords.longitude;
                        capNhatBanDoAdmin(lat, lng, true, 15);
                        xuLyToaDoThucTe(lat, lng, true);
                    },
                    (err) => {
                        alert('Không thể lấy GPS từ thiết bị (' + err.message + '). Bạn hãy bấm trực tiếp lên bản đồ để chọn vị trí hoặc gõ tên địa phương vào ô tìm kiếm!');
                        if (statusEl) {
                            statusEl.innerHTML = '<i class="fas fa-exclamation-triangle text-warning me-1"></i> Chưa có GPS';
                        }
                    },
                    { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
                );
            }

            // ================= TÌM KIẾM ĐỊA ĐIỂM VÀ TỰ ĐỘNG GỢI Ý KHI NHẬP (HỖ TRỢ ĐỊA CHỈ CHI TIẾT) =================
            
            // ================= TÁCH VÀ TẠO CÁC CẤP ĐỘ ĐỊA CHỈ PHÙ HỢP (HỖ TRỢ SỐ NHÀ, NGÕ, HẺM) =================
            function generateAddressCandidates(input) {
                const list = [];
                const clean = (input || '').trim();
                if (!clean) return list;

                // 1. Tách bỏ số nhà, số hẻm (VD: '283/2 ' hoặc 'Số 15 ngõ 120 ' -> 'Đường Nguyễn Thị Nê, Phú Hòa Đông, Củ Chi...')
                const stripped = clean
                    .replace(/^[0-9]+[A-Za-z]?(\/[0-9]+[A-Za-z]?)*\s*,?\s*/i, '')
                    .replace(/^(số|số nhà|nhà số|hẻm|ngõ|ngách|thửa|lô)\s+[0-9A-Za-z\/\.\-]+\s*,?\s*/i, '')
                    .trim();

                // Ưu tiên địa chỉ đã bỏ số nhà trước vì dữ liệu bản đồ VN chủ yếu lưu theo Tên Đường / Xã / Huyện
                if (stripped && stripped !== clean) {
                    list.push(stripped);
                }

                // 2. Phân tách theo dấu phẩy để tìm theo cấp: Đường + Huyện + Tỉnh hoặc Xã + Huyện + Tỉnh
                const parts = clean.split(',').map(p => p.trim()).filter(Boolean);
                if (parts.length >= 3) {
                    // Bỏ phần đầu (thường là số nhà/thôn/ấp/ngõ)
                    const withoutFirst = parts.slice(1).join(', ');
                    if (!list.includes(withoutFirst)) list.push(withoutFirst);

                    if (parts.length >= 4) {
                        // Tên đường + Huyện + Tỉnh
                        const pStreet = parts[0].replace(/^[0-9]+[A-Za-z]?(\/[0-9]+[A-Za-z]?)*\s*/i, '').trim();
                        const streetDistCity = [pStreet, parts[parts.length - 2], parts[parts.length - 1]].join(', ');
                        if (!list.includes(streetDistCity)) list.push(streetDistCity);

                        // Xã/Phường + Huyện + Tỉnh
                        const communeDistCity = parts.slice(parts.length - 3).join(', ');
                        if (!list.includes(communeDistCity)) list.push(communeDistCity);
                    }

                    // Huyện + Tỉnh
                    const distCity = parts.slice(parts.length - 2).join(', ');
                    if (!list.includes(distCity)) list.push(distCity);
                }

                // Đưa cả chuỗi gốc vào danh sách thử nghiệm
                if (!list.includes(clean)) list.push(clean);

                return list;
            }

            // Gọi Geocoder đa tầng (Photon Komoot OSM + Nominatim + Từ điển nội bộ)
            async function findLocationCascade(address) {
                const candidates = generateAddressCandidates(address);

                // 1. Thử qua Photon Komoot OSM (chuyên xử lý tên đường, thôn xóm, không bị chặn User-Agent)
                for (const c of candidates) {
                    try {
                        const url = `https://photon.komoot.io/api/?q=${encodeURIComponent(c)}&limit=3`;
                        const res = await fetch(url, { signal: AbortSignal.timeout(2800) });
                        if (res.ok) {
                            const d = await res.json();
                            if (d && d.features && d.features.length) {
                                for (const f of d.features) {
                                    const [lon, lat] = f.geometry.coordinates;
                                    // Kiểm tra tọa độ thuộc lãnh thổ Việt Nam
                                    if (lat > 8.0 && lat < 24.0 && lon > 102.0 && lon < 110.0) {
                                        const p = f.properties || {};
                                        const foundTitle = [p.name, p.district, p.city].filter(Boolean).join(', ');
                                        return {
                                            lat: lat,
                                            lng: lon,
                                            matchedQuery: c,
                                            displayName: foundTitle || p.name || c,
                                            source: 'photon'
                                        };
                                    }
                                }
                            }
                        }
                    } catch (e) {
                        // Thử candidate tiếp theo
                    }
                }

                // 2. Thử qua OpenStreetMap Nominatim
                for (const c of candidates) {
                    try {
                        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(c + ', Vietnam')}&limit=1`;
                        const res = await fetch(url, { signal: AbortSignal.timeout(2500) });
                        if (res.ok) {
                            const d = await res.json();
                            if (d && d.length > 0) {
                                const lat = parseFloat(d[0].lat);
                                const lon = parseFloat(d[0].lon);
                                if (!isNaN(lat) && !isNaN(lon)) {
                                    return {
                                        lat: lat,
                                        lng: lon,
                                        matchedQuery: c,
                                        displayName: d[0].display_name.split(',').slice(0, 3).join(','),
                                        source: 'nominatim'
                                    };
                                }
                            }
                        }
                    } catch (e) {}
                }

                // 3. Tra cứu từ điển khu vực sinh thái nội bộ VN_REGIONS
                const raw = address.toLowerCase();
                const norm = raw.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                for (const reg of VN_REGIONS) {
                    const match = reg.keys.some(k => raw.includes(k) || norm.includes(k.normalize('NFD').replace(/[\u0300-\u036f]/g, '')));
                    if (match) {
                        return {
                            lat: reg.lat,
                            lng: reg.lng,
                            matchedQuery: reg.name,
                            displayName: reg.name,
                            source: 'local_database'
                        };
                    }
                }

                return null;
            }


            let searchDebounceTimer = null;

            // Xử lý autocomplete gợi ý địa điểm khi người dùng gõ
            function handleAddressInputAutocomplete(e) {
                clearTimeout(searchDebounceTimer);
                const query = (e.target.value || '').trim();
                const dropdown = document.getElementById('diaChiSuggestionsDropdown');

                if (query.length < 1) {
                    dropdown.classList.add('d-none');
                    dropdown.innerHTML = '';
                    return;
                }

                searchDebounceTimer = setTimeout(async () => {
                    const raw = query.toLowerCase();
                    const norm = raw.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

                    // 1. Tách số nhà để tìm tên đường / khu vực sạch
                    const cleanedStreet = query
                        .replace(/^[0-9]+[A-Za-z]?(\/[0-9]+[A-Za-z]?)*\s*,?\s*/i, '')
                        .replace(/^(số|số nhà|nhà số|hẻm|ngõ|ngách|thửa|lô)\s+[0-9A-Za-z\/\.\-]+\s*,?\s*/i, '')
                        .trim();

                    // 2. Tìm trong từ điển nội bộ VN_REGIONS
                    const localMatches = VN_REGIONS.filter(r => {
                        const nameNorm = r.name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                        return r.name.toLowerCase().includes(raw) ||
                               nameNorm.includes(norm) ||
                               r.keys.some(k => k.includes(raw) || raw.includes(k) || norm.includes(k.normalize('NFD').replace(/[\u0300-\u036f]/g, '')));
                    }).slice(0, 5);

                    // 3. Thử tìm qua Photon Komoot OSM với chuỗi đã làm sạch
                    let remoteMatches = [];
                    const qSearch = cleanedStreet && cleanedStreet.length >= 3 ? cleanedStreet : query;
                    try {
                        const url = `https://photon.komoot.io/api/?q=${encodeURIComponent(qSearch)}&limit=5`;
                        const res = await fetch(url, { signal: AbortSignal.timeout(2000) });
                        if (res.ok) {
                            const d = await res.json();
                            if (d && d.features && d.features.length) {
                                for (const f of d.features) {
                                    const [lon, lat] = f.geometry.coordinates;
                                    if (lat > 8.0 && lat < 24.0 && lon > 102.0 && lon < 110.0) {
                                        const p = f.properties || {};
                                        const title = [p.name, p.district, p.city].filter(Boolean).join(', ');
                                        if (title) {
                                            remoteMatches.push({
                                                name: title,
                                                lat: lat,
                                                lng: lon,
                                                isRemote: true
                                            });
                                        }
                                    }
                                }
                            }
                        }
                    } catch (err) {}

                    // Gộp kết quả và lọc trùng
                    const combined = [...localMatches];
                    for (const rm of remoteMatches) {
                        if (!combined.some(c => Math.abs(c.lat - rm.lat) < 0.02 && Math.abs(c.lng - rm.lng) < 0.02)) {
                            combined.push(rm);
                        }
                    }

                    if (combined.length === 0) {
                        dropdown.innerHTML = `<div class="p-2 text-muted small text-center"><i class="fas fa-info-circle me-1"></i> Bấm nút "Tìm Vị Trí" để hệ thống phân tích định vị chi tiết địa chỉ này.</div>`;
                        dropdown.classList.remove('d-none');
                        return;
                    }

                    // Hiển thị danh sách gợi ý
                    dropdown.innerHTML = combined.slice(0, 6).map(item => {
                        const eco = detectEcology(item.lat, item.lng, item.name);
                        return `
                            <button type="button" class="list-group-item list-group-item-action py-2 px-3 d-flex justify-content-between align-items-center suggestion-loc-item"
                                data-name="${item.name}" data-lat="${item.lat}" data-lng="${item.lng}">
                                <div class="text-start">
                                    <div class="fw-bold text-dark small">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i> ${item.name}
                                    </div>
                                    <div class="text-muted" style="font-size: 0.73rem;">
                                        <span class="text-success me-2"><i class="fas fa-seedling me-1"></i>${eco.loaiHoa}</span>
                                        <span class="text-warning-emphasis"><i class="fas fa-certificate me-1"></i>${eco.loaiOng}</span>
                                    </div>
                                </div>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2" style="font-size: 0.7rem;">Chọn</span>
                            </button>
                        `;
                    }).join('');
                    dropdown.classList.remove('d-none');
                }, 250);
            }

            // Khi click chọn một địa điểm trong danh sách gợi ý
            function selectLocationSuggestion(name, lat, lng) {
                const addrInput = document.getElementById('diaChiChiTiet');
                // Nếu người dùng có gõ số nhà ban đầu, giữ lại số nhà phía trước
                const currentVal = addrInput.value.trim();
                const houseNumMatch = currentVal.match(/^[0-9]+[A-Za-z]?(\/[0-9]+[A-Za-z]?)*/i);
                if (houseNumMatch && !name.startsWith(houseNumMatch[0])) {
                    addrInput.value = houseNumMatch[0] + ' ' + name;
                } else {
                    addrInput.value = name;
                }

                document.getElementById('diaChiSuggestionsDropdown').classList.add('d-none');
                capNhatBanDoAdmin(lat, lng, true, 15);
                xuLyToaDoThucTe(lat, lng, false);
            }

            // Nút bấm Tìm Vị Trí (Hỗ trợ định vị đa tầng từ số nhà, đường đến xã, huyện)
            async function timKiemDiaDiemAdmin() {
                const diaChi = document.getElementById('diaChiChiTiet').value.trim();
                if (!diaChi) {
                    alert('Vui lòng nhập địa chỉ, tên đường, xã hoặc huyện để tìm kiếm!');
                    document.getElementById('diaChiChiTiet').focus();
                    return;
                }

                document.getElementById('diaChiSuggestionsDropdown').classList.add('d-none');

                const btn = document.getElementById('btnTimDiaDiem');
                const oldBtnText = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang tìm...';
                btn.disabled = true;

                const result = await findLocationCascade(diaChi);

                btn.innerHTML = oldBtnText;
                btn.disabled = false;

                if (result && result.lat && result.lng) {
                    // Cập nhật bản đồ và ghim vị trí chính xác
                    capNhatBanDoAdmin(result.lat, result.lng, true, 15);
                    // Giữ nguyên địa chỉ chi tiết số nhà người dùng đã gõ, tự động điền hoa, ong, khí hậu
                    xuLyToaDoThucTe(result.lat, result.lng, false);

                    const statusEl = document.getElementById('adminMapCoordStatus');
                    if (statusEl) {
                        statusEl.innerHTML = `<i class="fas fa-check-circle text-success me-1"></i> Đã định vị: ${result.lat.toFixed(4)}, ${result.lng.toFixed(4)}`;
                    }
                } else {
                    alert('Không tìm thấy tọa độ tự động cho địa chỉ này. Bạn hãy bấm trực tiếp lên bản đồ bên dưới để ghim vị trí hoặc chọn gợi ý khi gõ!');
                }
            }

// ================= SỰ KIỆN KHỞI TẠO VÀ GẮN LISTENER =================
            document.addEventListener('DOMContentLoaded', () => {
                const modalEl = document.getElementById('modalThemDiaDiem');
                if (modalEl) {
                    modalEl.addEventListener('shown.bs.modal', () => {
                        initAdminPickMap();
                        setTimeout(() => {
                            if (adminPickMap) adminPickMap.invalidateSize();
                        }, 250);
                    });
                }

                // Gắn sự kiện gõ địa chỉ để hiển thị gợi ý (Autocomplete)
                const addrInput = document.getElementById('diaChiChiTiet');
                const dropdown = document.getElementById('diaChiSuggestionsDropdown');
                if (addrInput) {
                    addrInput.addEventListener('input', handleAddressInputAutocomplete);
                    addrInput.addEventListener('focus', (e) => {
                        if (addrInput.value.trim().length > 0) {
                            handleAddressInputAutocomplete(e);
                        }
                    });
                }

                // Click chọn item trong gợi ý
                document.addEventListener('click', (e) => {
                    const item = e.target.closest('.suggestion-loc-item');
                    if (item) {
                        const name = item.dataset.name;
                        const lat = parseFloat(item.dataset.lat);
                        const lng = parseFloat(item.dataset.lng);
                        selectLocationSuggestion(name, lat, lng);
                        return;
                    }

                    // Click ngoài dropdown thì ẩn dropdown
                    if (dropdown && !dropdown.contains(e.target) && e.target !== addrInput) {
                        dropdown.classList.add('d-none');
                    }
                });

                // Phím Escape để đóng dropdown gợi ý
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && dropdown) {
                        dropdown.classList.add('d-none');
                    }
                });

                // Hỗ trợ bấm chip để gán giá trị nhanh cho Loài hoa / Loài ong
                document.addEventListener('click', (e) => {
                    const chip = e.target.closest('.eco-chip');
                    if (chip) {
                        const targetId = chip.dataset.input;
                        const val = chip.dataset.val;
                        const input = document.getElementById(targetId);
                        if (input) {
                            input.value = val;
                            input.focus();
                        }
                    }
                });

                // Xử lý chọn ảnh file từ máy tính
                const fileInput = document.getElementById('adminImgFile');
                if (fileInput) {
                    fileInput.addEventListener('change', (e) => {
                        const file = e.target.files[0];
                        if (!file) return;
                        const reader = new FileReader();
                        reader.onload = (re) => {
                            document.getElementById('adminImgPreview').src = re.target.result;
                            document.getElementById('hinhAnh').value = re.target.result;
                        };
                        reader.readAsDataURL(file);
                    });
                }
            });

            // Hàm xem bản đồ Google Maps
            function xemBanDo(lat, lng, ten) {
                if (!lat || !lng) {
                    alert('Địa điểm này chưa có tọa độ GPS hợp lệ!');
                    return;
                }
                window.open(`https://www.google.com/maps?q=${lat},${lng}`, '_blank');
            }

            // Hàm Duyệt / Từ chối
            async function xulyDiaDiem(id, action) {
                let lyDoTuChoi = '';
                if (action === 'duyet') {
                    if (!confirm(`Xác nhận PHÊ DUYỆT địa điểm ID: ${id}?`)) return;
                } else if (action === 'tuchoi') {
                    lyDoTuChoi = prompt(`Vui lòng nhập lý do TỪ CHỐI địa điểm ID: ${id} để báo lại cho chủ đất:`);
                    if (lyDoTuChoi === null || lyDoTuChoi.trim() === '') {
                        alert("Bạn cần phải nhập lý do từ chối để chủ đất biết!");
                        return;
                    }
                }

                const apiUrl = action === 'duyet' ? '/api/dia-diem/duyet' : '/api/dia-diem/tu-choi';
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: id, lyDo: lyDoTuChoi })
                    });
                    const data = await response.json();
                    if (data.success) {
                        alert(data.message);
                        window.location.reload();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                } catch (error) {
                    alert("Không thể kết nối đến Server!");
                }
            }

            // Hàm Xóa Địa Điểm
            async function xoaDiaDiem(id) {
                if (!confirm(`CẢNH BÁO: Xác nhận XÓA VĨNH VIỄN địa điểm ID: ${id} khỏi hệ thống?`)) return;

                try {
                    const response = await fetch('/api/dia-diem/xoa', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: id })
                    });
                    const data = await response.json();
                    if (data.success) {
                        alert(data.message);
                        window.location.reload();
                    } else {
                        alert(data.message);
                    }
                } catch (error) {
                    alert("Không thể kết nối đến Server!");
                }
            }

            // Hàm Thêm Mới Địa Điểm
            async function submitThemDiaDiem() {
                const data = {
                    maChuDat: document.getElementById('maChuDat').value,
                    tenDiaDiem: document.getElementById('tenDiaDiem').value,
                    dienTich: document.getElementById('dienTich').value,
                    sucChuaToiDa: document.getElementById('sucChuaToiDa').value,
                    viDo: document.getElementById('viDo').value,
                    kinhDo: document.getElementById('kinhDo').value,
                    diaChiChiTiet: document.getElementById('diaChiChiTiet').value,
                    thongTinPhapLy: document.getElementById('thongTinPhapLy').value,
                    loaiHoa: document.getElementById('loaiHoa').value,
                    loaiOngPhuHop: document.getElementById('loaiOngPhuHop').value,
                    khiHau: document.getElementById('khiHau').value,
                    giaThueThang: document.getElementById('giaThueThang').value,
                    hinhAnh: document.getElementById('hinhAnh').value
                };

                if (!data.maChuDat || !data.tenDiaDiem || !data.dienTich || !data.sucChuaToiDa || !data.viDo || !data.kinhDo) {
                    alert("Vui lòng điền đầy đủ các trường bắt buộc: Chủ đất, Tên địa điểm, Diện tích, Sức chứa, Vĩ độ và Kinh độ!");
                    return;
                }

                try {
                    const response = await fetch('/them-dia-diem', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();

                    if (result.success) {
                        alert(result.message);
                        window.location.reload();
                    } else {
                        alert('Lỗi: ' + result.message);
                    }
                } catch (error) {
                    alert('Không thể kết nối đến máy chủ.');
                }
            }
</script>

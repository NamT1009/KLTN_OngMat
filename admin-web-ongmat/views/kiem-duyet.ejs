<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Kiểm Duyệt Địa Điểm | Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background-color: #343a40;
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            overflow-y: auto;
        }

        .sidebar-brand {
            padding: 20px;
            font-size: 1.2rem;
            font-weight: bold;
            background: #212529;
            text-align: center;
            color: #ffc107;
            border-bottom: 1px solid #4b545c;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar-menu li a {
            display: block;
            padding: 15px 20px;
            color: #c2c7d0;
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: 0.3s;
        }

        .sidebar-menu li a:hover,
        .sidebar-menu li a.active {
            background-color: #495057;
            color: #fff;
            border-left-color: #ffc107;
        }

        .sidebar-menu li a i {
            width: 25px;
            text-align: center;
            margin-right: 10px;
        }

        .main-content {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
        }
            .eco-chip {
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.75rem;
            user-select: none;
        }
        .eco-chip:hover {
            background-color: #e2e8f0 !important;
            transform: translateY(-1px);
        }
    </style>
</head>

<body>

    <!-- Nhúng Sidebar dùng chung -->
    <%- include('./partials/sidebar') %>

        <div class="main-content">
            <%- include('./partials/topbar') %>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="text-secondary fw-bold">Kiểm Duyệt Địa Điểm Vườn</h3>
                    <p class="text-muted mb-0">Xét duyệt các đăng ký điểm đặt ong mới từ Chủ đất dựa trên thông tin pháp
                        lý và tọa độ.</p>
                </div>
                <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemDiaDiem">
                    <i class="fas fa-plus-circle me-1"></i> Thêm Địa Điểm
                </button>
            </div>

            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark text-nowrap">
                            <tr>
                                <th class="ps-4 py-3">MÃ</th>
                                <th class="py-3">HÌNH ẢNH</th>
                                <th class="py-3">TÊN ĐỊA ĐIỂM / CHỦ ĐẤT</th>
                                <th class="py-3">DIỆN TÍCH & SỨC CHỨA</th>
                                <th class="py-3">THÔNG TIN PHÁP LÝ</th>
                                <th class="py-3 text-center">BẢN ĐỒ</th>
                                <th class="py-3 text-center">TRẠNG THÁI</th>
                                <th class="text-center py-3" style="min-width: 150px;">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <% if (typeof danhSachDiaDiem !=='undefined' && danhSachDiaDiem.length> 0) { %>
                                <% danhSachDiaDiem.forEach(function(item) { %>
                                    <tr>
                                        <!-- 1. Cột MÃ -->
                                        <td class="ps-4 text-muted fw-medium">#<%= item.maDiaDiem %>
                                        </td>

                                        <!-- 2. Cột HÌNH ẢNH -->
                                        <td>
                                            <% if (item.hinhAnh && item.hinhAnh.trim() !=='' ) { %>
                                                <a href="<%= item.hinhAnh %>" target="_blank" title="Xem ảnh lớn">
                                                    <img src="<%= item.hinhAnh %>" alt="Ảnh" onerror="this.onerror=null; this.src='/images/default-garden.svg';"
                                                        style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #dee2e6;">
                                                </a>
                                                <% } else { %>
                                                    <span class="text-muted"
                                                        style="display:none;"></span><img src="/images/default-garden.svg" alt="Ảnh vườn" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #dee2e6;" title="Chưa có ảnh (Ảnh minh họa)">
                                                    <% } %>
                                        </td>

                                        <!-- 3. Cột TÊN ĐỊA ĐIỂM / CHỦ ĐẤT -->
                                        <td>
                                            <div class="fw-bold text-primary mb-1">
                                                <%= item.tenDiaDiem %>
                                            </div>
                                            <div class="small text-muted">
                                                <i class="fas fa-user text-secondary me-1"></i>
                                                <%= item.tenChuDat || 'Chưa cập nhật' %>
                                            </div>
                                        </td>

                                        <!-- 4. Cột DIỆN TÍCH & SỨC CHỨA -->
                                        <td>
                                            <div class="text-dark mb-1">
                                                <%= item.dienTich %> m&sup2;
                                            </div>
                                            <div class="small text-muted">
                                                <i class="fas fa-archive text-secondary me-1"></i>Max: <%=
                                                    item.sucChuaToiDa || 0 %> đàn
                                            </div>
                                        </td>

                                        <!-- 5. Cột THÔNG TIN PHÁP LÝ -->
                                        <td>
                                            <div class="text-wrap" style="max-width: 250px;">
                                                <span class="text-muted small">
                                                    <%= item.thongTinPhapLy || 'Không có thông tin' %>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- 6. Cột BẢN ĐỒ -->
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-info rounded-pill px-3"
                                                onclick="xemBanDo(<%= item.viDo %>, <%= item.kinhDo %>, '<%= item.tenDiaDiem %>')">
                                                <i class="fas fa-map-marked-alt me-1"></i>Xem
                                            </button>
                                        </td>

                                        <!-- 7. Cột TRẠNG THÁI -->
                                        <td class="text-center">
                                            <% if (item.trangThaiKiemDuyet==='ChoDiemDuyet' ) { %>
                                                <span
                                                    class="badge rounded-pill bg-warning text-dark px-3 py-2 border border-warning"><i
                                                        class="fas fa-clock me-1"></i>Chờ Duyệt</span>
                                                <% } else if (item.trangThaiKiemDuyet==='DaDuyet' ) { %>
                                                    <span
                                                        class="badge rounded-pill bg-success px-3 py-2 border border-success"><i
                                                            class="fas fa-check-circle me-1"></i>Đã Duyệt</span>
                                                    <% } else { %>
                                                        <span
                                                            class="badge rounded-pill bg-danger px-3 py-2 border border-danger"><i
                                                                class="fas fa-times-circle me-1"></i>Từ Chối</span>
                                                        <% } %>
                                        </td>

                                        <!-- 8. Cột THAO TÁC -->
                                        <td class="text-center">
                                            <% if (item.trangThaiKiemDuyet==='ChoDiemDuyet' ) { %>
                                                <button class="btn btn-sm btn-success rounded-3 me-1"
                                                    onclick="xulyDiaDiem(<%= item.maDiaDiem %>, 'duyet')"
                                                    title="Duyệt"><i class="fas fa-check"></i></button>
                                                <button class="btn btn-sm btn-warning rounded-3 me-1"
                                                    onclick="xulyDiaDiem(<%= item.maDiaDiem %>, 'tuchoi')"
                                                    title="Từ chối"><i class="fas fa-ban text-dark"></i></button>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Đã xử lý</span>
                                                    <% } %>
                                                        <button class="btn btn-sm btn-danger rounded-3 ms-1"
                                                            onclick="xoaDiaDiem(<%= item.maDiaDiem %>)" title="Xóa"><i
                                                                class="fas fa-trash-alt"></i></button>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="8" class="text-center py-5 text-muted">
                                                    <i class="fas fa-inbox fa-3x mb-3 text-light"></i>
                                                    <h5>Không có đăng ký điểm đặt ong nào.</h5>
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Modal Thêm Địa Điểm Mới -->
        <div class="modal fade" id="modalThemDiaDiem" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-primary text-white py-3">
                        <h5 class="modal-title fw-bold">
                            <i class="fas fa-map-marked-alt me-2"></i>Thêm Địa Điểm & Nhận Diện Sinh Thái
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <form id="formThemDiaDiem">
                            <!-- Nhóm 1: Chủ đất & Tên địa điểm -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Chủ Đất <span class="text-danger">*</span></label>
                                    <select class="form-select" id="maChuDat" required>
                                        <option value="">-- Chọn chủ đất --</option>
                                        <% if (typeof danhSachChuDat !== 'undefined') { %>
                                            <% danhSachChuDat.forEach(chu => { %>
                                                <option value="<%= chu.maNguoiDung %>">
                                                    <%= chu.hoTen %> - <%= chu.soDienThoai %>
                                                </option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Tên Địa Điểm <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="tenDiaDiem"
                                        placeholder="VD: Vườn Vải Lục Ngạn, Đồi Mận Mộc Châu..." required>
                                </div>
                            </div>

                            <!-- Nhóm 2: Diện tích, Sức chứa, Giá thuê -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Diện Tích (m²) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="dienTich" placeholder="VD: 50000" min="1" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Sức Chứa Tối Đa (Đàn) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="sucChuaToiDa" placeholder="VD: 150" min="1" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Giá Thuê Đề Xuất (VNĐ/tháng)</label>
                                    <input type="number" class="form-control" id="giaThueThang" placeholder="VD: 1000000" min="0">
                                </div>
                            </div>

                            <!-- Nhóm 3: Tìm Kiếm Địa Điểm & Tọa Độ GPS -->
                            <div class="card border-0 bg-light p-3 rounded-3 mb-3">
                                <label class="form-label fw-bold small text-dark d-flex justify-content-between align-items-center mb-2">
                                    <span><i class="fas fa-search-location text-primary me-1"></i> Địa Chỉ & Tìm Kiếm Vị Trí <span class="text-danger">*</span></span>
                                    <span class="text-muted fw-normal" style="font-size:0.75rem;">Nhập tên xã/huyện/tỉnh rồi bấm Tìm Vị Trí</span>
                                </label>
                                <div class="position-relative mb-2">
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="diaChiChiTiet" placeholder="Nhập địa chỉ, xã, huyện, tỉnh... (gõ để xem gợi ý tự động)" autocomplete="off" required>
                                        <button class="btn btn-primary fw-bold px-3" type="button" id="btnTimDiaDiem" onclick="timKiemDiaDiemAdmin()">
                                            <i class="fas fa-search me-1"></i> Tìm Vị Trí
                                        </button>
                                    </div>
                                    <!-- Hộp gợi ý địa điểm tự động khi nhập -->
                                    <div id="diaChiSuggestionsDropdown" class="list-group shadow-lg position-absolute w-100 mt-1 d-none" style="z-index: 1060; max-height: 260px; overflow-y: auto; border-radius: 8px;"></div>
                                </div>

                                <div class="row g-2 mb-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label small text-muted mb-1">Vĩ Độ (Latitude) <span class="text-danger">*</span></label>
                                        <input type="number" step="any" class="form-control form-control-sm" id="viDo" placeholder="VD: 20.8465" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small text-muted mb-1">Kinh Độ (Longitude) <span class="text-danger">*</span></label>
                                        <input type="number" step="any" class="form-control form-control-sm" id="kinhDo" placeholder="VD: 104.6432" required>
                                    </div>
                                    <div class="col-md-4 d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary w-100 fw-semibold" onclick="layGpsAdmin()" title="Lấy GPS thực tế từ thiết bị">
                                            <i class="fas fa-crosshairs me-1"></i> Lấy GPS
                                        </button>
                                        <button type="button" class="btn btn-sm btn-warning text-dark w-100 fw-semibold" onclick="tuDongNhanDienAdmin(true)" title="Tự động nhận diện hoa, ong, khí hậu">
                                            <i class="fas fa-bolt me-1"></i> Nhận diện
                                        </button>
                                    </div>
                                </div>

                                <!-- Bản đồ chọn vị trí trực quan -->
                                <div class="position-relative mt-2">
                                    <div id="adminPickMap" style="height: 190px; border-radius: 8px; border: 1px solid #cbd5e1; z-index: 1;"></div>
                                    <div class="d-flex justify-content-between align-items-center mt-1">
                                        <small class="text-muted"><i class="fas fa-hand-pointer text-primary me-1"></i> Bấm trực tiếp lên bản đồ để di chuyển ghim & tự điền thông tin.</small>
                                        <span class="badge bg-white text-secondary border" id="adminMapCoordStatus" style="font-size:0.75rem;">Chưa ghim tọa độ</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Alert Box hiển thị kết quả tự động nhận diện -->
                            <div id="adminEcoAlertBox" class="alert alert-warning py-2 px-3 small mb-3 rounded-3 border-0 shadow-sm d-none" style="background:#fef3c7; color:#92400e;">
                                <div class="d-flex align-items-start">
                                    <i class="fas fa-wand-magic-sparkles text-amber me-2 mt-1 fs-6"></i>
                                    <div id="adminEcoAlertContent" class="flex-grow-1"></div>
                                </div>
                            </div>

                            <!-- Nhóm 4: Loài Hoa & Loài Ong Phù Hợp (Có gợi ý tự động & cho phép sửa tùy ý) -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-success d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-seedling me-1"></i> Loài Hoa Đặc Trưng</span>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-normal" style="font-size: 0.7rem;">Tự động điền • Có thể sửa</span>
                                    </label>
                                    <input type="text" class="form-control" id="loaiHoa" list="dlLoaiHoa" placeholder="VD: Hoa mận, Hoa vải thiều, Hoa cà phê...">
                                    <datalist id="dlLoaiHoa">
                                        <% if (typeof danhSachHoa !== 'undefined' && danhSachHoa.length) { %>
                                            <% danhSachHoa.forEach(h => { %>
                                                <option value="<%= h.tenLoaiHoa %>">
                                            <% }) %>
                                        <% } %>
                                        <option value="Hoa mận, Hoa mơ, Tam giác mạch">
                                        <option value="Hoa vải thiều đặc sản, Hoa cam">
                                        <option value="Hoa nhãn lồng, Hoa bưởi">
                                        <option value="Hoa cà phê, Hoa cao su, Hoa điều">
                                        <option value="Hoa bạc hà đá núi cao">
                                        <option value="Hoa tràm rừng U Minh, Hoa dừa">
                                        <option value="Hoa keo tràm, Hoa rừng tự nhiên">
                                    </datalist>
                                    <div class="d-flex flex-wrap gap-1 mt-1" id="flowerChipsContainer">
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiHoa" data-val="Hoa mận, Hoa mơ"><i class="fas fa-tag text-success me-1"></i>Hoa mận, mơ</span>
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiHoa" data-val="Hoa vải thiều đặc sản"><i class="fas fa-tag text-success me-1"></i>Hoa vải thiều</span>
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiHoa" data-val="Hoa nhãn lồng"><i class="fas fa-tag text-success me-1"></i>Hoa nhãn lồng</span>
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiHoa" data-val="Hoa cà phê, Hoa cao su"><i class="fas fa-tag text-success me-1"></i>Hoa cà phê</span>
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiHoa" data-val="Hoa bạc hà núi cao"><i class="fas fa-tag text-success me-1"></i>Hoa bạc hà</span>
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiHoa" data-val="Hoa tràm rừng U Minh"><i class="fas fa-tag text-success me-1"></i>Hoa tràm</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-warning-emphasis d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-certificate me-1"></i> Loài Ong Phù Hợp</span>
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-normal" style="font-size: 0.7rem;">Tự động điền • Có thể sửa</span>
                                    </label>
                                    <input type="text" class="form-control" id="loaiOngPhuHop" list="dlLoaiOng" placeholder="VD: Ong Ý (Apis mellifera), Ong nội...">
                                    <datalist id="dlLoaiOng">
                                        <% if (typeof danhSachOng !== 'undefined' && danhSachOng.length) { %>
                                            <% danhSachOng.forEach(o => { %>
                                                <option value="<%= o.tenLoaiOng %>">
                                            <% }) %>
                                        <% } %>
                                        <option value="Ong Ý (Apis mellifera)">
                                        <option value="Ong nội (Apis cerana)">
                                        <option value="Ong Ý & Ong nội">
                                        <option value="Ong dú (Stingless bee)">
                                    </datalist>
                                    <div class="d-flex flex-wrap gap-1 mt-1" id="beeChipsContainer">
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiOngPhuHop" data-val="Ong Ý (Apis mellifera)"><i class="fas fa-tag text-warning me-1"></i>Ong Ý</span>
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiOngPhuHop" data-val="Ong nội (Apis cerana)"><i class="fas fa-tag text-warning me-1"></i>Ong nội</span>
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiOngPhuHop" data-val="Ong Ý & Ong nội"><i class="fas fa-tag text-warning me-1"></i>Ong Ý & Ong nội</span>
                                        <span class="badge bg-light text-dark border px-2 py-1 eco-chip" data-input="loaiOngPhuHop" data-val="Ong dú (Stingless bee)"><i class="fas fa-tag text-warning me-1"></i>Ong dú</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Nhóm 5: Khí Hậu & Pháp Lý -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-info-emphasis d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-cloud-sun me-1"></i> Khí Hậu Vùng</span>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle fw-normal" style="font-size: 0.7rem;">Tự động tính từ GPS</span>
                                    </label>
                                    <input type="text" class="form-control" id="khiHau" placeholder="VD: Ôn đới núi cao mát mẻ (16°C - 24°C)">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Thông Tin Pháp Lý</label>
                                    <input type="text" class="form-control" id="thongTinPhapLy" placeholder="VD: Sổ đỏ chính chủ, đất nông nghiệp">
                                </div>
                            </div>

                            <!-- Nhóm 6: Hình ảnh vườn -->
                            <div class="mb-2">
                                <label class="form-label fw-bold small text-dark">Hình Ảnh Thực Tế Của Vườn</label>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="border rounded-3 p-1 bg-light text-center flex-shrink-0" style="width: 76px; height: 76px;">
                                        <img id="adminImgPreview" src="/images/default-garden.svg" class="w-100 h-100 rounded-2 object-fit-cover" onerror="this.onerror=null; this.src='/images/default-garden.svg';">
                                    </div>
                                    <div class="flex-grow-1">

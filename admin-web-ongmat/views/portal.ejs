      const html = sections.map((sec) => {
        const itemsHtml = sec.items.map((item) => {
          let badgeVal = 0;
          let badgeCls = 'bg-danger text-white';
          if (item.badgeKey === 'pendingRequests') badgeVal = s.pendingRequests;
          if (item.badgeKey === 'careDueSoon') { badgeVal = s.careDueSoon; badgeCls = 'bg-warning text-dark'; }
          if (item.badgeKey === 'contractsToSign') badgeVal = s.contractsToSign;
          if (item.badgeKey === 'unreadNotif') badgeVal = s.unreadNotifications;

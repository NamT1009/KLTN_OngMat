<!doctype html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= user.vaiTro==='chudat' ? 'Cổng Chủ Đất' : 'Cổng Người Nuôi Ong' %> | Hệ Thống Quản Lý & Truy Vết Ong Mật
  </title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 & Font Awesome 6 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

  <style>
    :root {
      --honey-primary: #f59e0b;
      --honey-dark: #d97706;
      --honey-soft: #fef3c7;
      --honey-subtle: #fffbeb;
      --honey-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      --honey-glow: 0 8px 24px -4px rgba(245, 158, 11, 0.35);

      --nature-green: #10b981;
      --nature-dark: #059669;
      --nature-soft: #d1fae5;

      --slate-900: #0f172a;
      --slate-800: #1e293b;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748b;
      --slate-200: #e2e8f0;
      --slate-100: #f1f5f9;
      --slate-50: #f8fafc;

      --radius-lg: 18px;
      --radius-md: 12px;
      --radius-sm: 8px;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, sans-serif !important;
      background-color: #f8fafc;
      color: var(--slate-800);
      margin: 0;
      padding: 0;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Custom Modern Scrollbars */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.05); }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* ================= SIDEBAR CHUẨN ADMIN - ĐẬM CHẤT NÔNG TRẠI & ONG MẬT ================= */
    aside.sidebar {
      width: 270px !important;
      height: 100vh !important;
      background: linear-gradient(180deg, #0e131f 0%, #151d2e 50%, #0d121c 100%) !important;
      color: #e2e8f0 !important;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      z-index: 1045 !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      border-right: 1px solid rgba(245, 158, 11, 0.18) !important;
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.35) !important;
      display: flex !important;
      flex-direction: column !important;
      transition: all 0.3s ease;
    }

    aside.sidebar::-webkit-scrollbar { width: 4px; }
    aside.sidebar::-webkit-scrollbar-thumb { background: rgba(245, 158, 11, 0.25); border-radius: 4px; }

    /* Brand Header with Honeybee Vector Logo */
    .sidebar-brand-custom {
      padding: 20px 18px 18px 18px;
      background: rgba(15, 23, 42, 0.75);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none !important;
      transition: background 0.2s;
    }

    .brand-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(217, 119, 6, 0.45));
      border: 1px solid rgba(245, 158, 11, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
      flex-shrink: 0;
      padding: 5px;
      transition: transform 0.25s ease;
    }

    .sidebar-brand-custom:hover .brand-icon-box {
      transform: scale(1.06);
    }

    .brand-text-box h5 {
      font-size: 0.98rem;
      font-weight: 800;
      margin: 0;
      letter-spacing: 0.6px;
      background: linear-gradient(135deg, #fef08a 0%, #fbbf24 60%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-text-box .brand-tagline {
      font-size: 0.72rem;
      color: #94a3b8;
      font-weight: 600;
      margin-top: 3px;
    }

    /* Menu Navigation List */
    .sidebar-menu-nav {
      list-style: none !important;
      padding: 14px 14px 28px 14px !important;
      margin: 0 !important;
      flex-grow: 1;
    }

    .menu-header-label {
      padding: 18px 12px 8px 12px;
      font-size: 0.7rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 1.2px;
    }

    .menu-header-label:first-of-type {
      padding-top: 4px;
    }

    .sidebar-menu-nav li {
      list-style: none !important;
      margin-bottom: 7px !important;
    }

    .sidebar-menu-nav a {
      display: flex !important;
      align-items: center !important;
      padding: 10px 14px !important;
      color: #94a3b8 !important;
      text-decoration: none !important;
      border-radius: 12px !important;
      font-size: 0.88rem !important;
      font-weight: 500 !important;
      transition: all 0.2s ease !important;
      position: relative;
    }

    .sidebar-menu-nav a .nav-icon-wrapper {
      width: 26px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      margin-right: 12px !important;
      font-size: 0.95rem !important;
      color: #64748b;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .sidebar-menu-nav a:hover {
      background-color: rgba(255, 255, 255, 0.08) !important;
      color: #f8fafc !important;
      transform: translateX(4px);
    }

    .sidebar-menu-nav a:hover .nav-icon-wrapper {
      color: #fbbf24;
    }

    /* Active Glowing Amber Capsule */
    .sidebar-menu-nav a.active {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%) !important;
      color: #0b0f19 !important;
      font-weight: 700 !important;
      box-shadow: 0 4px 18px rgba(245, 158, 11, 0.38) !important;
    }

    .sidebar-menu-nav a.active .nav-icon-wrapper {
      color: #0b0f19 !important;
    }

    .menu-badge-counter {
      margin-left: auto;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 20px;
    }

    /* Sidebar Footer User Card */
    .sidebar-footer-custom {
      padding: 14px 16px;
      background: rgba(10, 15, 26, 0.88);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: auto;
    }

    .user-avatar-mini {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1rem;
      overflow: hidden;
      flex-shrink: 0;
      border: 2px solid rgba(245, 158, 11, 0.5);
    }

    .user-info-mini {
      flex-grow: 1;
      overflow: hidden;
    }

    .user-info-mini .user-name {
      font-size: 0.86rem;
      font-weight: 700;
      color: #f1f5f9;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.25;
    }

    .user-info-mini .user-role {
      font-size: 0.7rem;
      color: #fbbf24;
      font-weight: 600;
      margin-top: 2px;
    }

    .btn-logout-mini {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.25);
      color: #ef4444;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      text-decoration: none;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .btn-logout-mini:hover {
      background: #ef4444;
      color: #fff;
      box-shadow: 0 0 14px rgba(239, 68, 68, 0.45);
      transform: translateY(-1px);
    }

    /* Main Content Area */
    .main-content {
      margin-left: 270px !important;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: #f8fafc;
      transition: margin-left 0.3s ease;
    }

    .content-wrapper {
      padding: 20px 26px 48px 26px;
      flex-grow: 1;
    }

    /* Topbar Header Container */
    .topbar-container-custom {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(226, 232, 240, 0.85);
      border-radius: 16px;
      padding: 12px 20px;
      margin-bottom: 22px;
      box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.05);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      position: sticky;
      top: 14px;
      z-index: 1020;
    }

    .topbar-welcome-tip {
      font-size: 0.88rem;
      color: #334155;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .topbar-actions-area {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* User Profile Pill in Header */
    .user-pill-wrap {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.35rem 0.85rem 0.35rem 0.45rem;
      border-radius: 99px;
      background: #ffffff;
      border: 1px solid var(--slate-200);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }

    .user-pill-wrap:hover {
      background: var(--slate-50);
      border-color: var(--honey-primary);
    }

    /* Backdrop for Mobile */
    .sidebar-backdrop {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      z-index: 1040;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .sidebar-backdrop.show {
      display: block;
      opacity: 1;
    }

    /* Responsive for Tablets & Mobile */
    @media (max-width: 991.98px) {
      aside.sidebar {
        transform: translateX(-100%);
      }
      aside.sidebar.show {
        transform: translateX(0);
      }
      .main-content {
        margin-left: 0 !important;
      }
      .content-wrapper {
        padding: 14px 14px 36px 14px;
      }
      .topbar-container-custom {
        top: 0;
        border-radius: 0 0 16px 16px;
        margin-bottom: 16px;
      }
    }
      transition: all 0.2s ease;
    }

    .nav-tab-btn:hover {
      background: var(--slate-100);
      color: var(--slate-900);
    }

    .nav-tab-btn:hover i {
      color: var(--honey-primary);
    }

    .nav-tab-btn.active {
      background: var(--honey-gradient);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
      border-color: transparent;
    }

    .nav-tab-btn.active i {
      color: #ffffff;
    }

    .nav-tab-btn .badge-pill-count {
      padding: 0.2rem 0.55rem;
      border-radius: 99px;
      font-size: 0.72rem;
      font-weight: 800;
    }

    /* ================= MAIN CONTENT ================= */
    .portal-content {
      padding: 1.5rem;
      flex: 1;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;
    }

    /* Welcome Hero Banner (Thân thiện, dễ tiếp cận) */
    .welcome-hero {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      border-radius: var(--radius-lg);
      padding: 1.75rem 2rem;
      color: #ffffff;
      margin-bottom: 1.5rem;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.15);
      position: relative;
      overflow: hidden;
    }

    .welcome-hero::after {
      content: '';
      position: absolute;
      right: -20px;
      top: -20px;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, rgba(245, 158, 11, 0) 70%);
      pointer-events: none;
    }

    .welcome-title {
      font-weight: 800;
      font-size: 1.55rem;
      margin-bottom: 0.4rem;
      letter-spacing: -0.3px;
    }

    .welcome-sub {
      color: #cbd5e1;
      font-size: 0.95rem;
      max-width: 750px;
      margin-bottom: 1.25rem;
      line-height: 1.5;
    }

    /* Step Guide Roadmap (3 bước trực quan dễ hiểu) */
    .step-roadmap {
      background: rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md);
      padding: 0.85rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
      border: 1px solid rgba(255, 255, 255, 0.12);
      margin-bottom: 1.25rem;
    }

    .step-item {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 0.88rem;
      font-weight: 600;
      color: #e2e8f0;
    }

    .step-badge {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--honey-primary);
      color: #ffffff;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
    }

    .step-arrow {
      color: rgba(255, 255, 255, 0.35);
      font-size: 0.85rem;
    }

    /* Quick Action Buttons (To, rõ ràng, dễ bấm) */
    .quick-cta-btn {
      padding: 0.65rem 1.35rem;
      border-radius: 99px;
      font-weight: 800;
      font-size: 0.92rem;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      border: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
      transition: all 0.2s ease;
      cursor: pointer;
      text-decoration: none;
    }

    .quick-cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    .quick-cta-btn.amber {
      background: var(--honey-gradient);
      color: #ffffff;
    }

    .quick-cta-btn.green {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
    }

    .quick-cta-btn.light {
      background: rgba(255, 255, 255, 0.15);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    /* ================= STAT CARDS ================= */
    .stat-card {
      background: #ffffff;
      border-radius: var(--radius-lg);
      border: 1px solid var(--slate-200);
      padding: 1.35rem 1.5rem;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
      cursor: pointer;
      transition: all 0.25s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      border-color: var(--honey-primary);
      box-shadow: 0 12px 24px -4px rgba(245, 158, 11, 0.12);
    }

    .stat-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }

    .stat-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
    }

    .stat-icon-box.amber { background: #fef3c7; color: #d97706; }
    .stat-icon-box.emerald { background: #d1fae5; color: #059669; }
    .stat-icon-box.sky { background: #e0f2fe; color: #0284c7; }
    .stat-icon-box.rose { background: #ffe4e6; color: #e11d48; }

    .stat-number {
      font-size: 2.15rem;
      font-weight: 800;
      color: var(--slate-900);
      line-height: 1.1;
      margin-bottom: 0.35rem;
      letter-spacing: -0.5px;
    }

    .stat-title {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--slate-600);
      margin: 0;
    }

    /* ================= CARD CONTAINERS ================= */
    .card-modern {
      background: #ffffff;
      border-radius: var(--radius-lg);
      border: 1px solid var(--slate-200);
      box-shadow: 0 4px 18px rgba(15, 23, 42, 0.03);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .card-header-modern {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--slate-100);
    }

    .card-title-modern {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--slate-900);
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    /* ================= BẢN ĐỒ ================= */
    .map-container {
      height: 420px;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--slate-200);
    }

    .map-sm {
      height: 300px;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--slate-200);
    }

    /* ================= TABLES ================= */
    .table-modern-wrap {
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--slate-200);
    }

    .table-modern {
      margin-bottom: 0;
      width: 100%;
    }

    .table-modern thead th {
      background: var(--slate-50);
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--slate-600);
      padding: 0.95rem 1.15rem;
      border-bottom: 1px solid var(--slate-200);
    }

    .table-modern tbody td {
      padding: 1rem 1.15rem;
      vertical-align: middle;
      border-bottom: 1px solid var(--slate-100);
      font-size: 0.9rem;
    }

    .table-modern tbody tr:last-child td { border-bottom: none; }
    .table-modern tbody tr:hover td { background-color: #fafbfc; }

    /* ================= CHAT HUB ================= */
    .chat-layout {
      height: 660px;
      background: #ffffff;
      border-radius: var(--radius-lg);
      border: 1px solid var(--slate-200);
      overflow: hidden;
      display: flex;
      box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
    }

    .chat-sidebar-pane {
      width: 320px;
      border-right: 1px solid var(--slate-200);
      display: flex;
      flex-direction: column;
      background: #fafbfc;
      flex-shrink: 0;
    }

    .chat-main-pane {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #ffffff;
      min-width: 0;
    }

    .chat-list-item {
      padding: 0.9rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      border-bottom: 1px solid var(--slate-100);
      cursor: pointer;
      transition: all 0.15s;
    }

    .chat-list-item:hover { background: var(--slate-100); }
    .chat-list-item.active { background: #fffbeb; border-left: 4px solid var(--honey-primary); }

    .chat-msg-area {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      background: #f8fafc;
    }

    .chat-bubble {
      max-width: 72%;
      padding: 0.8rem 1.15rem;
      border-radius: 18px;
      font-size: 0.92rem;
      line-height: 1.45;
      word-break: break-word;
      position: relative;
    }

    .chat-bubble.mine {
      align-self: flex-end;
      background: var(--honey-gradient);
      color: #ffffff;
      border-bottom-right-radius: 4px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);
    }

    .chat-bubble.theirs {
      align-self: flex-start;
      background: #ffffff;
      color: var(--slate-900);
      border: 1px solid var(--slate-200);
      border-bottom-left-radius: 4px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .chat-bubble-time {
      font-size: 0.7rem;
      opacity: 0.75;
      margin-top: 0.25rem;
      text-align: right;
    }

    .chat-input-bar {
      padding: 0.85rem 1.25rem;
      background: #ffffff;
      border-top: 1px solid var(--slate-200);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    /* Task done strikethrough */
    .task-done {
      text-decoration: line-through;
      color: var(--slate-400) !important;
    }

    /* Toast */
    #toast-area {
      position: fixed;
      top: 24px;
      right: 24px;
      z-index: 99999;
      max-width: 420px;
      width: calc(100% - 48px);
      pointer-events: none;
    }

    .toast-custom {
      pointer-events: auto;
      background: #ffffff;
      border-radius: var(--radius-md);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
      border: 1px solid var(--slate-200);
      border-left: 5px solid var(--honey-primary);
      padding: 0.95rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 0.65rem;
      animation: slideIn 0.3s ease;
    }

    .toast-custom.error { border-left-color: #ef4444; }
    .toast-custom.success { border-left-color: #10b981; }

    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
  </style>
</head>

<body>
  <!-- Backdrop cho menu trượt trên điện thoại / tablet -->
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

  <!-- ASIDE SIDEBAR CHUẨN ADMIN - ĐẬM CHẤT NÔNG TRẠI & ONG MẬT ẤM CÚNG -->
  <aside class="sidebar portal-sidebar" id="portalSidebar">
    <!-- Brand Header với Logo Con Ong Mật Vector Cao Cấp -->
    <a href="#overview" class="sidebar-brand-custom" data-tab="overview">
      <div class="brand-icon-box">
        <svg viewBox="0 0 64 64" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="32,4 58,18 58,46 32,60 6,46 6,18" fill="url(#portalSideHexGrad)" stroke="#f59e0b" stroke-width="2.5" stroke-linejoin="round"/>
          <ellipse cx="20" cy="23" rx="8" ry="14" transform="rotate(-38 20 23)" fill="url(#portalSideWingGrad)" stroke="#fef08a" stroke-width="1.2" opacity="0.95"/>
          <ellipse cx="44" cy="23" rx="8" ry="14" transform="rotate(38 44 23)" fill="url(#portalSideWingGrad)" stroke="#fef08a" stroke-width="1.2" opacity="0.95"/>
          <ellipse cx="32" cy="36" rx="11" ry="16" fill="url(#portalSideBodyGrad)"/>
          <path d="M22.5 30 Q32 32.5 41.5 30 L41 33.5 Q32 36 23 33.5 Z" fill="#0f172a"/>
          <path d="M21.5 37 Q32 40 42.5 37 L41.5 40.5 Q32 43.5 22.5 40.5 Z" fill="#0f172a"/>
          <path d="M24 44.5 Q32 47 40 44.5 L38.5 48 Q32 50.5 25.5 48 Z" fill="#0f172a"/>
          <path d="M30.5 51.5 L32 56 L33.5 51.5 Z" fill="#0f172a"/>
          <circle cx="32" cy="22" r="7.5" fill="#f59e0b"/>
          <ellipse cx="29" cy="21" rx="1.8" ry="2.2" fill="#0f172a"/>
          <ellipse cx="35" cy="21" rx="1.8" ry="2.2" fill="#0f172a"/>
          <path d="M29 16 Q26 9 20 11" stroke="#d97706" stroke-width="2" stroke-linecap="round" fill="none"/>
          <path d="M35 16 Q38 9 44 11" stroke="#d97706" stroke-width="2" stroke-linecap="round" fill="none"/>
          <defs>
            <linearGradient id="portalSideHexGrad" x1="6" y1="4" x2="58" y2="60" gradientUnits="userSpaceOnUse">
              <stop stop-color="#b45309" stop-opacity="0.45"/>
              <stop offset="1" stop-color="#f59e0b" stop-opacity="0.12"/>
            </linearGradient>
            <linearGradient id="portalSideBodyGrad" x1="21" y1="20" x2="43" y2="52" gradientUnits="userSpaceOnUse">
              <stop stop-color="#fde047"/>
              <stop offset="0.5" stop-color="#f59e0b"/>
              <stop offset="1" stop-color="#d97706"/>
            </linearGradient>
            <linearGradient id="portalSideWingGrad" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#ffffff" stop-opacity="0.95"/>
              <stop offset="0.8" stop-color="#fef9c3" stop-opacity="0.8"/>
              <stop offset="1" stop-color="#fde047" stop-opacity="0.5"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="brand-text-box">
        <h5>TRUY VẾT ONG MẬT</h5>
        <div class="brand-tagline">
          <% if (user.vaiTro === 'chudat') { %>
            <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35); font-size: 0.68rem;">
              <i class="fas fa-mountain-sun me-1"></i> Cổng Chủ Đất Vườn
            </span>
          <% } else { %>
            <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35); font-size: 0.68rem;">
              <i class="fas fa-hive me-1"></i> Cổng Người Nuôi Ong
            </span>
          <% } %>
        </div>
      </div>
    </a>

    <!-- Menu Danh Mục Điều Hướng Tương Tự Admin -->
    <ul class="sidebar-menu-nav" id="sidebarMenuNav">
      <!-- Được render động bằng renderNavBar() -->
    </ul>

    <!-- Sidebar Footer Thông Tin Tài Khoản & Nút Đăng Xuất -->
    <div class="sidebar-footer-custom">
      <div class="user-avatar-mini" id="sidebarUserAvatar">
        <% if (user.anhDaiDien) { %>
          <img src="<%= user.anhDaiDien %>" class="w-100 h-100 object-fit-cover" onerror="this.onerror=null; this.src='/images/default-avatar.svg';">
        <% } else { %>
          <%= (user.hoTen || 'U').charAt(0).toUpperCase() %>
        <% } %>
      </div>
      <div class="user-info-mini">
        <div class="user-name"><%= user.hoTen %></div>
        <div class="user-role">
          <% if (user.vaiTro === 'chudat') { %>
            <i class="fas fa-mountain-sun me-1 text-success"></i>Chủ Vườn Đất
          <% } else { %>
            <i class="fas fa-certificate me-1 text-warning"></i>Người Nuôi Ong
          <% } %>
        </div>
      </div>
      <a href="/logout" class="btn-logout-mini" title="Đăng xuất khỏi hệ thống">
        <i class="fas fa-arrow-right-from-bracket"></i>
      </a>
    </div>
  </aside>

  <!-- KHU VỰC NỘI DUNG CHÍNH (main-content với margin-left: 270px) -->
  <div class="main-content">
    <div class="content-wrapper">
      <!-- Topbar Nổi Đẹp Mắt Tương Tự Admin -->
      <div class="topbar-container-custom">
        <div class="d-flex align-items-center gap-3">
          <!-- Nút Menu 3 gạch trên Mobile/Tablet -->
          <button class="btn btn-sm btn-light border d-lg-none" id="sidebarToggle" style="border-radius: 10px;" title="Mở danh mục">
            <i class="fas fa-bars fs-6 text-dark"></i>
          </button>

          <!-- Lời chào & Gợi ý mùa hoa nông trại -->
          <div class="topbar-welcome-tip d-none d-sm-flex align-items-center">
            <% if (user.vaiTro === 'chudat') { %>
              <i class="fas fa-seedling text-success fs-5 me-2"></i>
              <div>
                <div>Xin chào Bác <b><%= user.hoTen %></b>! <span class="badge text-bg-success-subtle text-success border border-success-subtle ms-1" id="headerReputationBadge"></span></div>
                <div class="small text-muted" style="font-size: 0.75rem;">Mùa hoa nở rộ, sẵn sàng đón các đàn ong đến lấy mật & thụ phấn cây trồng.</div>
              </div>
            <% } else { %>
              <i class="fas fa-sun text-warning fs-5 me-2"></i>
              <div>
                <div>Xin chào Bác <b><%= user.hoTen %></b>! <span class="badge text-bg-warning-subtle text-warning border border-warning-subtle ms-1" id="headerReputationBadge"></span></div>
                <div class="small text-muted" style="font-size: 0.75rem;">Thời tiết hôm nay nắng ấm thuận lợi, đàn ong đang tích cực kiếm mật hoa.</div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Các Nút Thao Tác Nhanh Phía Phải -->
        <div class="topbar-actions-area">
          <!-- Nút Hành Động Nhanh Tùy Theo Vai Trò -->
          <% if (user.vaiTro === 'chudat') { %>
            <button class="btn btn-sm btn-warning fw-bold text-dark rounded-pill px-3 shadow-sm d-flex align-items-center gap-2" onclick="locationForm()" style="background: var(--honey-gradient); border:none; color:#fff !important;">
              <i class="fas fa-plus-circle"></i>
              <span class="d-none d-md-inline">Đăng Vườn Mới</span>
            </button>
          <% } else { %>
            <button class="btn btn-sm btn-warning fw-bold text-dark rounded-pill px-3 shadow-sm d-flex align-items-center gap-2" onclick="hiveForm()" style="background: var(--honey-gradient); border:none; color:#fff !important;">
              <i class="fas fa-plus-circle"></i>
              <span class="d-none d-md-inline">Tạo Đàn Ong</span>
            </button>
          <% } %>

          <!-- Nút Tin Nhắn Trao Đổi -->
          <button class="btn btn-outline-warning btn-sm text-dark fw-bold rounded-pill px-3 position-relative d-flex align-items-center gap-2" data-tab="chat" title="Mở hộp tin nhắn">
            <i class="fas fa-comments text-warning"></i>
            <span class="d-none d-md-inline">Tin nhắn</span>
            <span class="badge rounded-pill bg-danger d-none" id="chatBadgeTop">0</span>
          </button>

          <!-- Nút Chuông Thông Báo -->
          <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 position-relative" data-tab="notifications" title="Thông báo hệ thống">
            <i class="fas fa-bell"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notifBadgeTop">0</span>
          </button>

          <!-- Avatar & Menu Tài Khoản Dropdown -->
          <div class="dropdown">
            <div class="user-pill-wrap" data-bs-toggle="dropdown" aria-expanded="false">
              <span id="userTopAvatar">
                <% if (user.anhDaiDien) { %>
                  <img src="<%= user.anhDaiDien %>" class="rounded-circle" width="34" height="34" style="object-fit:cover;" onerror="this.onerror=null; this.src='/images/default-avatar.svg';">
                <% } else { %>
                  <span class="rounded-circle bg-warning text-white fw-bold d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;font-size:0.9rem;">
                    <%= (user.hoTen || 'U').charAt(0).toUpperCase() %>
                  </span>
                <% } %>
              </span>
              <div class="d-none d-md-block text-start">
                <div class="fw-bold small text-dark leading-none"><%= user.hoTen %></div>
                <div class="text-muted" style="font-size:0.72rem;"><i class="fas fa-circle text-success me-1" style="font-size:7px;"></i>Trực tuyến</div>
              </div>
              <i class="fas fa-chevron-down text-muted small ms-1"></i>
            </div>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" style="border-radius:14px; min-width: 220px;">
              <li class="px-3 py-2 border-bottom">
                <div class="fw-bold small text-dark"><%= user.hoTen %></div>
                <div class="text-muted" style="font-size:0.75rem;"><%= user.email || user.soDienThoai %></div>
              </li>
              <li><a class="dropdown-item py-2 small" href="#profile" data-tab="profile"><i class="fas fa-user-circle me-2 text-warning"></i> Hồ sơ & Đổi ảnh đại diện</a></li>
              <li><a class="dropdown-item py-2 small" href="#profile" data-tab="profile"><i class="fas fa-key me-2 text-info"></i> Đổi mật khẩu tài khoản</a></li>
              <li><hr class="dropdown-divider my-1"></li>
              <li><a class="dropdown-item py-2 small text-danger fw-semibold" href="/logout"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Trạng Thái Tải & Vùng Hiển Thị Nội Dung Chính -->
      <div id="loading" class="text-center py-5">
        <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;"></div>
        <div class="text-muted small mt-2">Đang tải dữ liệu trang...</div>
      </div>
      <div id="content"></div>
    </div>
  </div>

  <!-- FORM MODAL ĐỘNG -->
  <div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <form class="modal-content border-0 shadow-lg" id="modalForm" novalidate style="border-radius: 18px;">
        <div class="modal-header border-bottom px-4 py-3 bg-light" style="border-radius: 18px 18px 0 0;">
          <h5 class="modal-title fw-bold" id="modalTitle"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-3" id="modalBody"></div>
          <div class="text-danger small mt-2 fw-semibold" id="modalError"></div>
        </div>
        <div class="modal-footer border-top px-4 py-3 bg-light" style="border-radius: 0 0 18px 18px;">
          <button type="button" class="btn btn-light fw-semibold px-3" data-bs-dismiss="modal">Hủy</button>
          <button class="btn btn-warning fw-bold px-4" id="modalSubmit" style="background:var(--honey-gradient); border:none; color:#fff;">Lưu thay đổi</button>
        </div>
      </form>
    </div>
  </div>

  <!-- IMAGE VIEWER MODAL -->
  <div class="modal fade" id="imageViewerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content bg-transparent border-0 text-center">
        <div class="position-relative d-inline-block m-auto">
          <button type="button" class="btn btn-dark btn-sm rounded-circle position-absolute top-0 end-0 m-2" data-bs-dismiss="modal"><i class="fas fa-times"></i></button>
          <img id="viewerImage" src="" class="img-fluid rounded-3 shadow-lg" style="max-height: 80vh; object-fit: contain;">
        </div>
      </div>
    </div>
  </div>

  <!-- TOAST CONTAINER -->
  <div id="toast-area"></div>

  <!-- SCRIPTS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    // ================= KHỞI TẠO BIẾN & TRẠNG THÁI =================
    const ROLE = '<%= user.vaiTro %>';
    const IS_LANDOWNER = ROLE === 'chudat';
    const API = '/api/mobile';
    const CURRENT_USER = {
      id: Number('<%= user.id %>'),
      hoTen: '<%= user.hoTen %>',
      vaiTro: ROLE,
      email: '<%= user.email || "" %>',
      soDienThoai: '<%= user.soDienThoai || "" %>',
      anhDaiDien: '<%= user.anhDaiDien || "" %>'
    };

    const state = {
      tab: location.hash.slice(1) || 'overview',
      data: {},
      contracts: [],
      available: [],
      requests: [],
      traces: [],
      profile: {},
      catalog: { flowers: [], bees: [] },
      chat: {
        conversations: [],
        activePartnerId: null,
        activePartner: null,
        messages: [],
        unreadCount: 0
      },
      filters: {
        keyword: '',
        flower: '',
        bee: '',
        capacity: '',
        price: ''
      }
    };

    // ================= TIỆN ÍCH DỄ DÙNG =================
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const num = (v) => Number(v || 0).toLocaleString('vi-VN');
    const money = (v) => (v == null || v === '' ? 'Thỏa thuận' : num(v) + ' đ');
    const today = () => new Date(Date.now() + 7 * 3600e3).toISOString().slice(0, 10);

    const STATUS_MAP = {
      ChoDuyet: ['Chờ duyệt', 'bg-warning-subtle text-warning-emphasis border border-warning'],
      ChoKhachKy: ['Chờ ký HĐ', 'bg-primary-subtle text-primary border border-primary'],
      DaKy: ['Đã ký / Hiệu lực', 'bg-success-subtle text-success border border-success'],
      HoanThanh: ['Đã hoàn tất', 'bg-success text-white'],
      TuChoi: ['Từ chối', 'bg-danger-subtle text-danger border border-danger'],
      DaHuy: ['Đã hủy', 'bg-secondary-subtle text-secondary border border-secondary'],
      ChoDiemDuyet: ['Chờ kiểm duyệt', 'bg-warning-subtle text-warning-emphasis border border-warning'],
      DaDuyet: ['Đã duyệt', 'bg-success-subtle text-success border border-success'],
      'Lên lịch': ['Lên lịch', 'bg-primary-subtle text-primary border border-primary'],
      'Đã hoàn thành': ['Đã hoàn tất', 'bg-success-subtle text-success border border-success'],
      'Đang di chuyển': ['Đang di chuyển', 'bg-warning-subtle text-warning-emphasis border border-warning'],
      'Hoàn thành': ['Hoàn tất', 'bg-success text-white']
    };

    const chip = (s) => {
      const [label, cls] = STATUS_MAP[s] || [s || '—', 'bg-light text-secondary border'];
      return `<span class="badge rounded-pill px-3 py-1 font-semibold ${cls}" style="font-size:0.78rem;">${esc(label)}</span>`;
    };

    const reputationBadge = (isNew, rating, count) => {
      const c = Number(count || 0);
      const r = Number(rating || 0);
      const userIsNew = isNew === true || isNew === 1 || isNew === '1' || c === 0 || !r;
      if (userIsNew) {
        return `<span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size:0.75rem;" title="Người mới tham gia"><i class="fas fa-seedling me-1"></i> Người mới</span>`;
      }
      return `<span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" style="font-size:0.75rem;" title="Uy tín: ${r.toFixed(1)}/5 sao"><i class="fas fa-star text-warning me-1"></i> <b>${r.toFixed(1)}</b>/5 (${c} ĐG)</span>`;
    };

    function toast(message, error = false) {
      const el = document.createElement('div');
      el.className = `toast-custom ${error ? 'error' : 'success'}`;
      el.innerHTML = `
        <i class="fas ${error ? 'fa-circle-exclamation text-danger' : 'fa-check-circle text-success'} fs-5"></i>
        <div class="flex-grow-1 small fw-bold text-dark">${esc(message)}</div>
        <button type="button" class="btn-close btn-sm ms-2" onclick="this.closest('.toast-custom').remove()"></button>
      `;
      document.getElementById('toast-area').appendChild(el);
      setTimeout(() => el.remove(), 4000);
    }

    function viewImage(url) {
      if (!url) return;
      document.getElementById('viewerImage').src = url;
      new bootstrap.Modal(document.getElementById('imageViewerModal')).show();
    }

    // ================= API GỌI CHUẨN =================
    async function api(method, path, body) {
      const isFormData = body instanceof FormData;
      const headers = isFormData ? {} : { 'Content-Type': 'application/json' };
      const res = await fetch(API + path, {
        method,
        headers,
        body: isFormData ? body : (body ? JSON.stringify(body) : undefined)
      });
      if (res.status === 401) { location.href = '/login'; throw new Error('Phiên đăng nhập đã hết hạn.'); }
      const json = await res.json().catch(() => ({}));
      if (!res.ok || json.success === false) throw new Error(json.message || 'Yêu cầu thất bại.');
      return json;
    }

    async function act(method, path, body, confirmText) {
      if (confirmText && !confirm(confirmText)) return false;
      try {
        const json = await api(method, path, body);
        toast(json.message || 'Thao tác thành công');
        await load();
        return json;
      } catch (e) {
        toast(e.message, true);
        return false;
      }
    }

    // ================= TẢI TOÀN BỘ DỮ LIỆU =================
    async function load() {
      try {
        if (IS_LANDOWNER) {
          const [dash, profile, flowers, bees] = await Promise.all([
            api('GET', '/landowner/dashboard'),
            api('GET', '/profile').catch(() => ({ data: {} })),
            api('GET', '/catalog/flowers').catch(() => ({ data: [] })),
            api('GET', '/catalog/bees').catch(() => ({ data: [] }))
          ]);
          state.data = dash.data || {};
          state.contracts = dash.data.contracts || [];
          state.profile = profile.data || {};
          state.catalog.flowers = flowers.data || [];
          state.catalog.bees = bees.data || [];
        } else {
          const [dash, contracts, available, requests, traces, profile, flowers, bees] = await Promise.all([
            api('GET', '/beekeeping/dashboard'),
            api('GET', '/contracts'),
            api('GET', '/beekeeping/locations'),
            api('GET', '/beekeeping/rental-requests'),
            api('GET', '/beekeeping/traces'),
            api('GET', '/profile').catch(() => ({ data: {} })),
            api('GET', '/catalog/flowers').catch(() => ({ data: [] })),
            api('GET', '/catalog/bees').catch(() => ({ data: [] }))
          ]);
          state.data = dash.data || {};
          state.contracts = contracts.data || [];
          state.available = available.data || [];
          state.requests = requests.data || [];
          state.traces = traces.data || [];
          state.profile = profile.data || {};
          state.catalog.flowers = flowers.data || [];
          state.catalog.bees = bees.data || [];
        }

        // Cập nhật uy tín trên Header
        if (state.profile.uyTin != null || state.profile.laNguoiMoi) {
          document.getElementById('headerReputationBadge').innerHTML = reputationBadge(state.profile.laNguoiMoi, state.profile.uyTin, state.profile.tongDanhGia);
        }

        // Cập nhật Avatar trên Header nếu có
        if (state.profile.avatar || state.profile.anhDaiDien) {
          const ava = state.profile.avatar || state.profile.anhDaiDien;
          document.getElementById('userTopAvatar').innerHTML = `<img src="${ava}" class="rounded-circle" width="34" height="34" style="object-fit:cover;">`;
        }

        // Cập nhật badge chuông thông báo
        const unreadNotif = state.data.summary?.unreadNotifications || 0;
        const notifBadge = document.getElementById('notifBadgeTop');
        if (notifBadge) {
          notifBadge.textContent = unreadNotif;
          notifBadge.classList.toggle('d-none', !unreadNotif);
        }

        renderNavBar();
        render();
        loadChatBadge();
      } catch (e) {
        toast(e.message, true);
      } finally {
        document.getElementById('loading').classList.add('d-none');
      }
    }

    async function loadChatBadge() {
      try {
        const res = await fetch('/api/chat/danh-sach');
        const json = await res.json();
        if (json.success && Array.isArray(json.data)) {
          let count = 0;
          json.data.forEach(c => count += Number(c.soTinChuaDoc || 0));
          state.chat.unreadCount = count;
          const badge = document.getElementById('chatBadgeTop');
          if (badge) {
            badge.textContent = count;
            badge.classList.toggle('d-none', !count);
          }
          renderNavBar();
        }
      } catch (_) {}
    }

    // ================= DANH MỤC ĐIỀU HƯỚNG SIDEBAR CHUẨN ADMIN =================
    const MENU_SECTIONS_LANDOWNER = [
      {
        header: 'Tổng Quan',
        items: [
          { key: 'overview', icon: 'fa-chart-pie', label: 'Dashboard Thống Kê' }
        ]

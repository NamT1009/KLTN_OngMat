    const maps = {};
    function drawMap(id, points, opts = {}) {
      const el = document.getElementById(id);
      if (!el) return null;
      if (maps[id]) { maps[id].remove(); delete maps[id]; }
      const map = L.map(el).setView([16.05, 108.2], 5);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(map);

      const valid = points.filter((p) => p.lat && p.lng);
      valid.forEach((p) => {
        const marker = L.circleMarker([p.lat, p.lng], {
          radius: p.radius || 10,
          color: p.color || '#f59e0b',
          fillColor: p.color || '#f59e0b',
          fillOpacity: 0.85,
          weight: 2
        }).addTo(map).bindPopup(p.popup);
        if (p.onClick) marker.on('click', p.onClick);
      });

      if (valid.length === 1) map.setView([valid[0].lat, valid[0].lng], 12);
      if (valid.length > 1) map.fitBounds(valid.map((p) => [p.lat, p.lng]), { padding: [35, 35], maxZoom: 13 });
      if (opts.onClick) map.on('click', (e) => opts.onClick(e.latlng));
      maps[id] = map;
      setTimeout(() => map.invalidateSize(), 80);
      return map;
    }


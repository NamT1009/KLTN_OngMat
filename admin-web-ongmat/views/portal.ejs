    function findClosestRegion(lat, lng) {
      let nearest = null;
      let minDist = Infinity;
      for (const reg of VN_REGIONS) {
        const dLat = (reg.lat - lat) * 111;
        const dLng = (reg.lng - lng) * 111 * Math.cos(lat * Math.PI / 180);
        const dist = Math.sqrt(dLat * dLat + dLng * dLng);
        if (dist < minDist) {
          minDist = dist;
          nearest = reg;
        }
      }
      return { region: nearest, distance: minDist };
    }

    // ================= NHẬN DIỆN SINH THÁI KHU VỰC (HOA, ONG, KHÍ HẬU) =================
    function detectEcology(lat, lng, addressText = '') {
      const raw = (addressText || '').toLowerCase();
      const norm = raw.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

      if (raw.trim()) {
        for (const reg of VN_REGIONS) {
          const match = reg.keys.some(k => raw.includes(k) || norm.includes(k.normalize('NFD').replace(/[\u0300-\u036f]/g, '')));
          if (match) {
            return { khiHau: reg.khiHau, loaiHoa: reg.hoa, loaiOng: reg.ong, regionName: reg.name };
          }
        }
      }

      if (lat != null && !isNaN(lat) && lng != null && !isNaN(lng)) {
        const closest = findClosestRegion(lat, lng);
        if (closest.region && closest.distance <= 150) {
          return { khiHau: closest.region.khiHau, loaiHoa: closest.region.hoa, loaiOng: closest.region.ong, regionName: closest.region.name };
        }
      }

      let khiHau = 'Nhiệt đới gió mùa';
      let loaiHoa = 'Hoa rừng tự nhiên, Hoa nhãn';
      let loaiOng = 'Ong nội (Apis cerana)';
      if (lat != null && !isNaN(lat)) {
        if (lat >= 21.0) {
          khiHau = 'Cận nhiệt đới / Ôn hòa 4 mùa';
          loaiHoa = 'Hoa nhãn, Hoa vải, Hoa mận, Hoa rừng tự nhiên';
          loaiOng = 'Ong nội & Ong Ý';
        } else if (lat >= 16.0 && lat < 21.0) {
          khiHau = 'Nhiệt đới gió mùa miền Trung';
          loaiHoa = 'Hoa keo tràm, Hoa rừng tự nhiên';
          loaiOng = 'Ong nội & Ong ngoại / Ong Ý';
        } else if (lat >= 11.5 && lat < 16.0) {
          khiHau = 'Cao nguyên ôn hòa đất đỏ bazan';
          loaiHoa = 'Hoa cà phê, Hoa cao su, Hoa điều';
          loaiOng = 'Ong Ý (Apis mellifera)';
        } else {
          khiHau = 'Nhiệt đới ẩm Nam Bộ nắng ấm';
          loaiHoa = 'Hoa tràm, Hoa dừa, Cây ăn trái';
          loaiOng = 'Ong Ý & Ong dú';
        }
      }

      return { khiHau, loaiHoa, loaiOng, regionName: 'Việt Nam' };
    }

    
    function generateAddressCandidates(input) {
      const list = [];
      const clean = (input || '').trim();
      if (!clean) return list;
      const stripped = clean
        .replace(/^[0-9]+[A-Za-z]?(\/[0-9]+[A-Za-z]?)*\s*,?\s*/i, '')
        .replace(/^(số|số nhà|nhà số|hẻm|ngõ|ngách|thửa|lô)\s+[0-9A-Za-z\/\.\-]+\s*,?\s*/i, '')
        .trim();
      if (stripped && stripped !== clean) list.push(stripped);
      const parts = clean.split(',').map(p => p.trim()).filter(Boolean);
      if (parts.length >= 3) {
        const withoutFirst = parts.slice(1).join(', ');
        if (!list.includes(withoutFirst)) list.push(withoutFirst);
        if (parts.length >= 4) {
          const pStreet = parts[0].replace(/^[0-9]+[A-Za-z]?(\/[0-9]+[A-Za-z]?)*\s*/i, '').trim();
          const streetDistCity = [pStreet, parts[parts.length - 2], parts[parts.length - 1]].join(', ');
          if (!list.includes(streetDistCity)) list.push(streetDistCity);
          const communeDistCity = parts.slice(parts.length - 3).join(', ');
          if (!list.includes(communeDistCity)) list.push(communeDistCity);
        }
        const distCity = parts.slice(parts.length - 2).join(', ');
        if (!list.includes(distCity)) list.push(distCity);
      }
      if (!list.includes(clean)) list.push(clean);
      return list;
    }

    async function findLocationCascade(address) {
      const candidates = generateAddressCandidates(address);
      for (const c of candidates) {
        try {
          const url = 'https://photon.komoot.io/api/?q=' + encodeURIComponent(c) + '&limit=3';
          const res = await fetch(url, { signal: AbortSignal.timeout(2800) });
          if (res.ok) {
            const d = await res.json();
            if (d && d.features && d.features.length) {
              for (const f of d.features) {
                const [lon, lat] = f.geometry.coordinates;
                if (lat > 8.0 && lat < 24.0 && lon > 102.0 && lon < 110.0) {
                  return { lat, lng: lon, matched: c };
                }
              }
            }
          }
        } catch (e) {}
      }
      return null;
    }


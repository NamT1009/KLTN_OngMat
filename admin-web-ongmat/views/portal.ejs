      const defaultFlowers = ['Hoa Nhãn', 'Hoa Vải', 'Hoa Cà Phê', 'Hoa Bạc Hà', 'Hoa Keo', 'Hoa Tràm', 'Hoa Mận', 'Hoa Điều'];
      const defaultBees = ['Ong nội (Apis cerana)', 'Ong ngoại / Ong Ý (Apis mellifera)', 'Ong dú (Stingless bee)'];

      openForm(id ? 'Sửa thông tin địa điểm vườn' : 'Đăng địa điểm vườn đặt ong', [
        { name: 'tenDiaDiem', label: 'Tên địa điểm / Tên vườn', required: true, value: l.tenDiaDiem, placeholder: 'VD: Vườn Nhãn Lồng Hưng Yên 5ha' },
        { name: 'diaChiChiTiet', label: 'Địa chỉ chi tiết vườn', required: true, value: l.diaChiChiTiet, placeholder: 'Xã, Huyện, Tỉnh...' },
        { name: 'dienTich', label: 'Diện tích (ha)', type: 'number', step: 'any', min: 0.01, required: true, value: l.dienTich },
        { name: 'sucChuaToiDa', label: 'Sức chứa tối đa (thùng ong)', type: 'number', min: 1, required: true, value: l.sucChuaToiDa ?? 50 },
        { name: 'giaThueThang', label: 'Giá thuê đề xuất (đồng/tháng)', type: 'number', min: 0, value: l.giaThueThang ?? 1000000 },
        { name: 'loaiHoa', label: 'Loài hoa đặc trưng (Tự động nhận diện khi chọn tọa độ, có thể tự sửa)', value: l.loaiHoa, list: flowers.length ? flowers : defaultFlowers, chips: flowers.length ? flowers.slice(0, 8) : defaultFlowers },
        { name: 'loaiOngPhuHop', label: 'Giống ong phù hợp (Tự động theo tọa độ, có thể tự sửa)', value: l.loaiOngPhuHop, list: bees.length ? bees : defaultBees, chips: bees.length ? bees : defaultBees },
        { name: 'khiHau', label: 'Khí hậu khu vực (Tự động tính từ GPS/địa chỉ)', placeholder: 'Tự động tính từ tọa độ GPS...', value: l.khiHau },
        { name: 'hinhAnh', label: 'Hình ảnh thực tế của vườn', type: 'image', value: l.hinhAnh },
        { type: 'latlng', label: 'Tọa độ GPS vị trí vườn (Ghim trực tiếp trên bản đồ để tự động nhận diện)', required: true, value: l.viDo ? { lat: l.viDo, lng: l.kinhDo } : null },
        { name: 'thongTinPhapLy', label: 'Thông tin pháp lý & quy định của vườn', type: 'textarea', col: 12, value: l.thongTinPhapLy, placeholder: 'Đất vườn nông nghiệp gia đình, có nguồn nước sạch, quy định phun thuốc BVTV...' }
      ], (v) => {
        const body = {
          ...v,
          dienTich: Number(v.dienTich),
          sucChuaToiDa: Number(v.sucChuaToiDa),

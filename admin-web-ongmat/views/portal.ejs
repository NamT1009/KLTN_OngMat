                  </button>
                </div>
              </div>
              <div id="ecoAlertBox" class="alert alert-warning py-2 px-3 small mb-2 d-none rounded-3 border-0 shadow-sm" style="background:#fef3c7; color:#92400e;">
                <i class="fas fa-wand-magic-sparkles text-amber me-1"></i>
                <span id="ecoAlertText"></span>
              </div>
              <div id="pickMap" class="map-sm"></div>
              <div class="form-text small mt-1"><i class="fas fa-info-circle text-primary me-1"></i> Bấm trực tiếp lên bản đồ để chọn vị trí. Hệ thống sẽ <b>tự động nhận diện loài hoa và loài ong</b> phù hợp nhất, bạn vẫn có thể <b>chỉnh sửa tùy ý</b>.</div>
            </div>
          `;
        }

        let chipsHtml = '';
        if (f.chips && Array.isArray(f.chips) && f.chips.length) {
          chipsHtml = `
            <div class="d-flex flex-wrap gap-1 mt-1">
              ${f.chips.map(c => `
                <span role="button" class="badge rounded-pill bg-light text-dark border px-2 py-1 form-chip" data-input="${f.name}" data-val="${esc(c)}" style="font-size: 0.73rem; cursor: pointer;">
                  <i class="fas fa-tag text-warning me-1"></i>${esc(c)}
                </span>
              `).join('')}
            </div>
          `;
        }

        return `
          <div class="${col}">
            ${label}
            <input class="form-control" type="${f.type || 'text'}" name="${f.name}" value="${esc(f.value ?? '')}" ${req}
              placeholder="${esc(f.placeholder || '')}" ${f.min != null ? `min="${f.min}"` : ''} ${f.step ? `step="${f.step}"` : ''} ${f.list ? `list="dl-${f.name}"` : ''}>
            ${f.list ? `<datalist id="dl-${f.name}">${f.list.map((v) => `<option value="${esc(v)}">`).join('')}</datalist>` : ''}
            ${chipsHtml}
          </div>
        `;
      }).join('');

      activeModalSubmit = onSubmit;
      formModal.show();

      const imgInput = document.getElementById('formImgInput');
      if (imgInput) {
        imgInput.onchange = (e) => {
          const file = e.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (re) => {
            document.getElementById('formImgPreview').src = re.target.result;
            document.getElementById('formImgVal').value = re.target.result;
          };
          reader.readAsDataURL(file);
        };
      }

      // Hỗ trợ bấm chip để điền giá trị nhanh
      const modalBody = document.getElementById('modalBody');
      modalBody.onclick = (e) => {
        const chip = e.target.closest('.form-chip');
        if (chip) {
          const inputName = chip.dataset.input;
          const inputVal = chip.dataset.val;
          const inputEl = document.querySelector(`#modalForm [name="${inputName}"]`);
          if (inputEl) {
            inputEl.value = inputVal;
            inputEl.focus();
            toast(`Đã chọn: ${inputVal}`);
          }
        }
      };

      const picker = fields.find((f) => f.type === 'latlng');
      if (picker) {
        document.getElementById('formModal').addEventListener('shown.bs.modal', () => {
          const form = document.getElementById('modalForm');
          let marker = null;

          const applyEcology = (lat, lng, showToast = false) => {
            const flowerInput = form.querySelector('[name=loaiHoa]');
            const beeInput = form.querySelector('[name=loaiOngPhuHop]');
            const climateInput = form.querySelector('[name=khiHau]');
            const addrInput = form.querySelector('[name=diaChiChiTiet]');
            if (!flowerInput && !beeInput && !climateInput) return;

            const addr = addrInput ? addrInput.value : '';
            const eco = detectEcology(lat, lng, addr);
            if (flowerInput) flowerInput.value = eco.loaiHoa;
            if (beeInput) beeInput.value = eco.loaiOng;
            if (climateInput) climateInput.value = eco.khiHau;

            const alertBox = document.getElementById('ecoAlertBox');
            const alertText = document.getElementById('ecoAlertText');
            if (alertBox && alertText) {
              alertText.innerHTML = `<strong>⚡ Nhận diện theo vị trí:</strong> Hoa phù hợp: <b>${esc(eco.loaiHoa)}</b> • Giống ong: <b>${esc(eco.loaiOng)}</b> • Khí hậu: <i>${esc(eco.khiHau)}</i>. <span class="d-block small text-muted mt-1">Bạn có thể tự do chỉnh sửa hoặc chọn gợi ý bên dưới nếu cần.</span>`;
              alertBox.classList.remove('d-none');
            }
            if (showToast) {
              toast('⚡ Đã tự động nhận diện loài hoa & giống ong theo tọa độ! Bạn có thể chỉnh sửa tùy ý.');
            }
          };

          const set = (lat, lng, triggerEco = true) => {
            const latInput = form.querySelector('[name=viDo]');
            const lngInput = form.querySelector('[name=kinhDo]');
            if (latInput) latInput.value = Number(lat).toFixed(6);
            if (lngInput) lngInput.value = Number(lng).toFixed(6);
            if (marker) marker.setLatLng([lat, lng]);
            else marker = L.marker([lat, lng]).addTo(map);

            if (triggerEco) {
              applyEcology(lat, lng, true);
            }
          };

          const start = picker.value?.lat ? [Number(picker.value.lat), Number(picker.value.lng)] : null;
          const map = drawMap('pickMap', [], { onClick: (ll) => set(ll.lat, ll.lng, true) });
          if (start) {
            map.setView(start, 13);
            set(start[0], start[1], false);
          }

          const gpsBtn = document.getElementById('gpsBtn');
          if (gpsBtn) {
            gpsBtn.onclick = () => navigator.geolocation
              ? navigator.geolocation.getCurrentPosition((p) => {
                set(p.coords.latitude, p.coords.longitude, true);
                map.setView([p.coords.latitude, p.coords.longitude], 15);
              }, (e) => toast('Không lấy được GPS: ' + e.message, true), { enableHighAccuracy: true, timeout: 12000 })
              : toast('Trình duyệt không hỗ trợ GPS.', true);
          }

          const detectBtn = document.getElementById('detectEcoBtn');
          if (detectBtn) {
            detectBtn.onclick = () => {
              const lat = parseFloat(form.querySelector('[name=viDo]')?.value);
              const lng = parseFloat(form.querySelector('[name=kinhDo]')?.value);
              applyEcology(isNaN(lat) ? null : lat, isNaN(lng) ? null : lng, true);
            };
          }

          const addrInput = form.querySelector('[name=diaChiChiTiet]');
          if (addrInput) {
            addrInput.addEventListener('change', async () => {
              const val = addrInput.value.trim();
              if (val) {
                const res = await findLocationCascade(val);
                if (res && res.lat && res.lng) {
                  set(res.lat, res.lng, true);
                  map.setView([res.lat, res.lng], 14);
                } else {
                  const lat = parseFloat(form.querySelector('[name=viDo]')?.value);
                  const lng = parseFloat(form.querySelector('[name=kinhDo]')?.value);
                  applyEcology(isNaN(lat) ? null : lat, isNaN(lng) ? null : lng, false);
                }
              }
            });
          }
        }, { once: true });
      }
    }

    document.getElementById('modalForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const values = Object.fromEntries(new FormData(form).entries());
      const btn = document.getElementById('modalSubmit');
      btn.disabled = true;
      try {
        const res = await activeModalSubmit(values);
        formModal.hide();
        toast(res?.message || 'Đã lưu thay đổi.');
        await load();
      } catch (err) {
        document.getElementById('modalError').textContent = err.message;
      } finally {
        btn.disabled = false;
      }
    });

    // ================= GIAO DIỆN CHUNG =================
    const statCard = (label, value, icon, colorCls, tab) => `
      <div class="col-6 col-lg-3">
        <div class="stat-card" ${tab ? `data-tab="${tab}" title="Bấm để xem chi tiết"` : ''}>
          <div class="stat-card-top">
            <span class="stat-title">${esc(label)}</span>
            <div class="stat-icon-box ${colorCls}"><i class="fas ${icon}"></i></div>
          </div>
          <div class="stat-number">${value}</div>
          <div class="small text-muted d-flex align-items-center gap-1" style="font-size:0.75rem;">
            <i class="fas fa-arrow-trend-up text-success"></i> Cập nhật thời gian thực
          </div>
        </div>
      </div>
    `;

    const section = (title, body, action = '') => `
      <div class="card-modern">
        <div class="card-header-modern">
          <h3 class="card-title-modern">${title}</h3>
          <div class="ms-auto">${action}</div>
        </div>
        ${body}
      </div>
    `;

    const table = (head, rows, empty) => `
      <div class="table-modern-wrap">
        <div class="table-responsive">
          <table class="table table-modern">
            <thead>
              <tr>${head.map((h) => `<th>${h}</th>`).join('')}</tr>
            </thead>
            <tbody>
              ${rows.length ? rows.join('') : `<tr><td colspan="${head.length}" class="text-center text-muted py-5"><i class="fas fa-folder-open fs-2 d-block mb-2 opacity-50"></i>${empty}</td></tr>`}
            </tbody>
          </table>
        </div>
      </div>
    `;

    // ================= RENDER TỪNG VIEW =================
    function render() {
      const views = IS_LANDOWNER ? LANDOWNER_VIEWS : BEEKEEPER_VIEWS;
      const renderFn = views[state.tab] || views.overview;
      document.getElementById('content').innerHTML = renderFn();
      if (AFTER_RENDER[state.tab]) AFTER_RENDER[state.tab]();
    }

    // ================= NOTIFICATIONS VIEW =================
    const notificationsView = () => section(
      '<i class="fas fa-bell text-warning me-2"></i> Thông báo hệ thống',
      `
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
          <span class="text-muted small">Thông báo cập nhật tự động từ hợp đồng, yêu cầu thuê vườn và tin nhắn mới.</span>
          <button class="btn btn-outline-warning btn-sm text-dark fw-bold rounded-pill px-3" onclick="markAllNotificationsRead()"><i class="fas fa-check-double text-warning me-1"></i> Đánh dấu đã đọc tất cả</button>
        </div>
        <div class="d-flex flex-column gap-2">
          ${(state.data.notifications || []).map((n) => `
            <div class="d-flex align-items-start gap-3 p-3 rounded-3 border ${n.daDoc ? 'bg-white opacity-75' : 'bg-warning-subtle border-warning shadow-sm'}">
              <div class="stat-icon-box ${n.mucDo === 'Cao' ? 'rose' : 'amber'} flex-shrink-0" style="width:42px;height:42px;border-radius:12px;">
                <i class="fas ${n.mucDo === 'Cao' ? 'fa-triangle-exclamation' : 'fa-bell'}"></i>
              </div>
              <div class="flex-grow-1">
                <div class="d-flex align-items-center justify-content-between">
                  <h6 class="fw-bold mb-1 text-dark">${esc(n.tieuDe)}</h6>
                  <span class="text-muted small" style="font-size:0.75rem;"><i class="far fa-clock me-1"></i>${esc(n.thoiGian)}</span>
                </div>
                <div class="small text-secondary">${esc(n.noiDung)}</div>
              </div>
            </div>
          `).join('') || '<div class="text-center text-muted py-5"><i class="fas fa-bell-slash fs-2 d-block mb-2 opacity-50"></i>Bạn chưa có thông báo nào.</div>'}
        </div>
      `
    );

    // ================= PROFILE & REPUTATION VIEW =================
    function profileView() {
      const p = state.profile || {};
      const ava = p.avatar || p.anhDaiDien || '';
      const reviews = p.danhSachDanhGia || [];
      const rating = Number(p.uyTin || 0);
      const count = Number(p.tongDanhGia || 0);
      const isNew = p.laNguoiMoi === 1 || p.laNguoiMoi === true || count === 0;

      return `
        <div class="row g-4">
          <!-- Cột thông tin cá nhân & Điểm uy tín -->
          <div class="col-lg-4">
            <div class="card-modern text-center p-4">
              <div class="position-relative d-inline-block mx-auto mb-3">
                ${ava ? `<img src="${ava}" class="rounded-circle border border-3 border-warning shadow-sm" width="115" height="115" style="object-fit:cover;">` : `<div class="rounded-circle bg-warning text-white fw-bold d-inline-flex align-items-center justify-content-center border border-3 border-warning shadow-sm" style="width:115px;height:115px;font-size:2.8rem;">${(p.hoTen || 'U').charAt(0).toUpperCase()}</div>`}
                <label for="profileAvatarFile" class="btn btn-dark btn-sm rounded-circle position-absolute bottom-0 end-0 shadow" style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;cursor:pointer;" title="Bấm để đổi ảnh đại diện">
                  <i class="fas fa-camera"></i>
                </label>
                <input type="file" id="profileAvatarFile" accept="image/*" class="d-none" onchange="uploadProfileAvatar(this)">
              </div>
              <h4 class="fw-bold text-dark mb-1">${esc(p.hoTen || CURRENT_USER.hoTen)}</h4>
              <div class="text-muted small mb-2"><i class="fas fa-envelope me-1"></i>${esc(p.email || CURRENT_USER.email || 'Chưa cập nhật email')}</div>
              <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                <span class="brand-role-pill ${IS_LANDOWNER ? 'chudat' : 'nuoiong'} px-3 py-1">
                  <i class="fas ${IS_LANDOWNER ? 'fa-mountain-sun' : 'fa-certificate'}"></i>
                  ${IS_LANDOWNER ? 'Chủ Đất & Vườn' : 'Người Nuôi Ong'}
                </span>
                <span class="badge rounded-pill bg-success-subtle text-success border border-success px-2 py-1 small">
                  <i class="fas fa-check-circle me-1"></i> Hoạt động
                </span>
              </div>

              <!-- Thẻ điểm uy tín đối tác -->
              <div class="p-3 rounded-3 bg-light border text-start mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="fw-bold small text-dark"><i class="fas fa-star text-warning me-1"></i> Điểm uy tín đối tác:</span>
                  ${reputationBadge(isNew, rating, count)}
                </div>
                ${!isNew ? `
                  <div class="d-flex align-items-baseline gap-2 mb-2">
                    <span class="fs-2 fw-800 text-warning">${rating.toFixed(1)}</span>
                    <span class="text-muted small">/ 5.0 sao (${count} đánh giá thực tế)</span>
                  </div>
                  <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-warning" style="width: ${(rating / 5) * 100}%"></div>
                  </div>
                ` : `
                  <div class="small text-muted">Tài khoản mới tham gia hệ thống. Điểm sao sẽ tự động tăng dần khi bạn hoàn tất các hợp đồng thuê vườn.</div>
                `}
              </div>

              <div class="text-muted text-start small border-top pt-3">
                <div class="mb-1"><i class="fas fa-phone text-secondary me-2"></i><b>Số điện thoại:</b> ${esc(p.soDienThoai || CURRENT_USER.soDienThoai || 'Chưa có')}</div>
                <div><i class="fas fa-calendar-check text-secondary me-2"></i><b>Ngày tham gia:</b> ${esc(p.ngayTao || '2026')}</div>
              </div>
            </div>
          </div>

          <!-- Cột Form Chỉnh Sửa & Đổi Mật Khẩu -->
          <div class="col-lg-8">
            <!-- Form thông tin cá nhân -->
            <div class="card-modern mb-4">
              <h5 class="fw-bold text-dark mb-3"><i class="fas fa-user-pen text-warning me-2"></i> Cập nhật thông tin cá nhân</h5>
              <form id="profileEditForm" onsubmit="handleUpdateProfile(event)">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label small fw-bold">Họ và tên *</label>
                    <input class="form-control" name="hoTen" value="${esc(p.hoTen || CURRENT_USER.hoTen)}" required>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small fw-bold">Số điện thoại *</label>
                    <input class="form-control" name="soDienThoai" value="${esc(p.soDienThoai || CURRENT_USER.soDienThoai)}" required>
                  </div>
                  <div class="col-md-12">
                    <label class="form-label small fw-bold">Địa chỉ Email</label>
                    <input class="form-control" type="email" name="email" value="${esc(p.email || CURRENT_USER.email)}" placeholder="vidu@gmail.com">
                  </div>
                </div>
                <div class="mt-3 text-end">
                  <button type="submit" class="btn btn-warning fw-bold px-4 rounded-pill shadow-sm" style="background:var(--honey-gradient); border:none; color:#fff;">
                    <i class="fas fa-floppy-disk me-1"></i> Lưu thông tin
                  </button>
                </div>
              </form>
            </div>

            <!-- Form đổi mật khẩu -->
            <div class="card-modern mb-4">
              <h5 class="fw-bold text-dark mb-3"><i class="fas fa-key text-warning me-2"></i> Đổi mật khẩu tài khoản</h5>
              <form id="passwordEditForm" onsubmit="handleChangePassword(event)">
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label small fw-bold">Mật khẩu hiện tại *</label>
                    <div class="input-group">
                      <input class="form-control" type="password" name="matKhauCu" id="pwdOld" required>
                      <button class="btn btn-outline-secondary" type="button" onclick="togglePwdVisibility('pwdOld')"><i class="fas fa-eye"></i></button>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label small fw-bold">Mật khẩu mới (ít nhất 6 ký tự) *</label>
                    <div class="input-group">
                      <input class="form-control" type="password" name="matKhauMoi" id="pwdNew" minlength="6" required>
                      <button class="btn btn-outline-secondary" type="button" onclick="togglePwdVisibility('pwdNew')"><i class="fas fa-eye"></i></button>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label small fw-bold">Xác nhận mật khẩu mới *</label>
                    <div class="input-group">
                      <input class="form-control" type="password" id="pwdConfirm" minlength="6" required>
                      <button class="btn btn-outline-secondary" type="button" onclick="togglePwdVisibility('pwdConfirm')"><i class="fas fa-eye"></i></button>
                    </div>
                  </div>
                </div>
                <div class="mt-3 text-end">
                  <button type="submit" class="btn btn-outline-dark fw-bold px-4 rounded-pill">
                    <i class="fas fa-shield-alt me-1"></i> Cập nhật mật khẩu
                  </button>
                </div>
              </form>
            </div>

            <!-- Nhận xét từ đối tác đã thuê -->
            <div class="card-modern">
              <h5 class="fw-bold text-dark mb-3"><i class="fas fa-comments text-warning me-2"></i> Đánh giá từ đối tác gần đây</h5>
              ${reviews.length ? reviews.map(r => `
                <div class="p-3 rounded-3 border bg-light mb-2">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="d-flex align-items-center gap-2">
                      <span class="fw-bold text-dark small">${esc(r.nguoiDanhGia || 'Đối tác')}</span>
                      <span class="badge text-bg-warning"><i class="fas fa-star"></i> ${r.soSao}/5</span>
                    </div>
                    <span class="text-muted small" style="font-size:0.75rem;">${esc(r.ngayTao)}</span>
                  </div>
                  <div class="small text-secondary fst-italic">“${esc(r.nhanXet || 'Không có nhận xét thêm.')}”</div>
                </div>
              `).join('') : '<div class="text-muted small text-center py-4">Chưa có đánh giá nào từ các đợt thuê trước.</div>'}
            </div>
          </div>
        </div>
      `;
    }

    async function handleUpdateProfile(e) {
      e.preventDefault();
      const form = e.target;
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        await api('PUT', '/profile', data);
        toast('Cập nhật thông tin thành công!');
        await load();
      } catch (err) {
        toast(err.message, true);
      }
    }

    async function handleChangePassword(e) {
      e.preventDefault();
      const oldP = document.getElementById('pwdOld').value.trim();
      const newP = document.getElementById('pwdNew').value.trim();
      const confP = document.getElementById('pwdConfirm').value.trim();

      if (newP !== confP) return toast('Mật khẩu xác nhận không khớp!', true);
      try {
        await api('PUT', '/profile', { matKhauCu: oldP, matKhauMoi: newP });
        toast('Đổi mật khẩu thành công!');
        document.getElementById('passwordEditForm').reset();
      } catch (err) {
        toast(err.message, true);
      }
    }

    async function uploadProfileAvatar(input) {
      const file = input.files[0];
      if (!file) return;
      const fd = new FormData();
      fd.append('avatar', file);
      try {
        toast('Đang tải lên ảnh đại diện...');
        const res = await api('POST', '/profile/avatar', fd);
        toast(res.message || 'Cập nhật ảnh đại diện thành công!');
        await load();
      } catch (err) {
        toast(err.message, true);
      }
    }

    function togglePwdVisibility(id) {
      const el = document.getElementById(id);
      if (el) el.type = el.type === 'password' ? 'text' : 'password';
    }

    // ================= TRUNG TÂM CHAT HUB =================
    function chatView() {
      return `
        <div class="chat-layout">
          <!-- Danh sách hội thoại bên trái -->
          <div class="chat-sidebar-pane">
            <div class="p-3 border-bottom bg-white">
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-search"></i></span>
                <input class="form-control bg-light border-start-0" id="chatSearchInput" placeholder="Tìm kiếm đối tác..." oninput="handleChatSearch(this.value)">
              </div>
            </div>
            <div class="overflow-y-auto flex-grow-1" id="chatConversationsList">
              <div class="text-center text-muted py-5 small"><div class="spinner-border spinner-border-sm text-warning"></div> Đang tải danh sách...</div>
            </div>
          </div>

          <!-- Khung chat bên phải -->
          <div class="chat-main-pane" id="chatMainPane">
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4 text-muted">
              <div class="stat-icon-box amber mb-3" style="width:70px;height:70px;font-size:2rem;border-radius:20px;">
                <i class="fas fa-comments"></i>
              </div>
              <h4 class="fw-bold text-dark">Trung tâm trò chuyện trực tiếp</h4>
              <p class="small text-secondary max-w-sm" style="max-width:400px;">Chọn một cuộc trò chuyện từ danh sách bên trái để thương lượng hợp đồng thuê đất, trao đổi nguồn hoa và gửi ảnh thực tế của vườn.</p>
            </div>
          </div>
        </div>
      `;
    }

    async function loadChatConversations() {
      try {
        const res = await fetch('/api/chat/danh-sach');
        const json = await res.json();
        if (json.success && Array.isArray(json.data)) {
          state.chat.conversations = json.data;
          renderChatConversationsList(json.data);
        }
      } catch (_) {}
    }

    function renderChatConversationsList(list) {
      const el = document.getElementById('chatConversationsList');
      if (!el) return;
      if (!list.length) {
        el.innerHTML = '<div class="text-center text-muted py-5 small">Chưa có cuộc trò chuyện nào.</div>';
        return;
      }

      el.innerHTML = list.map((c) => {
        const active = state.chat.activePartnerId === c.maDoiTac ? 'active' : '';
        const unread = Number(c.soTinChuaDoc || 0);
        return `
          <div class="chat-list-item ${active}" onclick="openChatWith(${c.maDoiTac}, '${esc(c.tenDoiTac)}', '${esc(c.vaiTro || '')}', '${esc(c.soDienThoai || '')}', '${esc(c.anhDaiDien || '')}')">
            <div class="position-relative flex-shrink-0">
              ${c.anhDaiDien ? `<img src="${c.anhDaiDien}" class="rounded-circle" width="46" height="46" style="object-fit:cover;">` : `<div class="rounded-circle bg-warning text-white fw-bold d-inline-flex align-items-center justify-content-center" style="width:46px;height:46px;font-size:1.1rem;">${(c.tenDoiTac || 'U').charAt(0).toUpperCase()}</div>`}
              <div class="position-absolute bottom-0 end-0 rounded-circle border border-white ${c.isOnline ? 'bg-success' : 'bg-secondary'}" style="width:12px;height:12px;"></div>
            </div>
            <div class="flex-grow-1 min-w-0">
              <div class="d-flex align-items-center justify-content-between">
                <span class="fw-bold small text-dark text-truncate">${esc(c.tenDoiTac)}</span>
                ${unread > 0 ? `<span class="badge rounded-pill bg-danger" style="font-size:0.68rem;">${unread}</span>` : ''}
              </div>
              <div class="small text-muted text-truncate" style="font-size:0.78rem;">${esc(c.tinNhanCuoi || 'Bắt đầu trò chuyện...')}</div>
            </div>
          </div>
        `;
      }).join('');
    }

    async function handleChatSearch(q) {
      const query = (q || '').trim();
      if (!query) {
        renderChatConversationsList(state.chat.conversations);
        return;
      }
      try {
        const res = await fetch(`/api/chat/tim-kiem-nguoi-dung?q=${encodeURIComponent(query)}`);
        const json = await res.json();
        if (json.success) {
          const mapped = (json.data || []).map(u => ({
            maDoiTac: u.maNguoiDung,
            tenDoiTac: u.hoTen,
            vaiTro: u.vaiTro,
            soDienThoai: u.soDienThoai,
            anhDaiDien: u.anhDaiDien,
            tinNhanCuoi: 'Bắt đầu cuộc trò chuyện',
            soTinChuaDoc: 0,
            isOnline: u.isOnline
          }));
          renderChatConversationsList(mapped);
        }
      } catch (_) {}
    }

    async function openChatWith(partnerId, name, role, phone, avatar) {
      state.chat.activePartnerId = partnerId;
      state.chat.activePartner = { id: partnerId, name, role, phone, avatar };
      renderChatConversationsList(state.chat.conversations);

      const main = document.getElementById('chatMainPane');
      if (!main) return;

      main.innerHTML = `
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-white shadow-sm z-2">
          <div class="d-flex align-items-center gap-3">
            <div class="position-relative flex-shrink-0">
              ${avatar ? `<img src="${avatar}" class="rounded-circle" width="44" height="44" style="object-fit:cover;">` : `<div class="rounded-circle bg-warning text-white fw-bold d-inline-flex align-items-center justify-content-center" style="width:44px;height:44px;font-size:1.1rem;">${(name || 'U').charAt(0).toUpperCase()}</div>`}
              <div id="partnerOnlineDot" class="position-absolute bottom-0 end-0 rounded-circle border border-white bg-success" style="width:12px;height:12px;"></div>
            </div>
            <div>
              <div class="fw-bold text-dark leading-tight">${esc(name)}</div>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span class="badge text-bg-light border text-secondary" style="font-size:0.72rem;">${role === 'admin' ? 'Quản trị viên' : (role === 'chuDat' ? 'Chủ Đất' : 'Người Nuôi Ong')}</span>
                <span id="partnerOnlineStatus" class="small text-success" style="font-size:0.75rem;"><i class="fas fa-circle" style="font-size:7px;"></i> Đang hoạt động</span>
              </div>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2">
            ${phone ? `<a href="tel:${phone}" class="btn btn-sm btn-outline-success fw-bold rounded-pill px-3"><i class="fas fa-phone me-1"></i> Gọi ${phone}</a>` : ''}
          </div>
        </div>

        <div class="chat-msg-area" id="chatMsgArea">
          <div class="text-center text-muted py-5 small"><div class="spinner-border spinner-border-sm text-warning"></div> Đang tải tin nhắn...</div>
        </div>

        <div class="chat-input-bar">
          <label for="chatImgFile" class="btn btn-light rounded-circle text-muted" style="width:42px;height:42px;display:flex;align-items:center;justify-content:center;cursor:pointer;" title="Gửi ảnh">
            <i class="fas fa-image fs-5"></i>
          </label>
          <input type="file" id="chatImgFile" accept="image/*" class="d-none" onchange="sendChatImage(this)">
          <input type="text" class="form-control rounded-pill px-3 py-2" id="chatTextInput" placeholder="Nhập tin nhắn trò chuyện..." onkeydown="if(event.key==='Enter') sendChatMessage()">
          <button class="btn btn-warning rounded-circle fw-bold shadow-sm" style="width:42px;height:42px;display:flex;align-items:center;justify-content:center;background:var(--honey-gradient);border:none;color:#fff;" onclick="sendChatMessage()" title="Gửi">
            <i class="fas fa-paper-plane"></i>
          </button>
        </div>
      `;

      await fetchChatHistory();
    }

    async function fetchChatHistory() {
      if (!state.chat.activePartnerId) return;
      try {
        const res = await fetch(`/api/chat/lich-su?maNguoiNhan=${state.chat.activePartnerId}`);
        const json = await res.json();
        if (json.success) {
          state.chat.messages = json.data || [];
          renderChatMessages();

          const dot = document.getElementById('partnerOnlineDot');
          const txt = document.getElementById('partnerOnlineStatus');
          if (dot && txt) {
            dot.className = `position-absolute bottom-0 end-0 rounded-circle border border-white ${json.partnerOnline ? 'bg-success' : 'bg-secondary'}`;
            txt.className = `small ${json.partnerOnline ? 'text-success' : 'text-muted'}`;
            txt.innerHTML = json.partnerOnline ? '<i class="fas fa-circle" style="font-size:7px;"></i> Đang hoạt động' : '<i class="fas fa-circle" style="font-size:7px;"></i> Ngoại tuyến';
          }
        }
      } catch (_) {}
    }

    function renderChatMessages() {
      const area = document.getElementById('chatMsgArea');
      if (!area) return;
      const msgs = state.chat.messages || [];
      if (!msgs.length) {
        area.innerHTML = '<div class="text-center text-muted py-5 small">Chưa có tin nhắn nào. Hãy gửi lời chào đầu tiên!</div>';
        return;
      }

      area.innerHTML = msgs.map((m) => {
        const isMine = m.maNguoiGui === CURRENT_USER.id;
        const time = m.ngayGui ? new Date(m.ngayGui).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : '';
        const isRecall = m.daThuHoi === true || m.daThuHoi === 1;

        let contentHtml = '';
        if (isRecall) {
          contentHtml = '<span class="fst-italic opacity-75"><i class="fas fa-ban me-1"></i> Tin nhắn đã được thu hồi</span>';
        } else if (m.noiDung && (m.noiDung.startsWith('[HÌNH_ẢNH]:') || m.noiDung.startsWith('📷 [Ảnh]:') || m.noiDung.startsWith('/uploads/chat/'))) {
          const imgUrl = m.noiDung.replace(/^[^\:]+\:\s*/, '').trim();
          contentHtml = `<img src="${imgUrl}" class="rounded-3 shadow-sm img-fluid" style="max-height:220px; cursor:pointer;" onclick="viewImage('${imgUrl}')">`;
        } else {
          contentHtml = esc(m.noiDung);
        }

        return `
          <div class="chat-bubble ${isMine ? 'mine' : 'theirs'} position-relative">
            <div>${contentHtml}</div>
            <div class="chat-bubble-time d-flex align-items-center justify-content-end gap-1">
              <span>${time}</span>
              ${isMine && !isRecall ? `<button class="btn btn-link p-0 text-white opacity-75 ms-1" style="font-size:0.7rem;" onclick="recallMessage(${m.id || m.maTinNhan})" title="Thu hồi"><i class="fas fa-rotate-left"></i></button>` : ''}
            </div>
          </div>
        `;
      }).join('');

      area.scrollTop = area.scrollHeight;
    }

    async function sendChatMessage() {
      const input = document.getElementById('chatTextInput');
      const text = (input?.value || '').trim();
      if (!text || !state.chat.activePartnerId) return;
      input.value = '';

      try {
        const res = await fetch('/api/chat/gui', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ maNguoiNhan: state.chat.activePartnerId, noiDung: text })
        });
        const json = await res.json();
        if (json.success) {
          await fetchChatHistory();
          await loadChatConversations();
        } else {
          toast(json.message || 'Lỗi gửi tin', true);
        }
      } catch (err) {
        toast('Không thể gửi tin nhắn', true);
      }
    }

    async function sendChatImage(input) {
      const file = input.files[0];
      if (!file || !state.chat.activePartnerId) return;
      const fd = new FormData();
      fd.append('image', file);

      try {
        toast('Đang gửi hình ảnh...');
        const upRes = await fetch('/api/chat/upload-anh', { method: 'POST', body: fd });
        const upJson = await upRes.json();
        if (!upJson.success) throw new Error(upJson.message || 'Lỗi tải ảnh');

        const sendRes = await fetch('/api/chat/gui', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ maNguoiNhan: state.chat.activePartnerId, noiDung: `[HÌNH_ẢNH]: ${upJson.imageUrl}` })
        });
        const sendJson = await sendRes.json();
        if (sendJson.success) {
          await fetchChatHistory();
          await loadChatConversations();
        }
      } catch (err) {
        toast(err.message, true);
      }
    }

    async function recallMessage(id) {
      if (!id || !confirm('Thu hồi tin nhắn này?')) return;
      try {
        const res = await fetch(`/api/chat/thu-hoi/${id}`, { method: 'POST' });
        const json = await res.json();
        if (json.success) {
          toast('Đã thu hồi tin nhắn');
          await fetchChatHistory();
        } else {
          toast(json.message || 'Lỗi thu hồi', true);
        }
      } catch (_) {}
    }

    // ================= HỢP ĐỒNG, KÝ OTP & ĐÁNH GIÁ 2 CHIỀU =================
    function contractsView() {
      const rows = state.contracts.map((c) => {
        const myRating = IS_LANDOWNER ? c.saoChuDatDanhGia : c.saoNguoiNuoiOngDanhGia;
        const partnerRating = IS_LANDOWNER ? c.saoNguoiNuoiOngDanhGia : c.saoChuDatDanhGia;
        const canReview = c.trangThai === 'DaKy' || c.trangThai === 'HoanThanh';
        const partnerId = IS_LANDOWNER ? c.maNguoiNuoiOng : c.maChuDat;
        const partnerName = IS_LANDOWNER ? c.tenNguoiNuoiOng : c.tenChuDat;

        let reviewBadges = '';
        if (canReview) {
          reviewBadges = `
            <div class="mt-1 d-flex flex-wrap gap-1">
              ${myRating ? `<span class="badge text-bg-warning"><i class="fas fa-star"></i> Bạn: ${myRating}/5</span>` : '<span class="badge text-bg-light border text-muted">Chưa đánh giá</span>'}
              ${partnerRating ? `<span class="badge text-bg-info text-white"><i class="fas fa-star"></i> Đối tác: ${partnerRating}/5</span>` : ''}
            </div>
          `;
        }

        return `
          <tr>
            <td>
              <div class="fw-bold text-dark fs-6">${esc(c.tenHopDong)}</div>
              <div class="small text-muted font-monospace"><i class="fas fa-file-lines me-1"></i>${esc(c.maHopDong)}</div>
              ${reviewBadges}
            </td>
            <td>
              <div class="d-flex align-items-center flex-wrap">
                <b class="text-dark">${esc(partnerName)}</b>
                ${reputationBadge(IS_LANDOWNER ? c.laNguoiMoiNuoiOng : c.laNguoiMoiChuDat, IS_LANDOWNER ? c.uyTinNguoiNuoiOng : c.uyTinChuDat, IS_LANDOWNER ? c.tongDanhGiaNguoiNuoiOng : c.tongDanhGiaChuDat)}
              </div>
              <div class="small text-muted mt-1"><i class="fas fa-phone me-1"></i>${esc(IS_LANDOWNER ? c.sdtNguoiNuoiOng : c.sdtChuDat)}</div>
            </td>
            <td><b class="text-warning-emphasis fs-6">${money(c.giaThue)}</b></td>
            <td class="small text-secondary font-semibold">${esc(c.thoiHan)}</td>
            <td>
              ${chip(c.trangThai)}
              <div class="small text-muted mt-1" style="font-size:0.75rem;">${esc(c.ngayHoanThanh ? 'Hoàn tất: ' + c.ngayHoanThanh : (c.ngayKy ? 'Ký: ' + c.ngayKy : ''))}</div>
            </td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-secondary rounded-pill px-2" target="_blank" href="/api/hop-dong/pdf/${encodeURIComponent(c.maHopDong)}" title="Tải file PDF hợp đồng"><i class="fas fa-file-pdf text-danger me-1"></i> Tải PDF</a>
              ${partnerId ? `<button class="btn btn-sm btn-outline-primary rounded-pill px-3 ms-1" onclick="setTab('chat'); setTimeout(()=>openChatWith(${partnerId}, '${esc(partnerName)}', '${IS_LANDOWNER ? 'nguoiNuoiOng' : 'chuDat'}', '${esc(IS_LANDOWNER ? c.sdtNguoiNuoiOng : c.sdtChuDat)}'), 100)" title="Nhắn tin"><i class="fas fa-comment-dots me-1"></i> Nhắn tin</button>` : ''}
              ${!IS_LANDOWNER && c.trangThai === 'ChoKhachKy' ? `<button class="btn btn-sm btn-warning rounded-pill px-3 ms-1 fw-bold shadow-sm" onclick="signContract('${esc(c.maHopDong)}')"><i class="fas fa-pen-nib me-1"></i> Ký xác nhận OTP</button>` : ''}
              ${c.trangThai === 'DaKy' ? `<button class="btn btn-sm btn-success rounded-pill px-3 ms-1 fw-semibold" onclick="completeContract('${esc(c.maHopDong)}')"><i class="fas fa-circle-check me-1"></i> Hoàn tất đợt thuê</button>` : ''}
              ${canReview ? `<button class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 ms-1 fw-semibold" onclick="openReviewModal('${esc(c.maHopDong)}')"><i class="fas fa-star text-warning me-1"></i> ${myRating ? 'Sửa ĐG' : 'Đánh giá đối tác'}</button>` : ''}
            </td>
          </tr>
        `;
      });

      return section(
        '<i class="fas fa-handshake-simple text-warning me-2"></i> Danh sách hợp đồng thuê đất đặt ong',
        table(['Hợp đồng', IS_LANDOWNER ? 'Người nuôi ong' : 'Chủ đất', 'Giá thuê', 'Thời hạn', 'Trạng thái', 'Thao tác'], rows,
          IS_LANDOWNER ? 'Hợp đồng được tạo tự động khi bạn duyệt yêu cầu thuê vườn.' : 'Hợp đồng được tạo khi chủ đất duyệt yêu cầu thuê của bạn.')
      );

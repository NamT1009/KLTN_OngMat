    async function completeContract(id) {
      if (!confirm(`Xác nhận hoàn tất đợt thuê theo hợp đồng ${id}? Bạn và đối tác có thể gửi đánh giá 2 chiều cho nhau.`)) return;
      try {
        const res = await api('PUT', `/contracts/${encodeURIComponent(id)}/complete`);
        toast(res.message || 'Đã hoàn tất hợp đồng.');
        await load();
        openReviewModal(id);
      } catch (e) {
        toast(e.message, true);
      }
    }

    async function openReviewModal(id) {
      try {
        const reviewsRes = await api('GET', `/contracts/${encodeURIComponent(id)}/reviews`);
        const reviews = reviewsRes.data || [];
        const myRole = IS_LANDOWNER ? 'chuDat' : 'nguoiNuoiOng';
        const partnerRole = IS_LANDOWNER ? 'nguoiNuoiOng' : 'chuDat';
        const myReview = reviews.find((r) => r.vaiTroDanhGia === myRole) || {};
        const partnerReview = reviews.find((r) => r.vaiTroDanhGia === partnerRole);

        const c = state.contracts.find((item) => item.maHopDong === id) || {};
        const partnerName = IS_LANDOWNER ? (c.tenNguoiNuoiOng || 'Người nuôi ong') : (c.tenChuDat || 'Chủ đất');

        let partnerAlert = '';
        if (partnerReview) {
          partnerAlert = `
            <div class="col-12">
              <div class="alert alert-info py-2 mb-2">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="fw-bold"><i class="fas fa-comment-dots me-1"></i> Đánh giá từ ${esc(partnerName)}:</span>
                  <span class="badge text-bg-warning">${partnerReview.soSao}/5 ⭐</span>
                </div>
                ${partnerReview.nhanXet ? `<div class="fst-italic small">“${esc(partnerReview.nhanXet)}”</div>` : '<div class="small text-muted">Không có nhận xét thêm.</div>'}
                <div class="small text-muted mt-1" style="font-size:0.75rem;">${esc(partnerReview.ngayTao)}</div>
              </div>
            </div>
          `;
        }

        const fields = [
          {
            name: 'soSao', label: 'Mức độ hài lòng tổng thể (1 - 5 sao)', type: 'select', required: true, col: 12, value: myReview.soSao || 5, options: [
              { value: 5, label: '⭐⭐⭐⭐⭐ 5/5 - Rất hài lòng & Tuyệt vời' },
              { value: 4, label: '⭐⭐⭐⭐ 4/5 - Hài lòng & Tốt' },
              { value: 3, label: '⭐⭐⭐ 3/5 - Bình thường / Tạm ổn' },
              { value: 2, label: '⭐⭐ 2/5 - Chưa hài lòng' },
              { value: 1, label: '⭐ 1/5 - Kém / Không khuyến khích' }
            ]
          },
          {
            name: 'tieuChi1', label: IS_LANDOWNER ? 'Ý thức giữ gìn vườn & bảo vệ cây cối' : 'Nguồn hoa, môi trường & độ an toàn vườn', type: 'select', required: true, col: 6, value: myReview.tieuChi1 || 5, options: [
              { value: 5, label: '5/5 - Rất tốt' }, { value: 4, label: '4/5 - Tốt' }, { value: 3, label: '3/5 - Trung bình' }, { value: 2, label: '2/5 - Kém' }, { value: 1, label: '1/5 - Rất kém' }
            ]
          },
          {
            name: 'tieuChi2', label: IS_LANDOWNER ? 'Thực hiện đúng cam kết & thanh toán' : 'Thái độ hợp tác & hỗ trợ của chủ đất', type: 'select', required: true, col: 6, value: myReview.tieuChi2 || 5, options: [
              { value: 5, label: '5/5 - Rất tốt' }, { value: 4, label: '4/5 - Tốt' }, { value: 3, label: '3/5 - Trung bình' }, { value: 2, label: '2/5 - Kém' }, { value: 1, label: '1/5 - Rất kém' }
            ]
          },
          { name: 'nhanXet', label: 'Nhận xét & góp ý chi tiết cho đối tác', type: 'textarea', col: 12, value: myReview.nhanXet || '' }
        ];

        openForm(`Đánh giá đối tác ${partnerName} (HĐ: ${id})`, fields, async (v) => {
          const res = await api('POST', `/contracts/${encodeURIComponent(id)}/review`, {
            soSao: Number(v.soSao),
            tieuChi1: Number(v.tieuChi1),
            tieuChi2: Number(v.tieuChi2),
            nhanXet: v.nhanXet.trim()
          });
          await load();
          return res;
        }, myReview.soSao ? 'Cập nhật đánh giá' : 'Gửi đánh giá');

        if (partnerAlert) {
          document.getElementById('modalBody').insertAdjacentHTML('afterbegin', partnerAlert);
        }
      } catch (e) {
        toast(e.message, true);
      }
    }

    async function signContract(id) {
      try {
        const c = state.contracts.find((item) => item.maHopDong === id) || {};
        const isNew = c.laNguoiMoiChuDat === 1 || c.laNguoiMoiChuDat === true || !c.tongDanhGiaChuDat || c.tongDanhGiaChuDat == 0;
        const rating = Number(c.uyTinChuDat || 5).toFixed(1);
        const count = Number(c.tongDanhGiaChuDat || 0);
        const ownerName = esc(c.tenChuDat || 'Chủ đất');
        const ownerPhone = esc(c.sdtChuDat || '');

        const otp = await api('POST', `/contracts/${encodeURIComponent(id)}/otp`);

        let alertHtml = '';
        if (isNew) {
          alertHtml = `
            <div class="col-12">
              <div class="alert alert-warning py-2 mb-2">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="fw-bold"><i class="fas fa-exclamation-triangle text-warning me-1"></i> Chủ đất: ${ownerName}</span>

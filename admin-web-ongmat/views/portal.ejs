      const count = Number(r.tongDanhGiaNuoiOng || 0);
      const bkName = esc(r.tenNguoiNuoiOng || 'Người nuôi ong');

      let alertHtml = '';
      if (isNew) {
        alertHtml = `
          <div class="col-12">
            <div class="alert alert-warning py-2 mb-2">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="fw-bold"><i class="fas fa-info-circle text-warning me-1"></i> Người thuê: ${bkName}</span>
                <span class="badge text-bg-success"><i class="fas fa-seedling"></i> Người mới</span>
              </div>
              <div class="small text-muted">⚠️ Người nuôi ong này là Người mới (chưa có đánh giá từ việc thuê trước). Bạn nên thỏa thuận kỹ lưỡng về bảo vệ cây trồng và tiền đặt cọc trước khi duyệt cho thuê!</div>
            </div>
          </div>
        `;
      } else {
        alertHtml = `
          <div class="col-12">
            <div class="alert alert-success py-2 mb-2">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="fw-bold"><i class="fas fa-user-check text-success me-1"></i> Người thuê: ${bkName}</span>
                <span class="badge text-bg-warning"><i class="fas fa-star"></i> ${rating}/5 (${count} ĐG)</span>
              </div>
              <div class="small text-muted">✨ Đối tác có uy tín tốt từ các chủ đất khác, đáng tin cậy để cho thuê.</div>
            </div>
          </div>
        `;
      }

      openForm('Duyệt cho thuê: ' + r.tenDiaDiem, [
        { name: 'giaThue', label: 'Giá thuê chốt (đồng/tháng)', type: 'number', min: 0, value: r.giaThueDuKien ?? '' },
        { name: 'quyDinhBoiThuong', label: 'Quy định bồi thường & cam kết', value: 'Bồi thường theo thỏa thuận nếu gây thiệt hại cho cây trồng hoặc tài sản trên vườn.' }
      ], (v) => api('PUT', `/landowner/rental-requests/${encodeURIComponent(id)}/approve`, { giaThue: v.giaThue ? Number(v.giaThue) : null, quyDinhBoiThuong: v.quyDinhBoiThuong }), 'Duyệt & Tạo hợp đồng điện tử');

      if (alertHtml) {
        document.getElementById('modalBody').insertAdjacentHTML('afterbegin', alertHtml);
      }
    }

    function rejectForm(id) {
      openForm('Từ chối yêu cầu thuê', [
        { name: 'lyDo', label: 'Lý do từ chối (sẽ gửi thông báo đến người nuôi ong)', required: true, col: 12, placeholder: 'Vườn đang trong thời kỳ phun thuốc, đã kín chỗ...' }
      ], (v) => api('PUT', `/landowner/rental-requests/${encodeURIComponent(id)}/reject`, { lyDo: v.lyDo }), 'Xác nhận từ chối');
    }

    // ================= PHẦN DÀNH CHO NGƯỜI NUÔI ONG =================
    const hives = () => state.data.hives || [];
    const hiveOptions = (optional) => [...(optional ? [{ value: '', label: '— Không gắn đàn ong —' }] : []), ...hives().map((h) => ({ value: h.maDanOng, label: `${h.tenDanOng} (${h.soThung} thùng)` }))];
    const rentedOptions = () => [{ value: '', label: '— Vị trí riêng của tôi —' }, ...(state.data.rentedLocations || []).map((l) => ({ value: l.maDiaDiem, label: `${l.tenDiaDiem} (còn ${l.sucChuaToiDa - l.soThungDangDat} chỗ)` }))];
    const findHive = (id) => hives().find((h) => h.maDanOng === id);

    const BEEKEEPER_VIEWS = {
      overview() {
        const s = state.data.summary || {};
        const due = (state.data.careSchedule || []).filter((c) => c.trangThai !== 'Đã hoàn thành').slice(0, 5);

        return `
          <!-- Welcome Hero Banner -->
          <div class="welcome-hero">
            <h2 class="welcome-title">Xin chào, ${esc(CURRENT_USER.hoTen)}! 🐝</h2>
            <p class="welcome-sub">Chào mừng bạn đến với Cổng Người Nuôi Ong. Theo dõi vị trí các đàn ong, tìm kiếm vườn hoa nở rộ theo mùa, ghi sản lượng mật và tạo tem QR truy xuất nguồn gốc.</p>
            
            <!-- Quy trình 3 bước trực quan -->
            <div class="step-roadmap">
              <div class="step-item">
                <div class="step-badge">1</div>
                <span>Khai báo đàn ong</span>
              </div>
              <div class="step-arrow"><i class="fas fa-chevron-right"></i></div>
              <div class="step-item">
                <div class="step-badge">2</div>
                <span>Tìm vườn hoa nở rộ</span>
              </div>
              <div class="step-arrow"><i class="fas fa-chevron-right"></i></div>
              <div class="step-item">
                <div class="step-badge">3</div>
                <span>Ký hợp đồng & Đặt ong</span>
              </div>
            </div>

            <!-- Các nút hành động chính to rõ ràng -->
            <div class="d-flex flex-wrap gap-3">
              <button class="quick-cta-btn amber" onclick="hiveForm()">
                <i class="fas fa-plus-circle fs-5"></i> Thêm đàn ong mới
              </button>
              <button class="quick-cta-btn green" onclick="setTab('rent')">
                <i class="fas fa-magnifying-glass-location fs-5"></i> Tìm vườn hoa đặt ong
              </button>
              <button class="quick-cta-btn amber" onclick="productionForm()" style="background:linear-gradient(135deg, #d97706 0%, #b45309 100%);">
                <i class="fas fa-droplet fs-5"></i> Ghi sản lượng mật
              </button>
              <button class="quick-cta-btn light" onclick="setTab('care')">
                <i class="fas fa-calendar-check fs-5"></i> Việc cần chăm sóc (${s.careDueSoon || 0})
              </button>
            </div>
          </div>

          <!-- 8 Thẻ Thống Kê To Rõ -->
          <div class="row g-3 mb-4">
            ${statCard('Tổng đàn ong', num(s.totalHives) + ' đàn', 'fa-hive', 'amber', 'hives')}
            ${statCard('Tổng số thùng ong', num(s.totalBoxes) + ' thùng', 'fa-box', 'emerald', 'hives')}
            ${statCard('Việc chăm sóc 48h', num(s.careDueSoon) + ' việc', 'fa-calendar-check', 'rose', 'care')}
            ${statCard('Tổng sản lượng mật', num(s.totalProductionKg) + ' kg', 'fa-droplet', 'sky', 'production')}
            ${statCard('Hợp đồng chờ ký', num(s.contractsToSign) + ' HĐ', 'fa-pen-nib', 'rose', 'contracts')}
            ${statCard('Hợp đồng hiệu lực', num(s.activeContracts) + ' HĐ', 'fa-handshake-simple', 'emerald', 'contracts')}
            ${statCard('Yêu cầu chờ duyệt', num(s.pendingRequests) + ' yêu cầu', 'fa-file-signature', 'amber', 'rent')}
            ${statCard('Đang di chuyển', num(s.activeMoves) + ' chuyến', 'fa-route', 'sky', 'moves')}
          </div>

          <!-- Bản đồ & Việc cần làm -->
          <div class="row g-3">
            <div class="col-lg-8">
              ${section('<i class="fas fa-map-location-dot text-warning me-2"></i> Bản đồ phân bố đàn ong của bạn', `
                <div id="overviewMap" class="map-container"></div>
                <div class="d-flex align-items-center gap-4 mt-2 small text-muted">
                  <span><i class="fas fa-circle text-warning me-1"></i> Vị trí các đàn ong của bạn</span>
                  <span class="ms-auto"><i class="fas fa-hand-pointer text-primary me-1"></i> Bấm vào từng điểm trên bản đồ để xem chi tiết đàn.</span>
                </div>
              `)}
            </div>
            <div class="col-lg-4">
              ${section('<i class="fas fa-calendar-check text-warning me-2"></i> Việc chăm sóc sắp tới', `
                <div class="d-flex flex-column gap-2">
                  ${due.map((c) => `
                    <div class="p-3 border rounded-3 bg-light">
                      <div class="d-flex align-items-center justify-content-between mb-1">
                        <b class="text-dark small">${esc(c.tenCongViec)}</b>
                        <span class="badge text-bg-warning rounded-pill px-2" style="font-size:0.7rem;">${esc(c.ngay)}</span>
                      </div>
                      <div class="small text-muted mb-2"><i class="fas fa-hive text-warning me-1"></i>${esc(c.tenDanOng || c.diaDiem || '—')}</div>
                      <div class="text-end">
                        <button class="btn btn-sm btn-outline-success rounded-pill px-3 py-0" onclick="act('PUT','/beekeeping/care-log/${encodeURIComponent(c.maLich)}/status',{trangThai:'Đã hoàn thành'})"><i class="fas fa-check me-1"></i> Đã làm xong</button>
                      </div>
                    </div>
                  `).join('') || '<div class="text-center text-muted py-5 small">Tuyệt vời! Bạn không có việc nào còn tồn đọng.</div>'}
                </div>
                <div class="mt-3 text-end">
                  <button class="btn btn-sm btn-link text-warning text-decoration-none fw-bold" onclick="setTab('care')">Xem toàn bộ lịch chăm sóc <i class="fas fa-arrow-right ms-1"></i></button>
                </div>
              `)}
            </div>
          </div>
        `;
      },

      hives() {
        const rows = hives().map((h) => `
          <tr>
            <td>
              <div class="fw-bold text-dark fs-6">${esc(h.tenDanOng)}</div>
              <div class="small text-muted font-monospace">${esc(h.maDanOng)}</div>
            </td>
            <td><b class="text-warning fs-6">${num(h.soThung)}</b> thùng</td>
            <td><span class="badge text-bg-success px-3 py-1 font-semibold">${esc(h.tinhTrang || 'Khỏe mạnh')}</span></td>
            <td>
              ${h.tenDiaDiem ? `<span class="badge text-bg-info text-white px-2 py-1"><i class="fas fa-mountain-sun me-1"></i>${esc(h.tenDiaDiem)}</span>` : `<span class="text-secondary">${esc(h.viTri || 'Vị trí riêng')}</span>`}
            </td>
            <td>
              ${h.viDo ? `<span class="small font-monospace">${Number(h.viDo).toFixed(5)}, ${Number(h.kinhDo).toFixed(5)}</span>` : '<span class="badge text-bg-danger">Chưa có GPS</span>'}
              <div class="small text-muted" style="font-size:0.75rem;">${esc(h.ngayCapNhat || '')}</div>
            </td>
            <td class="text-end text-nowrap">
              <button class="btn btn-sm btn-outline-success rounded-pill px-3" title="Cập nhật tọa độ GPS" onclick="hiveGps('${esc(h.maDanOng)}')"><i class="fas fa-crosshairs me-1"></i> Định vị GPS</button>
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 ms-1" title="Sửa thông tin" onclick="hiveForm('${esc(h.maDanOng)}')"><i class="fas fa-pen me-1"></i> Sửa</button>
              <button class="btn btn-sm btn-outline-danger rounded-pill px-2 ms-1" title="Xóa đàn ong" onclick="act('DELETE','/beekeeping/hives/${encodeURIComponent(h.maDanOng)}',null,'Xóa đàn ong ${esc(h.tenDanOng)}? Lịch sử sản lượng vẫn được giữ an toàn.')"><i class="fas fa-trash"></i></button>
            </td>
          </tr>
        `);

        return `
          <div class="row g-3">
            <div class="col-lg-5">
              ${section('<i class="fas fa-map-pin text-warning me-2"></i> Bản đồ tọa độ đàn ong', '<div id="hiveMap" class="map-container"></div>')}
            </div>
            <div class="col-lg-7">
              ${section(
                '<i class="fas fa-hive text-warning me-2"></i> Quản lý các đàn ong & thùng nuôi',
                table(['Tên đàn ong', 'Số thùng', 'Tình trạng', 'Vị trí đặt', 'GPS', 'Thao tác'], rows, 'Chưa có đàn ong nào. Bấm nút "+ Thêm đàn ong" để bắt đầu.'),
                '<button class="btn btn-warning fw-bold px-4 rounded-pill shadow-sm" onclick="hiveForm()" style="background:var(--honey-gradient);border:none;color:#fff;"><i class="fas fa-plus me-1"></i> Thêm đàn ong mới</button>'
              )}
            </div>
          </div>
        `;
      },

      care() {
        const rows = (state.data.careSchedule || []).map((c) => {
          const done = c.trangThai === 'Đã hoàn thành';
          return `
            <tr class="${done ? 'opacity-75' : ''}">
              <td style="width: 45px;">
                <input class="form-check-input" type="checkbox" style="width: 20px; height: 20px; cursor: pointer;" ${done ? 'checked' : ''} onchange="act('PUT','/beekeeping/care-log/${encodeURIComponent(c.maLich)}/status',{trangThai:this.checked?'Đã hoàn thành':'Lên lịch'})">
              </td>
              <td>
                <div class="fw-bold fs-6 ${done ? 'task-done' : 'text-dark'}">${esc(c.tenCongViec)}</div>
                ${c.ghiChu ? `<div class="small text-muted">${esc(c.ghiChu)}</div>` : ''}
              </td>
              <td class="small text-dark font-monospace">${esc(c.ngay)} ${esc(c.gio || '')}</td>
              <td><span class="badge text-bg-warning px-2 py-1"><i class="fas fa-hive me-1"></i>${esc(c.tenDanOng || '—')}</span></td>
              <td class="small text-secondary">${esc(c.diaDiem || '—')}</td>
              <td>${chip(c.trangThai)}</td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="act('DELETE','/beekeeping/care-log/${encodeURIComponent(c.maLich)}',null,'Xóa công việc chăm sóc này?')"><i class="fas fa-trash me-1"></i> Xóa</button>
              </td>
            </tr>
          `;
        });

        return section(
          '<i class="fas fa-calendar-check text-warning me-2"></i> Checklist lịch chăm sóc & vệ sinh thùng ong',
          table(['Xong', 'Công việc cần làm', 'Thời gian', 'Đàn ong', 'Địa điểm', 'Trạng thái', 'Thao tác'], rows, 'Chưa có công việc nào được lên lịch.'),
          '<button class="btn btn-warning fw-bold px-4 rounded-pill shadow-sm" onclick="careForm()" style="background:var(--honey-gradient);border:none;color:#fff;"><i class="fas fa-plus me-1"></i> Thêm công việc</button>'
        );
      },

      moves() {
        const rows = (state.data.movements || []).map((m) => {
          const id = encodeURIComponent(m.maDiChuyen);
          const open = m.trangThai === 'Lên lịch' || m.trangThai === 'Đang di chuyển';
          return `
            <tr>
              <td class="small text-dark font-monospace">${esc(m.ngay)}</td>
              <td><b class="text-dark fs-6">${esc(m.tenDanOng || '—')}</b></td>
              <td>
                <span class="badge text-bg-light border px-2 py-1">${esc(m.viTriDi)}</span>
                <i class="fas fa-arrow-right text-warning mx-2"></i>
                <span class="badge text-bg-success bg-opacity-25 text-success-emphasis border px-2 py-1">${esc(m.viTriDen)}</span>
              </td>
              <td class="small font-monospace">${esc(m.bienSo || '—')}</td>
              <td>${chip(m.trangThai)}</td>
              <td class="text-end text-nowrap">
                ${open ? `
                  ${m.trangThai === 'Lên lịch' ? `<button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="act('PUT','/beekeeping/move/${id}/status',{trangThai:'Đang di chuyển'})"><i class="fas fa-truck-fast me-1"></i> Bắt đầu di chuyển</button>` : ''}
                  <button class="btn btn-sm btn-success rounded-pill px-3 ms-1" onclick="act('PUT','/beekeeping/move/${id}/status',{trangThai:'Hoàn thành'})"><i class="fas fa-check-circle me-1"></i> Đã tới nơi an toàn</button>
                  <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 ms-1" onclick="act('PUT','/beekeeping/move/${id}/status',{trangThai:'Đã hủy'},'Hủy chuyến di chuyển này?')">Hủy</button>
                ` : ''}
              </td>
            </tr>
          `;
        });

        return section(
          '<i class="fas fa-route text-warning me-2"></i> Lịch di chuyển đàn ong đón mùa hoa',
          table(['Ngày chuyển', 'Tên đàn ong', 'Lộ trình di chuyển', 'Biển số xe', 'Trạng thái', 'Thao tác'], rows, 'Chưa có lịch di chuyển nào.'),
          '<button class="btn btn-warning fw-bold px-4 rounded-pill shadow-sm" onclick="moveForm()" style="background:var(--honey-gradient);border:none;color:#fff;"><i class="fas fa-plus me-1"></i> Lên lịch di chuyển</button>'
        ) + `
          <div class="alert alert-info py-3 rounded-3 small d-flex align-items-center gap-3">
            <i class="fas fa-circle-info fs-4 text-primary"></i>
            <div>Khi đàn ong tới nơi, bấm nút <b>"Đã tới nơi an toàn"</b> để hệ thống tự động cập nhật vị trí mới và lưu tọa độ GPS của đàn ong.</div>
          </div>
        `;
      },

      production() {
        const rows = (state.data.production || []).map((p) => `
          <tr>
            <td>${esc(p.ngay)}</td>
            <td><b class="text-warning fs-6">${num(p.sanLuong)} ${esc(p.donVi)}</b></td>
            <td><span class="badge text-bg-light border px-2 py-1">${esc(p.loaiMat)}</span></td>
            <td>${esc(p.tenDanOng || '—')}</td>
            <td>${esc(p.tenDiaDiem || '—')}</td>
            <td>
              ${p.maTruyXuat ? `<a target="_blank" class="fw-bold text-decoration-none text-primary" href="/truy-xuat-qr?ma=${p.maTruyXuat}"><i class="fas fa-qrcode me-1"></i>#${p.maTruyXuat}</a>` : '—'}
            </td>
          </tr>
        `);

        const qrs = (state.traces || []).slice(0, 8).map((t) => `
          <div class="col-6 col-md-3">
            <div class="card-modern text-center p-3 h-100 border">
              <img class="img-fluid rounded mb-2 border p-1" style="width:140px;height:140px;" alt="QR Lô ${t.id}" src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=8&data=${encodeURIComponent(t.qrUrl)}">
              <div class="fw-bold text-dark small">Lô #${t.id} · ${esc(t.sanPham)}</div>
              <div class="small text-muted" style="font-size:0.75rem;">${num(t.sanLuongDuKien)} kg · ${esc(t.thoiGian)}</div>
              <div class="mt-2 d-flex align-items-center justify-content-center gap-2">
                <a class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-bold" style="font-size:0.75rem;" target="_blank" href="${esc(t.qrUrl)}">Trang xác thực <i class="fas fa-arrow-up-right-from-square ms-1"></i></a>
              </div>
            </div>
          </div>
        `).join('');

        return section(
          '<i class="fas fa-droplet text-warning me-2"></i> Lịch sử thu hoạch mật ong',
          table(['Ngày thu', 'Sản lượng', 'Loại mật', 'Đàn ong', 'Địa điểm vườn', 'Mã lô QR'], rows, 'Chưa có sản lượng nào được ghi nhận.'),
          `<span class="badge text-bg-warning p-2 me-2 rounded-pill">Tổng thu: <b>${num(state.data.summary?.totalProductionKg)} kg</b></span><button class="btn btn-warning fw-bold px-4 rounded-pill shadow-sm" onclick="productionForm()" style="background:var(--honey-gradient);border:none;color:#fff;"><i class="fas fa-plus me-1"></i> Ghi sản lượng mật</button>`
        ) + section(
          '<i class="fas fa-qrcode text-warning me-2"></i> Tem mã QR truy xuất nguồn gốc sản phẩm',
          qrs ? `<div class="row g-3">${qrs}</div>` : '<div class="text-center text-muted py-5 small">Mỗi lần ghi sản lượng thu hoạch, hệ thống sẽ tự động tạo một mã QR chứng nhận nguồn gốc cho lô mật của bạn để dán lên chai lọ.</div>'
        );
      },

      rent() {
        const filteredAvail = state.available.filter((l) => {
          const kw = state.filters.keyword.toLowerCase();
          if (kw && !((l.tenDiaDiem || '').toLowerCase().includes(kw) || (l.diaChiChiTiet || '').toLowerCase().includes(kw) || (l.tenChuDat || '').toLowerCase().includes(kw))) return false;
          if (state.filters.flower && !((l.loaiHoa || '').toLowerCase().includes(state.filters.flower.toLowerCase()))) return false;
          if (state.filters.bee && !((l.loaiOngPhuHop || '').toLowerCase().includes(state.filters.bee.toLowerCase()))) return false;
          if (state.filters.capacity === 'small' && (l.sucChuaToiDa || 0) >= 30) return false;
          if (state.filters.capacity === 'medium' && ((l.sucChuaToiDa || 0) < 30 || (l.sucChuaToiDa || 0) > 80)) return false;
          if (state.filters.capacity === 'large' && (l.sucChuaToiDa || 0) <= 80) return false;
          if (state.filters.price === 'under800' && (l.giaThueThang || 0) > 800000) return false;
          if (state.filters.price === '800to1500' && ((l.giaThueThang || 0) < 800000 || (l.giaThueThang || 0) > 1500000)) return false;
          if (state.filters.price === 'over1500' && (l.giaThueThang || 0) <= 1500000) return false;
          return true;
        });

        const availCards = filteredAvail.map((l) => {
          const img = (l.hinhAnh && l.hinhAnh.trim()) ? l.hinhAnh : '/images/default-garden.svg';
          return `
            <div class="col-md-6 mb-3">
              <div class="card-modern h-100 p-0 overflow-hidden d-flex flex-column border">
                <div class="position-relative" style="height: 150px;">
                  <img src="${img}" class="w-100 h-100 object-fit-cover" onclick="viewImage('${img}')" style="cursor:pointer;" title="Bấm xem ảnh lớn" onerror="this.onerror=null; this.src='/images/default-garden.svg';">
                  ${l.giaThueThang ? `<div class="position-absolute bottom-0 start-0 m-2 badge bg-dark bg-opacity-75 text-white fw-bold px-2 py-1"><i class="fas fa-tag me-1"></i>${num(l.giaThueThang)} đ/tháng</div>` : ''}
                </div>
                <div class="p-3 flex-grow-1">
                  <h5 class="fw-bold text-dark mb-1">${esc(l.tenDiaDiem)}</h5>
                  <div class="small text-muted mb-2 text-truncate"><i class="fas fa-location-dot text-danger me-1"></i>${esc(l.diaChiChiTiet)}</div>
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="small">
                      Chủ vườn: <b>${esc(l.tenChuDat)}</b>
                      ${reputationBadge(l.laNguoiMoiChuDat, l.uyTinChuDat, l.tongDanhGiaChuDat)}
                    </div>
                  </div>
                  <div class="small text-secondary mb-3">
                    <div><i class="fas fa-box text-warning me-1"></i> Sức chứa: <b>${num(l.sucChuaToiDa)} thùng ong</b></div>
                    <div><i class="fas fa-seedling text-success me-1"></i> Nguồn hoa: <b>${esc(l.loaiHoa || 'Tự nhiên')}</b></div>
                  </div>
                  <div class="d-flex align-items-center justify-content-between gap-2 border-top pt-2">
                    ${l.maChuDat ? `<button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="setTab('chat'); setTimeout(()=>openChatWith(${l.maChuDat}, '${esc(l.tenChuDat)}', 'chuDat', '${esc(l.sdtChuDat || '')}'), 100)"><i class="fas fa-comment-dots me-1"></i> Nhắn tin</button>` : '<div></div>'}
                    ${l.trangThaiYeuCauCuaToi ? chip(l.trangThaiYeuCauCuaToi) : `<button class="btn btn-sm btn-warning fw-bold rounded-pill px-3 shadow-sm" onclick="rentForm(${l.maDiaDiem})" style="background:var(--honey-gradient);border:none;color:#fff;"><i class="fas fa-paper-plane me-1"></i> Gửi yêu cầu thuê</button>`}
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('') || '<div class="col-12 text-center text-muted py-5 small">Không tìm thấy địa điểm vườn nào phù hợp với bộ lọc.</div>';

        const mineRows = state.requests.map((r) => `
          <tr>
            <td>
              <div class="fw-bold text-dark fs-6">${esc(r.tenDiaDiem)}</div>
              <div class="small text-muted d-flex align-items-center flex-wrap">
                Chủ đất: ${esc(r.tenChuDat || '')}
                ${reputationBadge(r.laNguoiMoiChuDat, r.uyTinChuDat, r.tongDanhGiaChuDat)}
              </div>
            </td>
            <td class="small text-dark font-monospace">${esc(r.thoiGianBatDau)} → ${esc(r.thoiGianKetThuc || '')}</td>
            <td><b class="text-warning fs-6">${num(r.soDanOng)}</b> đàn</td>
            <td><b class="text-warning-emphasis fs-6">${money(r.giaThueDuKien)}</b></td>
            <td>
              ${chip(r.trangThai)}
              ${r.lyDoTuChoi ? `<div class="small text-danger mt-1">Lý do: ${esc(r.lyDoTuChoi)}</div>` : ''}
            </td>
            <td class="text-end text-nowrap">
              ${r.trangThai === 'ChoDuyet' ? `<button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="act('PUT','/beekeeping/rental-requests/${encodeURIComponent(r.maYeuCau)}/cancel',null,'Hủy yêu cầu thuê này?')">Hủy</button>` : ''}
              ${r.trangThai === 'ChoKhachKy' ? `<button class="btn btn-sm btn-warning fw-bold rounded-pill px-3 shadow-sm" data-tab="contracts" style="background:var(--honey-gradient);border:none;color:#fff;"><i class="fas fa-pen-nib me-1"></i> Ký hợp đồng</button>` : ''}
            </td>
          </tr>
        `);

        return `
          <!-- Thanh Bộ Lọc Nhanh 1-Chạm Dễ Tiếp Cận -->
          <div class="card-modern mb-3 p-3">
            <div class="row g-2 align-items-center">
              <div class="col-md-4">
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
                  <input class="form-control border-start-0" placeholder="Tìm theo tên vườn, địa chỉ..." value="${esc(state.filters.keyword)}" oninput="state.filters.keyword=this.value; render();">
                </div>
              </div>
              <div class="col-md-2 col-6">
                <select class="form-select" onchange="state.filters.flower=this.value; render();">
                  <option value="">— Mùa hoa —</option>
                  ${['Hoa Cà Phê', 'Hoa Vải Thiều', 'Hoa Nhãn', 'Hoa Bạc Hà', 'Hoa Tràm', 'Hoa Keo'].map(f => `<option value="${f}" ${state.filters.flower === f ? 'selected' : ''}>${f}</option>`).join('')}
                </select>
              </div>
              <div class="col-md-2 col-6">
                <select class="form-select" onchange="state.filters.bee=this.value; render();">
                  <option value="">— Giống ong —</option>
                  ${['Ong nội', 'Ong ngoại / Ong Ý', 'Ong dú'].map(b => `<option value="${b}" ${state.filters.bee === b ? 'selected' : ''}>${b}</option>`).join('')}
                </select>
              </div>
              <div class="col-md-2 col-6">
                <select class="form-select" onchange="state.filters.price=this.value; render();">
                  <option value="">— Mức giá thuê —</option>
                  <option value="under800" ${state.filters.price === 'under800' ? 'selected' : ''}>Dưới 800k/tháng</option>
                  <option value="800to1500" ${state.filters.price === '800to1500' ? 'selected' : ''}>800k - 1.5tr/tháng</option>
                  <option value="over1500" ${state.filters.price === 'over1500' ? 'selected' : ''}>Trên 1.5tr/tháng</option>
                </select>
              </div>
              <div class="col-md-2 col-6 text-end">
                <button class="btn btn-outline-secondary w-100 rounded-pill" onclick="state.filters={keyword:'',flower:'',bee:'',capacity:'',price:''}; render();" title="Xóa bộ lọc"><i class="fas fa-rotate-left me-1"></i> Xóa lọc</button>
              </div>
            </div>
          </div>

          <!-- Split Bản đồ và Danh sách Vườn -->
          <div class="row g-3 mb-4">
            <div class="col-lg-5">
              ${section('<i class="fas fa-map-marked-alt text-warning me-2"></i> Bản đồ vườn hoa trống', '<div id="rentMap" class="map-container"></div>')}
            </div>
            <div class="col-lg-7">
              <div class="row g-2">${availCards}</div>
            </div>
          </div>

          ${section('<i class="fas fa-clock-rotate-left text-warning me-2"></i> Yêu cầu thuê vườn của tôi', table(['Vườn đặt ong', 'Thời hạn thuê', 'Số đàn', 'Giá đề xuất', 'Trạng thái', 'Thao tác'], mineRows, 'Bạn chưa gửi yêu cầu thuê vườn nào.'))}
        `;
      },

      contracts: contractsView,
      chat: chatView,
      notifications: notificationsView,
      profile: profileView
    };

    function hiveForm(id) {
      const h = id ? findHive(id) : {};
      openForm(id ? 'Sửa thông tin đàn ong' : 'Thêm đàn ong mới', [
        { name: 'tenDanOng', label: 'Tên đàn ong', required: true, value: h.tenDanOng, placeholder: 'VD: Đàn ong chúa Ý 01' },
        { name: 'soThung', label: 'Số thùng ong', type: 'number', min: 1, required: true, value: h.soThung ?? 10 },
        { name: 'maDiaDiem', label: 'Đặt tại đất vườn đã thuê', type: 'select', options: rentedOptions(), value: h.maDiaDiem ?? '' },
        { name: 'viTri', label: 'Mô tả vị trí (nếu là vị trí riêng)', value: h.viTri, placeholder: 'Vườn nhà tại Xã...' },
        { name: 'tinhTrang', label: 'Tình trạng sức khỏe đàn', value: h.tinhTrang ?? 'Khỏe mạnh', list: ['Khỏe mạnh', 'Cần bổ sung thức ăn', 'Đang chia đàn', 'Có dấu hiệu bệnh', 'Yếu'] },
        { name: 'cayTruoc', label: 'Nguồn hoa chính', value: h.cayTruoc, list: ['Hoa nhãn', 'Hoa vải', 'Hoa cà phê', 'Hoa bạc hà', 'Hoa keo', 'Hoa tràm'] }
      ], (v) => {
        const body = { ...v, soThung: Number(v.soThung), maDiaDiem: v.maDiaDiem ? Number(v.maDiaDiem) : null };
        return id ? api('PUT', `/beekeeping/hives/${encodeURIComponent(id)}`, body) : api('POST', '/beekeeping/hives', body);
      });
    }

    function hiveGps(id) {
      const h = findHive(id);
      openForm('Cập nhật tọa độ GPS: ' + h.tenDanOng, [
        { type: 'latlng', label: 'Tọa độ GPS', required: true, value: h.viDo ? { lat: h.viDo, lng: h.kinhDo } : null },
        { name: 'viTri', label: 'Mô tả vị trí', value: h.viTri, col: 12 }
      ], (v) => api('PUT', `/beekeeping/hives/${encodeURIComponent(id)}/location`, { viDo: Number(v.viDo), kinhDo: Number(v.kinhDo), viTri: v.viTri }));
    }

    function careForm() {
      openForm('Thêm công việc chăm sóc đàn ong', [
        { name: 'maDanOng', label: 'Áp dụng cho đàn ong', type: 'select', options: hiveOptions(true) },
        { name: 'tenCongViec', label: 'Công việc cần làm', required: true, value: 'Kiểm tra sức khỏe đàn ong', list: ['Kiểm tra sức khỏe đàn ong', 'Bổ sung thức ăn (đường/phấn hoa)', 'Cho uống nước sạch', 'Phòng trị bệnh ấu trùng', 'Thay ong chúa', 'Vệ sinh khử trùng thùng'] },
        { name: 'ngay', label: 'Ngày thực hiện', type: 'date', required: true, value: today() },
        { name: 'gio', label: 'Giờ', type: 'time', value: '07:30' },
        { name: 'trangThai', label: 'Trạng thái ban đầu', type: 'select', options: [{ value: 'Lên lịch', label: 'Lên lịch' }, { value: 'Đã hoàn thành', label: 'Đã hoàn thành xong' }] },
        { name: 'ghiChu', label: 'Ghi chú thêm', type: 'textarea', col: 12 }
      ], (v) => api('POST', '/beekeeping/care-log', { ...v, maDanOng: v.maDanOng || null }));
    }

    function moveForm() {
      if (!hives().length) return toast('Bạn cần tạo đàn ong trước.', true);
      const rented = state.data.rentedLocations || [];
      openForm('Lên lịch di chuyển đàn ong', [
        { name: 'maDanOng', label: 'Chọn đàn ong di chuyển', type: 'select', options: hiveOptions(false), required: true },
        { name: 'maDiaDiemDen', label: 'Điểm đến là đất đã thuê', type: 'select', options: [{ value: '', label: rented.length ? '— Hoặc nhập điểm đến khác bên dưới —' : '— Chưa có đất thuê —' }, ...rented.map((l) => ({ value: l.maDiaDiem, label: l.tenDiaDiem }))] },
        { name: 'viTriDen', label: 'Hoặc nhập điểm đến khác' },
        { name: 'ngay', label: 'Ngày di chuyển', type: 'date', required: true, value: today() },
        { name: 'bienSo', label: 'Biển số xe vận chuyển', placeholder: 'VD: 29C-12345' },
        { name: 'ghiChu', label: 'Ghi chú lộ trình', col: 12 }
      ], (v) => {
        if (!v.maDiaDiemDen && !v.viTriDen.trim()) throw new Error('Vui lòng chọn đất thuê hoặc nhập điểm đến.');
        return api('POST', '/beekeeping/move', { ...v, maDiaDiemDen: v.maDiaDiemDen ? Number(v.maDiaDiemDen) : null });
      });
    }

    function productionForm() {
      if (!hives().length) return toast('Bạn cần tạo đàn ong trước.', true);
      openForm('Ghi sản lượng thu hoạch mật', [
        { name: 'maDanOng', label: 'Thu hoạch từ đàn ong', type: 'select', options: hiveOptions(false), required: true },
        { name: 'sanLuong', label: 'Sản lượng', type: 'number', step: '0.1', min: 0.1, required: true, placeholder: 'VD: 15.5' },
        { name: 'donVi', label: 'Đơn vị đo', type: 'select', options: [{ value: 'kg', label: 'kg (Kilogram)' }, { value: 'lít', label: 'lít' }] },
        { name: 'loaiMat', label: 'Loại mật hoa', required: true, value: 'Mật hoa nhãn', list: ['Mật hoa nhãn', 'Mật hoa vải', 'Mật hoa cà phê', 'Mật bạc hà', 'Mật hoa keo', 'Mật rừng tự nhiên'] },
        { name: 'loaiOng', label: 'Giống ong', value: 'Ong nội (Apis cerana)', list: ['Ong nội (Apis cerana)', 'Ong ngoại / Ong Ý (Apis mellifera)', 'Ong dú (Stingless bee)'] },
        { name: 'ngay', label: 'Ngày thu hoạch', type: 'date', required: true, value: today() },
        { name: 'ghiChu', label: 'Ghi chú chất lượng', col: 12 }
      ], (v) => api('POST', '/beekeeping/production', { ...v, sanLuong: Number(v.sanLuong) }));
    }

    function rentForm(maDiaDiem) {
      const l = state.available.find((x) => x.maDiaDiem === maDiaDiem);
      const end = new Date(Date.now() + 180 * 864e5).toISOString().slice(0, 10);
      openForm('Gửi yêu cầu thuê: ' + l.tenDiaDiem, [
        { name: 'thoiGianBatDau', label: 'Ngày bắt đầu thuê', type: 'date', required: true, value: today() },
        { name: 'thoiGianKetThuc', label: 'Ngày kết thúc thuê', type: 'date', required: true, value: end },
        { name: 'soDanOng', label: `Số đàn ong muốn đặt (Tối đa ${l.sucChuaToiDa} đàn)`, type: 'number', min: 1, required: true, value: 10 },
        { name: 'giaThueDuKien', label: 'Giá đề xuất (đồng/tháng)', type: 'number', min: 0, value: l.giaThueThang ?? '' },
        { name: 'ghiChu', label: 'Lời nhắn gửi chủ đất', type: 'textarea', col: 12, placeholder: 'Giới thiệu về kinh nghiệm nuôi ong, cam kết giữ gìn cây trồng...' }
      ], (v) => api('POST', '/beekeeping/rental-requests', { ...v, maDiaDiem, soDanOng: Number(v.soDanOng), giaThueDuKien: v.giaThueDuKien ? Number(v.giaThueDuKien) : null }), 'Gửi yêu cầu cho chủ đất');
    }

    // ================= XỬ LÝ SAU KHI RENDER TỪNG VIEW =================
    const hivePopup = (h) => `<b>${esc(h.tenDanOng)}</b><br><span class="text-warning fw-bold">${num(h.soThung)} thùng</span> · ${esc(h.tinhTrang || '')}<br><span class="text-muted small">${esc(h.tenDiaDiem || h.viTri || '')}</span>`;

    const AFTER_RENDER = IS_LANDOWNER ? {
      overview() {
        drawMap('overviewMap', [
          ...(state.data.locations || []).map((l) => ({ lat: l.viDo, lng: l.kinhDo, color: '#10b981', radius: 10, popup: `<b>${esc(l.tenDiaDiem)}</b><br>${num(l.soThung)}/${num(l.sucChuaToiDa)} thùng<br><span class="text-muted small">${esc(l.diaChiChiTiet)}</span>` })),
          ...(state.data.hives || []).map((h) => ({ lat: h.viDo, lng: h.kinhDo, color: '#f43f5e', radius: 8, popup: hivePopup(h) + `<br>Chủ: <b>${esc(h.tenNguoiNuoiOng)}</b>` }))
        ]);
      },
      hives() {
        drawMap('hiveMap', (state.data.hives || []).map((h) => ({ lat: h.viDo, lng: h.kinhDo, color: '#f43f5e', popup: hivePopup(h) + `<br>Chủ: <b>${esc(h.tenNguoiNuoiOng)}</b>` })));
      },
      chat() {
        loadChatConversations();
      }
    } : {
      overview() {
        drawMap('overviewMap', hives().map((h) => ({ lat: h.viDo, lng: h.kinhDo, color: '#f59e0b', popup: hivePopup(h) })));
      },
      hives() {
        drawMap('hiveMap', hives().map((h) => ({ lat: h.viDo, lng: h.kinhDo, color: '#f59e0b', popup: hivePopup(h) })));
      },
      rent() {
        drawMap('rentMap', state.available.map((l) => ({
          lat: l.viDo, lng: l.kinhDo, color: '#10b981', radius: 10,
          popup: `<b>${esc(l.tenDiaDiem)}</b><br>Chủ: <b>${esc(l.tenChuDat)}</b> · ${num(l.sucChuaToiDa)} thùng<br>` +
            (l.trangThaiYeuCauCuaToi ? '<span class="badge text-bg-warning">Đã gửi yêu cầu</span>' : `<button class="btn btn-warning btn-sm py-0 mt-1" onclick="rentForm(${l.maDiaDiem})">Thuê ngay</button>`)
        })));
      },
      chat() {
        loadChatConversations();
      }
    };

    // ================= ĐỒNG BỘ ĐỊNH KỲ =================
    setInterval(() => {
      if (!document.hidden && !document.querySelector('.modal.show')) {
        load();
      }
      if (!document.hidden && state.tab === 'chat' && state.chat.activePartnerId) {
        fetchChatHistory();
      }
    }, 15000);

    // Tải dữ liệu lần đầu
    load();
  </script>
</body>

</html>

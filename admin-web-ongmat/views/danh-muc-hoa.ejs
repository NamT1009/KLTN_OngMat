<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Danh Mục Loài Hoa | Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', sans-serif; }
        .sidebar { width: 260px; height: 100vh; background-color: #343a40; color: #fff; position: fixed; top: 0; left: 0; z-index: 1000; overflow-y: auto; }
        .sidebar-brand { padding: 20px; font-size: 1.2rem; font-weight: bold; background: #212529; text-align: center; color: #ffc107; border-bottom: 1px solid #4b545c; }
        .sidebar-menu { list-style: none; padding: 0; margin: 0; }
        .sidebar-menu li a { display: block; padding: 15px 20px; color: #c2c7d0; text-decoration: none; border-left: 3px solid transparent; transition: 0.3s; }
        .sidebar-menu li a:hover, .sidebar-menu li a.active { background-color: #495057; color: #fff; border-left-color: #ffc107; }
        .sidebar-menu li a i { width: 25px; text-align: center; margin-right: 10px; }
        .main-content { margin-left: 260px; min-height: 100vh; padding: 30px; }
    </style>
</head>
<body>
    <%- include('partials/sidebar') %>

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-secondary">Quản Lý Danh Mục Loài Hoa</h3>
            <button class="btn btn-warning text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#modalThemHoa">
                <i class="fas fa-plus"></i> Thêm Loài Hoa Mới
            </button>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-warning">
                        <tr>
                            <th class="ps-4">Mã Hoa</th>
                            <th>Tên Loài Hoa</th>
                            <th>Mô Tả Sinh Học / Mật Độ</th>
                            <th class="text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% danhSachHoa.forEach(function(hoa) { %>
                        <tr>
                            <td class="ps-4 fw-bold">#<%= hoa.maLoaiHoa %></td>
                            <td class="text-success fw-bold"><%= hoa.tenLoaiHoa %></td>
                            <td><%= hoa.moTaMatDo %></td>
                            <td class="text-center">
                                <!-- Nút Sửa -->
                                <button onclick="moModalSua('<%= hoa.maLoaiHoa %>', '<%= hoa.tenLoaiHoa %>', '<%= hoa.moTaMatDo %>')" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <!-- Nút Xóa -->
                                <button onclick="xoaHoa('<%= hoa.maLoaiHoa %>')" class="btn btn-sm btn-outline-danger ms-1">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MODAL THÊM HOA MỚI -->
    <div class="modal fade" id="modalThemHoa" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/danh-muc-hoa/them" method="POST">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title fw-bold">Thêm Loài Hoa Mới</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên Loài Hoa:</label>
                            <input type="text" name="tenLoaiHoa" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả đặc tính:</label>
                            <textarea name="moTaMatDo" class="form-control" rows="3" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success">Lưu Danh Mục</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL SỬA HOA (Sẽ được gọi lên bằng Javascript) -->
    <div class="modal fade" id="modalSuaHoa" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Cập Nhật Loài Hoa</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editMaHoa">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Loài Hoa:</label>
                        <input type="text" id="editTenHoa" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả đặc tính:</label>
                        <textarea id="editMoTa" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="luuSuaHoa()" class="btn btn-primary">Lưu Thay Đổi</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- CHỨC NĂNG XÓA ---
        async function xoaHoa(id) {
            if (!confirm('Bạn có chắc chắn muốn xóa loài hoa này? (Mã: ' + id + ')')) return;
            try {
                const response = await fetch('/api/danh-muc-hoa/xoa', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: id })
                });
                const data = await response.json();
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert(data.message);
                }
            } catch (error) {
                alert("Lỗi kết nối Server!");
            }
        }

        // --- CHỨC NĂNG SỬA ---
        let editModal;
        
        // Mở hộp thoại sửa và điền sẵn dữ liệu cũ
        function moModalSua(id, tenHoa, moTa) {
            document.getElementById('editMaHoa').value = id;
            document.getElementById('editTenHoa').value = tenHoa;
            document.getElementById('editMoTa').value = moTa;
            
            editModal = new bootstrap.Modal(document.getElementById('modalSuaHoa'));
            editModal.show();
        }

        // Gửi dữ liệu mới lên Server
        async function luuSuaHoa() {
            const id = document.getElementById('editMaHoa').value;
            const tenHoa = document.getElementById('editTenHoa').value;
            const moTa = document.getElementById('editMoTa').value;

            try {
                const response = await fetch('/api/danh-muc-hoa/sua', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, tenLoaiHoa: tenHoa, moTaMatDo: moTa })
                });
                const data = await response.json();
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert(data.message);
                }
            } catch (error) {
                alert("Lỗi kết nối Server!");
            }
        }
    </script>
</body>
</html>
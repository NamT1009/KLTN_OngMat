# Sao chép thành .env. Chỉ đặt địa chỉ backend ở đây (file được đóng gói vào app, không để mật khẩu).
#  - Chạy trên Chrome / Windows:   http://localhost:3000
#  - Máy ảo Android:               http://10.0.2.2:3000
#  - Điện thoại thật (chung Wi-Fi): http://<IPv4 của máy tính>:3000  (xem bằng lệnh ipconfig)
API_BASE_URL=http://localhost:3000
